nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"
    tag "pipeline"

    test("Should be able to perform subclustering") {

        when {
            params {
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nictru/test-datasets/82e8bfa28e58c562b5b1fc89acd969e8726aba52/'
                outdir                       = "$outputDir"
                input                        = null
                base_adata                   = pipelines_testdata_base_path + 'ambient_reference/merged.h5ad'
                base_embeddings              = 'scvi'
                cluster_global               = false
                cluster_per_label            = true
                base_label_col               = 'sample'
                analysis_plan                = "${projectDir}/tests/analysis_plan_sub.csv"
            }
        }

        then {
            assert workflow.success
            def adata = anndata("$outputDir/09_finalized/base.h5ad")
            assert adata.n_obs > 0
            assert adata.n_vars > 0
            assert adata.layers.containsAll(['raw_counts', 'counts', 'log1p'])
            assert !adata.layers.any { it.startsWith('ambient_corrected_') }
            assert adata.obs.get('sample').unique().toSet() == ['SRR28679756', 'SRR28679757', 'SRR28679758'].toSet()
            assert adata.obs.get('ambient_correction_method').unique().toSet() == ['none'].toSet()
            assert adata.obs.get('analysis_counts_source').unique().toSet() == ['raw_counts'].toSet()
            assert file("$outputDir/10_reports/qc-report.html").text.contains("Each integration method run by the pipeline")
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', '06_per_group/**', '11_multiqc/**'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert snapshot(
                removeNextflowVersion("$outputDir/pipeline_info/nf_core_scdownstream_software_mqc_versions.yml"),
                stable_name,
                stable_path
            ).match()
        }
    }

    test("Should reject a legacy base-only input without raw counts") {

        when {
            params {
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nictru/test-datasets/82e8bfa28e58c562b5b1fc89acd969e8726aba52/'
                input                        = null
                base_adata                   = pipelines_testdata_base_path + 'extension_base/merged.h5ad'
                base_embeddings              = 'scvi'
                outdir                       = "$outputDir"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.toString().contains('base_adata must contain a raw_counts layer with genuine pre-correction counts')
        }
    }
}
