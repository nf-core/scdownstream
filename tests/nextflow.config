/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/scdownstream/'
    singler_test_data_base_path = params.pipelines_testdata_base_path + 'singleR/'
    analysis_plan = "${projectDir}/tests/analysis_plan.csv"
    // Hosted CyteType calls are disabled in the test profile.
    cytetype_study_context = ''
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

process {
    withName: CELLBENDER_REMOVEBACKGROUND {
        ext.args = '--epochs 2'
    }
    withName: SCARCHES_EXPIMAP {
        ext.args = '--hidden-layer-sizes 16 16 --n-epochs 1 --alpha-epoch-anneal 1 --no-use-early-stopping'
    }
}
