/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/e3a7f43eb802a090affac918026d2ba5dce8fcd5/'
    // CyteType is slow (remote LLM API); module nf-tests cover it — keep off in pipeline/subworkflow nf-tests
    cytetype_study_context = ''
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

process {
    withName: SCVITOOLS_SCVI {
        ext.max_epochs = 5
    }
    withName: SCVITOOLS_SCANVI {
        ext.max_epochs = 5
    }
    withName: CELLBENDER_REMOVEBACKGROUND {
        ext.args = '--epochs 2'
    }
    withName: SCARCHES_EXPIMAP {
        ext.args = '--hidden-layer-sizes 16 16 --n-epochs 1 --alpha-epoch-anneal 1 --no-use-early-stopping'
    }
}
