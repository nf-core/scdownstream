/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = System.getenv('SCDOWNSTREAM_TEST_DATA_ROOT')
        ? new File(System.getenv('SCDOWNSTREAM_TEST_DATA_ROOT')).canonicalPath.replaceAll('/+$', '') + '/'
        : 'https://raw.githubusercontent.com/nf-core/test-datasets/scdownstream/'
    singler_test_data_base_path = params.pipelines_testdata_base_path + 'singleR/'
    analysis_plan = "${projectDir}/tests/analysis_plan.csv"
    // CyteType calls a slow remote LLM API; only module nf-tests cover it
    cytetype_study_context = ''
}

aws.client.anonymous = true

profiles {
    initialise_modules {
        process.beforeScript = 'source /etc/profile.d/modules.sh; module load apptainer'
    }
}
// fixes S3 access issues on self-hosted runners

process {
    withName: CELLBENDER_REMOVEBACKGROUND {
        ext.args = '--epochs 2'
    }
    withName: SCARCHES_EXPIMAP {
        ext.args = '--hidden-layer-sizes 16 16 --n-epochs 1 --alpha-epoch-anneal 1 --no-use-early-stopping'
    }
}
