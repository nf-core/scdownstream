nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"
    tag "pipeline"

    test("Should remove empty droplets with EmptyDrops") {

        when {
            def fixtureBase = System.getenv('SCDOWNSTREAM_TEST_DATA_ROOT')
                ? new File(System.getenv('SCDOWNSTREAM_TEST_DATA_ROOT')).canonicalPath.replaceAll('/+$', '') + '/'
                : 'https://raw.githubusercontent.com/nf-core/test-datasets/scdownstream/'
            def referenceRoot = System.getenv('SCDOWNSTREAM_TEST_DATA_ROOT')
                ? new File(System.getenv('SCDOWNSTREAM_TEST_DATA_ROOT')).canonicalPath.replaceAll('/+$', '') + '/'
                : 'https://raw.githubusercontent.com/nf-core/test-datasets/scdownstream/'
            def references = new File("$launchDir/references.csv")
            references.text = "id,label,reference,version\nhpca_celldex,label.main,hpca,2024-02-26\nimmune_celldex,label.fine,monaco_immune,2024-02-26\nhpca_direct,label.main,${referenceRoot}singleR/celldex_hpca__2024-02-26_h5_se.tar,\nimmune_direct,label.fine,${referenceRoot}singleR/celldex_monaco_immune__2024-02-26_h5_se.tar,\n"
            def samplesheet = new File("$launchDir/samplesheet.csv")
            samplesheet.text = "sample,filtered,unfiltered,batch_col\nSRR28679759,,${fixtureBase}pbmc/SRR28679759_raw_matrix.h5ad,sample\n"
            params {
                input                 = samplesheet.toString()
                celldex_reference    = references.toString()
                empty_droplet_removal = 'emptydrops'
                ambient_correction    = 'none'
                doublet_detection     = 'scrublet'
                // Too few cell cycle genes remain in the small EmptyDrops output for scoring
                cell_cycle_scoring    = false
                celltypist_model      = 'Adult_COVID19_PBMC'
                qc_only               = true
                save_intermediates    = true
                outdir                = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', '06_per_group/**', '11_multiqc/**'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_scdownstream_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() },
                { assert file("$outputDir/02_quality_control/empty_droplet_removal").list().any { it.endsWith('_emptydrops_barcodes.csv') } }
            )
        }
    }
}
