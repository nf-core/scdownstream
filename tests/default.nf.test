nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
                ambient_correction = 'decontx'
                save_intermediates = false
            }
        }

        then {
            assert workflow.success
            def adata_merged = anndata("$outputDir/09_finalized/merged.h5ad")
            assert adata_merged.n_vars > 0
            assert adata_merged.n_obs > 0
            assert adata_merged.layers.containsAll(['raw_counts', 'ambient_corrected_decontx'])
            assert !('counts' in adata_merged.layers)
            assert "scran" in adata_merged.layers || "log1p" in adata_merged.layers
            assert adata_merged.obs.get('ambient_correction_method').unique().toSet() == ['decontx'].toSet()
            assert adata_merged.obs.get('analysis_counts_source').unique().toSet() == ['raw_counts'].toSet()
            ['solo', 'scrublet', 'scdblfinder'].each { method ->
                assert (method + '_predicted_doublet') in adata_merged.obs.colnames
                def calls = adata_merged.obs.get("${method}_predicted_doublet").data.toList()
                def classes = adata_merged.obs.get("${method}_class").data.toList()
                assert calls.every { it.toString().toLowerCase() in ['true', 'false'] }
                assert classes == calls.collect { it.toString().equalsIgnoreCase('true') ? 'doublet' : 'singlet' }
            }
            ['scrublet', 'scdblfinder'].each { method ->
                assert adata_merged.obs.get("${method}_score").data.every { it instanceof Number }
            }
            assert !('solo_score' in adata_merged.obs.colnames)
            assert !file("$outputDir/02_quality_control/finalized").exists()
            assert file("$outputDir/10_reports/qc-report.html").text.contains("Each integration method run by the pipeline")
            assert "highly_variable" in adata_merged.var.colnames
            assert !adata_merged.var.colnames.any { it.contains(':subset:') }
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(
                params.outdir,
                relative: true,
                includeDir: true,
                ignore: [
                    'pipeline_info/*.{html,json,txt}',
                    '06_per_group/**',
                    '11_multiqc/**'
                ]
            )
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert snapshot(
                removeNextflowVersion("$outputDir/pipeline_info/nf_core_scdownstream_software_mqc_versions.yml"),
                stable_path,
                stable_content
            ).match()
        }
    }
}
