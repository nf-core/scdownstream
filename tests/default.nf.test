nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            def fixtureBase = System.getenv('SCDOWNSTREAM_TEST_DATA_ROOT')
                ? new File(System.getenv('SCDOWNSTREAM_TEST_DATA_ROOT')).canonicalPath.replaceAll('/+$', '') + '/'
                : 'https://raw.githubusercontent.com/nf-core/test-datasets/scdownstream/'
            def referenceRoot = System.getenv('SCDOWNSTREAM_TEST_DATA_ROOT')
                ? new File(System.getenv('SCDOWNSTREAM_TEST_DATA_ROOT')).canonicalPath.replaceAll('/+$', '') + '/'
                : 'https://raw.githubusercontent.com/nf-core/test-datasets/scdownstream/'
            def references = new File("$launchDir/references.csv")
            references.text = "id,label,reference,version\nhpca_celldex,label.main,hpca,2024-02-26\nimmune_celldex,label.fine,monaco_immune,2024-02-26\nhpca_direct,label.main,${referenceRoot}singleR/celldex_hpca__2024-02-26_h5_se.tar,\nimmune_direct,label.fine,${referenceRoot}singleR/celldex_monaco_immune__2024-02-26_h5_se.tar,\n"
            def samplesheet = new File("$launchDir/samplesheet.csv")
            samplesheet.text = 'sample,filtered,unfiltered,batch_col\n' + [
                "SRR28679756,${fixtureBase}pbmc/SRR28679756_filtered_matrix.h5ad,${fixtureBase}pbmc/SRR28679756_raw_matrix.h5ad,sample",
                "SRR28679757,${fixtureBase}pbmc/SRR28679757_filtered_matrix.sce.rds,${fixtureBase}pbmc/SRR28679757_raw_matrix.sce.rds,sample",
                "SRR28679758,${fixtureBase}pbmc/SRR28679758_filtered_matrix.seurat.rds,${fixtureBase}pbmc/SRR28679758_raw_matrix.seurat.rds,sample",
            ].join('\n') + '\n'
            params {
                input = samplesheet.toString()
                celldex_reference = references.toString()
                outdir = "$outputDir"
                ambient_correction = 'decontx'
                save_intermediates = false
            }
        }

        then {
            assert workflow.success
            def adata_merged = anndata("$outputDir/09_finalized/merged.h5ad")
            assert adata_merged.n_vars > 0
            assert adata_merged.n_obs > 0
            assert adata_merged.layers.containsAll(['raw_counts', 'ambient_corrected_decontx'])
            assert !('counts' in adata_merged.layers)
            assert "scran" in adata_merged.layers || "log1p" in adata_merged.layers
            assert adata_merged.obs.get('ambient_correction_method').unique().toSet() == ['decontx'].toSet()
            assert adata_merged.obs.get('analysis_counts_source').unique().toSet() == ['raw_counts'].toSet()
            assert !file("$outputDir/02_quality_control/finalized").exists()
            assert file("$outputDir/10_reports/qc-report.html").text.contains("Each integration method run by the pipeline")
            assert "highly_variable" in adata_merged.var.colnames
            assert !adata_merged.var.colnames.any { it.contains(':subset:') }
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(
                params.outdir,
                relative: true,
                includeDir: true,
                ignore: [
                    'pipeline_info/*.{html,json,txt}',
                    '06_per_group/**',
                    '11_multiqc/**'
                ]
            )
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert snapshot(
                removeNextflowVersion("$outputDir/pipeline_info/nf_core_scdownstream_software_mqc_versions.yml"),
                stable_path,
                stable_content
            ).match()
        }
    }
}
