nextflow_pipeline {

    name "Test scConcept integration"
    script "main.nf"
    tag "pipeline"
    tag "scconcept"

    test("Should embed and cluster human cells with scConcept") {
        when {
            def fixture = 'https://raw.githubusercontent.com/nictru/test-datasets/scdownstream/pbmc/SRR28679759_filtered_matrix.h5ad'
            def samplesheet = new File("$launchDir/samplesheet.csv")
            samplesheet.text = "sample,filtered,batch_col\npbmc,${fixture},sample\n"
            def plan = new File("$launchDir/scconcept-analysis.csv")
            plan.text = "integration,subset,resolution,analyses\nscconcept,global,0.5,paga\n"
            params {
                input                  = samplesheet.toString()
                analysis_plan          = plan.toString()
                integration_methods   = 'scconcept'
                ambient_correction    = 'none'
                doublet_detection     = 'none'
                normalization_method = 'log1p'
                feature_selection     = 'hvgs'
                integration_n_features = 100
                cell_cycle_scoring    = false
                celltypist_model      = null
                celldex_reference    = null
                scib                 = false
                skip_qc_report       = true
                save_intermediates   = true
                clustering_resolutions = '0.5'
                outdir                = "$outputDir"
            }
        }

        then {
            assert workflow.success
            def adata = anndata("$outputDir/09_finalized/merged.h5ad")
            assert adata.n_obs > 0
            def embedded = anndata("$outputDir/03_combine/integrate/scconcept/scconcept.h5ad")
            assert embedded.n_vars == adata.n_vars
            assert embedded.n_vars > 100
            assert 'X_scconcept' in adata.obsm
            assert 'X_scconcept-global_umap' in adata.obsm
            assert 'scconcept-global-0.5_leiden' in adata.obs.colnames

            def versions = path("$outputDir/pipeline_info/nf_core_scdownstream_software_mqc_versions.yml").yaml
            def scconcept = versions.SCCONCEPT_EMBED
            assert snapshot([
                'sc-concept': scconcept['sc-concept'],
                torch: scconcept.torch.replaceFirst(/\+cpu$/, ''),
            ]).match()
        }
    }
}
