nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"
    tag "pipeline"

    test("Should build minimal extension and reference mapping fixtures") {

        when {
            params {
                input                  = 'https://github.com/nf-core/test-datasets/raw/refs/heads/scdownstream/samplesheet.csv'
                integration_methods    = 'scvi,symphony'
                ambient_correction     = 'none'
                doublet_detection      = 'none'
                cell_cycle_scoring     = false
                celltypist_model       = ''
                celldex_reference      = ''
                integration_hvgs       = 500
                sample_n               = 1000
                scib                   = false
                cluster_global         = false
                cluster_per_label      = false
                skip_liana             = true
                skip_rankgenesgroups   = true
                outdir                 = "$outputDir"
            }
        }

        then {
            assert workflow.success
            assert file("$outputDir/finalized/merged.h5ad").exists()
            assert file("$outputDir/combine/integrate/scvi/scvi_model/model.pt").exists()
            assert file("$outputDir/combine/integrate/symphony/symphony_reference.h5ad").exists()
            assert !file("$outputDir/celltypes").exists()
            assert !file("$outputDir/cluster_dimred").exists()
            assert !file("$outputDir/per_group").exists()
        }
    }
}
