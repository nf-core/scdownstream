    }

    withName: SUBSETVAR_INNER {
        ext.prefix = { meta.id + '_inner' }
        publishDir = [
            path: { "${params.outdir}/03_combine/subsetvar" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SUBSETVAR_INTEGRATE {
        ext.prefix = { meta.id + '_integrate_inner' }
        publishDir = [
            path: { "${params.outdir}/03_combine/subsetvar" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: ADATA_UPSETGENES {
        publishDir = [
            path: { "${params.outdir}/03_combine/merge" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('.json') ? null : filename },
        ]
    }

    // Prepare integration

    withName: SCANPY_HVGS {
        ext.prefix = { meta.id + '_hvg' }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/input_hvg" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCRY_DEVIANCE {
        ext.prefix = { meta.id + '_deviance' }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/input_deviance" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
