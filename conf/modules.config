/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
        ext.when   = Boolean expression to determine when a module runs.
        ext.use_gpu = Whether the module uses GPU settings.
        ext.singularity_pull_docker_container = Use Docker URI under the singularity profile.

    Per-group publish paths use
    06_per_group/{integration}/{subset}/{leiden|label}/...
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    withName: '.*:LOAD_H5AD:ADATA_READRDS' {
        ext.prefix = { meta.id + '_converted_' + meta.type }
        publishDir = [
            path: { "${params.outdir}/01_load_h5ad" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:LOAD_H5AD:SCANPY_READH5' {
        ext.prefix = { meta.id + '_converted_' + meta.type }
        publishDir = [
            path: { "${params.outdir}/01_load_h5ad" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:LOAD_H5AD:ADATA_READCSV' {
        ext.prefix = { meta.id + '_converted_' + meta.type }
        publishDir = [
            path: { "${params.outdir}/01_load_h5ad" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Size extraction
    withName: COLLECT_SIZES {
        publishDir = [
            path: { "${params.outdir}/02_quality_control/sizes" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('.json') ? null : filename },
        ]
    }

    // Empty droplet removal

    withName: '.*:EMPTY_DROPLET_REMOVAL:CELLBENDER_REMOVEBACKGROUND' {
        ext.prefix = { meta.id + '_cellbender' }
        ext.args   = {
            [
                "--epochs ${params.cellbender_epochs}",
                meta.expected_cells > 0 ? "--expected-cells ${meta.expected_cells}" : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/02_quality_control/empty_droplet_removal" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:EMPTY_DROPLET_REMOVAL:ANNDATA_BARCODES' {
        ext.prefix = { meta.id + '_subset' }
        publishDir = [
            path: { "${params.outdir}/02_quality_control/empty_droplet_removal" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Quality control

    withName: QC_RAW {
        ext.prefix = { meta.id + '_raw' }
        publishDir = [
            path: { "${params.outdir}/02_quality_control/qc_raw" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('.json') ? null : filename },
        ]
    }

    withName: QC_FILTERED {
        ext.prefix = { meta.id + '_preprocessed' }
        publishDir = [
            path: { "${params.outdir}/02_quality_control/qc_filtered" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('.json') ? null : filename },
        ]
    }

    // Ambient RNA removal

    withName: CELDA_DECONTX {
        ext.prefix = { meta.id + '_decontx' }
        publishDir = [
            path: { "${params.outdir}/02_quality_control/ambient_rna_removal" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:AMBIENT_RNA_REMOVAL:CELLBENDER_REMOVEBACKGROUND' {
        ext.prefix = { meta.id + '_cellbender' }
        ext.args   = { "--epochs ${params.cellbender_epochs}" }
        publishDir = [
            path: { "${params.outdir}/02_quality_control/ambient_rna_removal" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:AMBIENT_RNA_REMOVAL:CELLBENDER_MERGE' {
        ext.prefix       = { meta.id + '_cellbender' }
        publishDir       = [
            path: { "${params.outdir}/02_quality_control/ambient_rna_removal" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SOUPX {
        ext.prefix = { meta.id + '_soupX' }
        publishDir = [
            path: { "${params.outdir}/02_quality_control/ambient_rna_removal" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Custom filtering

    withName: SCANPY_FILTER {
        ext.prefix = { meta.id + '_filtered' }

        publishDir = [
            path: { "${params.outdir}/02_quality_control/custom_thresholds" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.endsWith('.json')) {
                    null
                } else if (filename.endsWith('.png')) {
                    filename
                } else if (params.save_intermediates) {
                    filename
                } else {
                    null
                }
            },
        ]
    }

    // Doublet detection

    withName: SCVITOOLS_SOLO {
        ext.prefix = { meta.id + '_solo' }
        publishDir = [
            path: { "${params.outdir}/02_quality_control/doublet_detection/solo" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCANPY_SCRUBLET {
        ext.prefix = { meta.id + '_scrublet' }
        publishDir = [
            path: { "${params.outdir}/02_quality_control/doublet_detection/scrublet" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: DOUBLETDETECTION {
        ext.prefix = { meta.id + '_doubletdetection' }
        publishDir = [
            path: { "${params.outdir}/02_quality_control/doublet_detection/doubletdetection" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCDBLFINDER {
        ext.prefix = { meta.id + '_scdblfinder' }
        publishDir = [
            path: { "${params.outdir}/02_quality_control/doublet_detection/scdblfinder" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: DOUBLETREMOVAL {
        publishDir = [
            path: { "${params.outdir}/02_quality_control/doublet_detection" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('.json') ? null : filename },
        ]
    }

    withName: SCANPY_CELLCYCLE {
        ext.prefix = { meta.id + '_cellcycle' }
        publishDir = [
            path: { "${params.outdir}/02_quality_control/cell_cycle" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: FINALIZE_QC_ANNDATAS {
        ext.prefix = { meta.id + '_qc' }
        publishDir = [
            path: { "${params.outdir}/02_quality_control/finalized" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: QC_REPORT {
        container = 'docker.io/saditya88/qcreport:0.1.1'
        label = 'process_medium'
        ext.prefix = 'qc-report'
        publishDir = [
            path: { "${params.outdir}/10_reports" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
