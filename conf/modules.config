    withName: '.*:INTEGRATE:ADATA_TORDS' {
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/input_hvg" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Integration

    withName: SCVITOOLS_SCVI {
        ext.prefix = { (meta.integration ?: meta.id) + (meta.subset ? "-${meta.subset}" : '') }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/scvi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith("model.pt") || (params.save_intermediates && !filename.equals('versions.yml')) ? filename : null },
        ]
    }

    withName: SCVITOOLS_SCANVI {
        ext.prefix = { (meta.integration ?: meta.id) + (meta.subset ? "-${meta.subset}" : '') }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/scanvi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith("model.pt") || (params.save_intermediates && !filename.equals('versions.yml')) ? filename : null },
        ]
    }

    withName: SYMPHONY_HARMONYINTEGRATE {
        ext.prefix = { (meta.integration ?: meta.id) + (meta.subset ? "-${meta.subset}" : '') }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/symphony" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.endsWith('_reference.h5ad')) {
                    return 'symphony_reference.h5ad'
                }
                if (params.save_intermediates && !filename.equals('versions.yml')) {
                    return filename
                }
                return null
            },
        ]
    }

    withName: SYMPHONY_MAPEMBEDDING {
        ext.prefix = { (meta.integration ?: meta.id) + (meta.subset ? "-${meta.subset}" : '') }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/symphony" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCANPY_BBKNN {
        ext.prefix = { (meta.integration ?: meta.id) + (meta.subset ? "-${meta.subset}" : '') }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/bbknn" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCANORAMA_INTEGRATE {
        ext.prefix = { (meta.integration ?: meta.id) + (meta.subset ? "-${meta.subset}" : '') }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/scanorama" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SEURAT_INTEGRATION {
        ext.prefix = { (meta.integration ?: meta.id) + (meta.subset ? "-${meta.subset}" : '') }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/seurat" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:INTEGRATE:ADATA_READRDS' {
        publishDir = [
            enabled: false
        ]
    }

    withName: SCANPY_COMBAT {
        ext.prefix = { (meta.integration ?: meta.id) + (meta.subset ? "-${meta.subset}" : '') }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/combat" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCANPY_PCA {
        ext.prefix = { (meta.integration ?: meta.id) + (meta.subset ? "-${meta.subset}" : '') + '_pca' }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/pca" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCANPY_LOG1PNORM {
        ext.prefix = { meta.id + '_log1pnorm' }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/normalization" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCANPY_PEARSONRESIDUALS_HVGS {
        ext.prefix = { meta.id + '_pearson_residuals_hvgs' }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/input_pearson_residuals_hvgs" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCRAN_NORMALIZATION {
        ext.prefix = { meta.id + '_scran' }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/normalization" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCARCHES_EXPIMAP {
        ext.prefix = { (meta.integration ?: meta.id) + (meta.subset ? "-${meta.subset}" : '') }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/expimap" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:SCIMILARITY:UNTAR' {
        publishDir = [
            enabled: false
        ]
    }

    withName: SCIMILARITY_EMBED {
        ext.prefix = { (meta.integration ?: meta.id) + (meta.subset ? "-${meta.subset}" : '') }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/scimilarity" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCIMILARITY_ANNOTATE {
        ext.prefix = { (meta.integration ?: meta.id) + (meta.subset ? "-${meta.subset}" : '') + '_annotate' }
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/scimilarity" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCIBMETRICS_BENCHMARK {
        publishDir = [
            path: { "${params.outdir}/03_combine/integrate/scib_metrics" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.equals('versions.yml') || filename.endsWith('_mqc.json')
                    ? null
                    : filename
            },
        ]
    }

    withName: ADATA_MERGEEMBEDDINGS {
        ext.prefix = { (meta.integration ?: meta.id) + (meta.subset ? "-${meta.subset}" : '') }
        publishDir = [
            path: { "${params.outdir}/03_combine/merge_emb/${meta.integration ?: meta.id}" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Celltype assignment

    withName: CELLDEX_FETCHREFERENCE {
        publishDir = [
            enabled: false
        ]
    }

    withName: CELLTYPES_SINGLER {
        ext.prefix = { meta.id + '_singler' }
        publishDir = [
            path: { "${params.outdir}/04_celltypes/singler" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: CELLTYPES_CELLTYPIST {
        ext.prefix = { meta.id + '_celltypist' }
        publishDir = [
            path: { "${params.outdir}/04_celltypes/celltypist" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: CYTETYPE {
        ext.prefix = { meta.id + '_cytetype' }
        publishDir = [
            path: { "${params.outdir}/08_cytetype" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Ignore remote API failures in pipeline/subworkflow runs only (not bare module nf-tests)
    withName: '.*:CYTETYPE' {
        errorStrategy = 'ignore'
    }

    // Clustering

    withName: NEIGHBORS {
        ext.prefix = { meta.id + '_neighbors' }
        publishDir = [
            path: { "${params.outdir}/05_cluster_dimred/${meta.integration}/neighbors" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: LEIDEN {
        ext.prefix = { meta.id + '_leiden' }
        publishDir = [
            path: { "${params.outdir}/05_cluster_dimred/${meta.integration}/leiden" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith(".png") || (params.save_intermediates && !filename.equals('versions.yml')) ? filename : null },
        ]
    }

    withName: ENTROPY {
        ext.prefix = { meta.id + '_entropy' }
        publishDir = [
            path: { "${params.outdir}/05_cluster_dimred/${meta.integration}/entropy" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith(".png") || (params.save_intermediates && !filename.equals('versions.yml')) ? filename : null },
        ]
    }

    withName: UMAP {
        ext.prefix = { meta.id + '_umap' }
        publishDir = [
            path: { "${params.outdir}/05_cluster_dimred/${meta.integration}/umap" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: TSNE {
        ext.prefix = { meta.id + '_tsne' }
        publishDir = [
            path: { "${params.outdir}/05_cluster_dimred/${meta.integration}/tsne" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: ".*:PSEUDOBULKING:PSEUDOBULK" {
        ext.prefix = { meta.id + '_pseudobulk' }
        publishDir = [
            path: {
                def integration = meta.integration ?: 'merged'
                def subset = meta.subset ?: 'global'
                def grouping = meta.resolution != null ? "leiden/${meta.resolution}" : "${meta.obs_key ?: 'label'}"
                "${params.outdir}/06_per_group/${integration}/${subset}/${grouping}/differential_expression/pseudobulk/aggregation"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: PYDESEQ2_DIFFERENTIAL {
        ext.prefix = { meta.id + '_pydeseq2' }
        publishDir = [
            path: {
                def integration = meta.integration ?: 'merged'
                def subset = meta.subset ?: 'global'
                def grouping = meta.resolution != null ? "leiden/${meta.resolution}" : "${meta.obs_key ?: 'label'}"
                "${params.outdir}/06_per_group/${integration}/${subset}/${grouping}/differential_expression/pseudobulk/pydeseq2"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: EDGEPYTHON_DIFFERENTIAL {
        ext.prefix = { meta.id + '_edgepython' }
        publishDir = [
            path: {
                def integration = meta.integration ?: 'merged'
                def subset = meta.subset ?: 'global'
                def grouping = meta.resolution != null ? "leiden/${meta.resolution}" : "${meta.obs_key ?: 'label'}"
                "${params.outdir}/06_per_group/${integration}/${subset}/${grouping}/differential_expression/pseudobulk/edgepython"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: EDGEPYTHON_SCDIFFERENTIAL {
        ext.prefix = { meta.id + "_${meta.celltype}_edgepython_sc" }
        publishDir = [
            path: {
                def integration = meta.integration ?: 'merged'
                def subset = meta.subset ?: 'global'
                def grouping = meta.resolution != null ? "leiden/${meta.resolution}" : "${meta.obs_key ?: 'label'}"
                "${params.outdir}/06_per_group/${integration}/${subset}/${grouping}/differential_expression/single_cell/edgepython"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
    withName: SCANPY_PAGA {
        ext.prefix = { meta.id + '_paga' }
        publishDir = [
            path: {
                def integration = meta.integration ?: 'merged'
                def subset = meta.subset ?: 'global'
                def grouping = meta.resolution != null ? "leiden/${meta.resolution}" : "${meta.obs_key ?: 'label'}"
                "${params.outdir}/06_per_group/${integration}/${subset}/${grouping}/paga"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith(".png") || (params.save_intermediates && !filename.equals('versions.yml')) ? filename : null },
        ]
    }

    withName: LIANA_RANKAGGREGATE {
        ext.prefix = { meta.id + '_liana' }
        publishDir = [
            path: {
                def integration = meta.integration ?: 'merged'
                def subset = meta.subset ?: 'global'
                def grouping = meta.resolution != null ? "leiden/${meta.resolution}" : "${meta.obs_key ?: 'label'}"
                "${params.outdir}/06_per_group/${integration}/${subset}/${grouping}/liana"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.endsWith(".png") || (params.save_intermediates && !filename.equals('versions.yml') && !filename.endsWith('_mqc.json')) ? filename : null
            },
        ]
    }

    withName: LIANA_BYSAMPLE {
        ext.prefix = { meta.id + '_liana_bysample' }
        publishDir = [
            path: {
                def integration = meta.integration ?: 'merged'
                def subset = meta.subset ?: 'global'
                def grouping = meta.resolution != null ? "leiden/${meta.resolution}" : "${meta.obs_key ?: 'label'}"
                "${params.outdir}/06_per_group/${integration}/${subset}/${grouping}/liana/by_sample"
            },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> params.save_intermediates && !filename.equals('versions.yml') ? filename : null },
        ]
    }

    withName: CELL2CELL_TENSOR {
        ext.prefix = { meta.id + '_cell2cell' }
        publishDir = [
            path: {
                def integration = meta.integration ?: 'merged'
                def subset = meta.subset ?: 'global'
                def grouping = meta.resolution != null ? "leiden/${meta.resolution}" : "${meta.obs_key ?: 'label'}"
                "${params.outdir}/06_per_group/${integration}/${subset}/${grouping}/cell2cell"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.endsWith(".png") || (params.save_intermediates && !filename.equals('versions.yml') && !filename.endsWith('_mqc.json')) ? filename : null
            },
        ]
    }

    withName: SCANPY_RANKGENESGROUPS {
        ext.prefix = { meta.id + '_characteristic_genes' }
        publishDir = [
            path: {
                def integration = meta.integration ?: 'merged'
                def subset = meta.subset ?: 'global'
                def grouping = meta.resolution != null ? "leiden/${meta.resolution}" : "${meta.obs_key ?: 'label'}"
                "${params.outdir}/06_per_group/${integration}/${subset}/${grouping}/differential_expression/scanpy/${meta.de_method}/${meta.comparison_scope}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith(".png") || filename.endsWith(".csv") || (params.save_intermediates && !filename.equals('versions.yml')) ? filename : null },
        ]
    }

    // Finalize

    withName: '.*:FINALIZE:ADATA_EXTEND' {
        publishDir = [
            path: { "${params.outdir}/09_finalized" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:FINALIZE:ADATA_TORDS' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        publishDir    = [
            path: { "${params.outdir}/09_finalized" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:FINALIZE:ADATA_PREPCELLXGENE' {
        ext.prefix = { meta.id + '_cellxgene' }
        publishDir = [
            path: { "${params.outdir}/09_finalized" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // MultiQC
    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/11_multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
