/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size base-only sub-integration tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Re-integrates a whitelisted coarse cell-type subset (B and plasma cells) from an
    annotated base AnnData without new samplesheet inputs, alongside condition DE and
    Tensor-cell2cell analysis.

    Use as follows:
        nextflow run nf-core/scdownstream -profile test_full_sub,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name           = 'Full test profile (base-only sub-integration)'
    config_profile_description    = 'Full-size base-only per-label sub-integration with condition DE and Tensor-cell2cell'

    // Base-only input
    input                         = null
    base_adata                    = 'https://scdownstream.nbg1.your-objectstorage.com/test-data/base/base_annotated_for_sub.h5ad'
    base_label_col                = 'coarse_annotation'
    base_condition_col            = 'condition'
    base_donor_col                = 'donor'
    base_embeddings               = 'scvi'

    // Base-only mode bypasses per-sample QC
    ambient_correction            = 'none'
    use_ambient_corrected_counts  = false
    doublet_detection             = 'none'
    doublet_removal               = false

    // Per-label sub-integration
    integrate_per_label           = true
    integrate_per_label_whitelist = 'B_and_plasma_cell'
    normalization_method          = 'log1p'
    feature_selection             = 'hvgs'
    integration_methods           = 'scvi'
    scvi_categorical_covariates   = 'chemistry'

    // Clustering and downstream analyses
    cluster_global                = false
    cluster_per_label             = false
    clustering_resolutions        = '1.0'
    analysis_plan                 = 'https://raw.githubusercontent.com/nictru/test-datasets/c6d9a4769894bea9743c12a97c20aabbe59e613d/samplesheets/analysis_plan_minimal.csv'
    de_methods                    = 'wilcoxon,pydeseq2'
    reference_condition           = 'Hc'
    interesting_genes             = 'https://scdownstream.nbg1.your-objectstorage.com/test-data/isg_genes.csv'
    cell2cell                     = true
    liana_n_perms                 = 100
    liana_max_cells               = 100000
    cytetype_study_context        = ''
    skip_qc_report                = true
    memory_scale                  = 3
}
