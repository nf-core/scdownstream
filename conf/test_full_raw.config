/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size raw/unfiltered preprocessing tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Exercises empty-droplet removal (EmptyDrops), SoupX ambient RNA correction with
    ambient-corrected counts selected for analysis, all four doublet callers, and the
    default R-based deviance/scran stack plus Seurat integration on paired PBMC matrices.

    Use as follows:
        nextflow run nf-core/scdownstream -profile test_full_raw,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name          = 'Full test profile (raw matrices)'
    config_profile_description   = 'Full-size paired raw and filtered PBMC matrices exercising EmptyDrops, SoupX, all doublet detectors, deviance/scran, and Seurat'

    // Input data (3 wilhelm-pbmc samples: 2 filtered+unfiltered, 1 unfiltered-only)
    input                        = 'https://scdownstream.nbg1.your-objectstorage.com/test-data/samplesheets/samplesheet_full_raw.csv'

    // Raw preprocessing defaults
    empty_droplet_removal        = 'emptydrops'
    ambient_correction           = 'soupx'
    use_ambient_corrected_counts = true
    doublet_detection            = 'solo,scrublet,doubletdetection,scdblfinder'
    doublet_removal              = true

    // Default R feature selection and normalisation + Seurat integration
    feature_selection            = 'deviance'
    normalization_method         = 'scran'
    integration_methods          = 'scvi,seurat,symphony'

    // Annotation and downstream
    celltypist_model             = 'Adult_COVID19_PBMC'
    azimuth                      = true
    cytetype_study_context       = ''
    clustering_resolutions       = '0.5'
    save_intermediates           = true
}
