/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and parameters for the primary full-size de novo integration
    and downstream showcase test on five human PBMC/B-cell studies (140k cells,
    20 donors: 13 SLE vs 7 HC, 27 batches, 4 chemistries).

    Use as follows:
        nextflow run nf-core/scdownstream -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full-size multi-study PBMC test dataset exercising de novo integration and downstream analyses'

    // Input data (5 studies: deng, duan, gao, mistry, wilhelm-pbmc)
    input                      = 'https://scdownstream.nbg1.your-objectstorage.com/test-data/samplesheets/samplesheet_full.csv'
    unify_gene_symbols         = true

    // Quality control
    ambient_correction         = 'decontx'
    doublet_detection          = 'scdblfinder,scrublet'
    doublet_removal            = true

    // Integration and benchmarking
    normalization_method       = 'log1p'
    feature_selection          = 'hvgs'
    integration_methods        = 'scvi,symphony,bbknn,combat,scanorama,pca'
    scib                       = true
    scib_max_cells             = 50000
    scib_metric_profile        = 'fast'

    // Cell type annotation (CyteType requires remote LLM auth and is covered by module tests)
    celltypist_model           = 'Adult_COVID19_PBMC'
    azimuth                    = true
    celldex_reference          = params.pipelines_testdata_base_path + 'singleR/references.csv'
    cytetype_study_context     = ''

    // Clustering and per-group downstream analyses
    clustering_resolutions     = '0.5,1.0'
    tsne                       = true
    analysis_plan              = 'https://scdownstream.nbg1.your-objectstorage.com/test-data/samplesheets/analysis_plan_full.csv'
    de_methods                 = 'wilcoxon,pydeseq2,edgepython,edgepython_sc'
    reference_condition        = 'Hc'
    interesting_genes          = 'https://scdownstream.nbg1.your-objectstorage.com/test-data/cohorts/isg_genes.csv'
    decoupler                  = true
    cell2cell                  = true
    liana_n_perms              = 100
    liana_max_cells            = 50000

    // Exports and scaling
    prep_cellxgene             = true
    tords                      = true
    memory_scale               = 2
}
