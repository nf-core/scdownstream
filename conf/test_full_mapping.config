/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size reference mapping tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Projects a query PBMC cohort (mistry, 24k cells) onto pre-trained scVI, Symphony,
    and SCimilarity reference models without merging into a base AnnData object.

    Use as follows:
        nextflow run nf-core/scdownstream -profile test_full_mapping,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile (reference mapping)'
    config_profile_description = 'Full-size query projection onto pre-trained scVI, Symphony, and SCimilarity models'

    // Query cohort and pre-trained reference models
    input                      = 'https://scdownstream.nbg1.your-objectstorage.com/test-data/samplesheets/samplesheet_full_mistry.csv'
    unify_gene_symbols         = true
    scvi_model                 = 'https://scdownstream.nbg1.your-objectstorage.com/test-data/models/scvi_model.pt'
    symphony_reference         = 'https://scdownstream.nbg1.your-objectstorage.com/test-data/models/symphony_reference.h5ad'

    // Quality control
    ambient_correction         = 'none'
    doublet_detection          = 'scdblfinder'
    scdblfinder_dbr_sd         = 1
    doublet_removal            = true

    // Reference mapping
    normalization_method       = 'log1p'
    feature_selection          = 'hvgs'
    integration_methods        = 'scvi,symphony,scimilarity'
    scib                       = true
    scib_metric_profile        = 'fast'

    // Annotation and clustering
    celltypist_model           = 'Adult_COVID19_PBMC'
    cytetype_study_context     = ''
    clustering_resolutions     = '1.0'
    skip_liana                 = true
    de_methods                 = 'wilcoxon'
}
