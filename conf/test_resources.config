/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-process resource requirements for the test profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Sized from the peak RSS and CPU usage measured in the pipeline nf-tests (3-sample
    test data), plus a safety margin. Memory doubles on retry (see errorStrategy in
    conf/base.config), and the resourceLimits in conf/test.config still cap each task.

    Without these settings every process_medium task requests the full 4 CPU / 15 GB
    cap, so only one or two tasks fit on a runner at a time.

    The selectors only match full pipeline runs (NFCORE_SCDOWNSTREAM:...). Module and
    subworkflow nf-tests feed some of these processes larger inputs and keep their
    label defaults.
----------------------------------------------------------------------------------------
*/

process {
    // Peak RSS below 0.6 GB, single-threaded
    withName: 'NFCORE_SCDOWNSTREAM:.*:(ENTROPY|FINALIZE_QC_ANNDATAS|ADATA_EXTEND|ADATA_MERGE|ADATA_MERGEEMBEDDINGS|SPLITCOL|ADATA_SPLITEMBEDDINGS|SUBSETVAR_INNER|SUBSETVAR_INTEGRATE|ADATA_UNIFY|UPSET_GENES|COLLECT_SIZES|DOUBLETREMOVAL|CELLTYPES_CELLTYPIST|SCANPY_CELLCYCLE|SCANPY_HVGS|LEIDEN|SCANPY_PAGA|SCANPY_PCA|QC_RAW|QC_FILTERED|SYMPHONY_MAPEMBEDDING)' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    // Peak RSS below 1.4 GB, single-threaded
    withName: 'NFCORE_SCDOWNSTREAM:.*:(CELLDEX_FETCHREFERENCE|CUSTOM_VOLCANOPLOT|MULTIQC|SCANPY_BBKNN|SCANPY_FILTER|NEIGHBORS|UMAP|SYMPHONY_HARMONYINTEGRATE)' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
    }
    withName: 'NFCORE_SCDOWNSTREAM:.*:(ADATA_READRDS|SOUPX)' {
        cpus   = 1
        memory = { 3.GB * task.attempt }
    }
    withName: 'NFCORE_SCDOWNSTREAM:.*:(SCANPY_RANKGENESGROUPS|SCVITOOLS_SCVI|SCVITOOLS_SOLO)' {
        cpus   = 2
        memory = { 2.GB * task.attempt }
    }
    withName: 'NFCORE_SCDOWNSTREAM:.*:(CELDA_DECONTX|SCANPY_COMBAT|SCANPY_SCRUBLET)' {
        cpus   = 2
        memory = { 3.GB * task.attempt }
    }
    // Keep the process_low CPU count: QUARTO_NOTEBOOK writes task.cpus into the
    // snapshotted 10_reports/params.yml
    withName: 'NFCORE_SCDOWNSTREAM:.*:QC_REPORT' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    withName: 'NFCORE_SCDOWNSTREAM:.*:CELLTYPES_SINGLER' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    // computeSumFactors runs on a MulticoreParam(task.cpus) pool
    withName: 'NFCORE_SCDOWNSTREAM:.*:SCRAN_NORMALIZATION' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }
    withName: 'NFCORE_SCDOWNSTREAM:.*:SCIBMETRICS_BENCHMARK' {
        cpus   = 4
        memory = { 6.GB * task.attempt }
    }
    withName: 'NFCORE_SCDOWNSTREAM:.*:SCDBLFINDER' {
        cpus   = 2
        memory = { 10.GB * task.attempt }
    }
    withName: 'NFCORE_SCDOWNSTREAM:.*:LIANA_RANKAGGREGATE' {
        cpus   = 2
        memory = { 12.GB * task.attempt }
    }
    withName: 'NFCORE_SCDOWNSTREAM:.*:SEURAT_INTEGRATION' {
        cpus   = 4
        memory = { 15.GB * task.attempt }
    }
}
