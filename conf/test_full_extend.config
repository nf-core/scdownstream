/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size atlas extension tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Projects a query PBMC cohort (mistry, 24k cells) onto an existing integrated atlas
    (624k cells) using matching pre-trained scVI and Symphony references.

    Use as follows:
        nextflow run nf-core/scdownstream -profile test_full_extend,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name          = 'Full test profile (atlas extension)'
    config_profile_description   = 'Full-size atlas extension projecting a query cohort onto a pre-integrated base AnnData'

    // Query cohort, base atlas, and matching reference models
    input                        = 'https://scdownstream.nbg1.your-objectstorage.com/test-data/samplesheets/samplesheet_full_mistry.csv'
    base_adata                   = 'https://scdownstream.nbg1.your-objectstorage.com/test-data/base/base_for_extension.h5ad'
    scvi_model                   = 'https://scdownstream.nbg1.your-objectstorage.com/test-data/models/scvi_model.pt'
    symphony_reference           = 'https://scdownstream.nbg1.your-objectstorage.com/test-data/models/symphony_reference.h5ad'
    unify_gene_symbols           = true

    // Query quality control
    ambient_correction           = 'none'
    use_ambient_corrected_counts = false
    doublet_detection            = 'scdblfinder'
    scdblfinder_dbr_sd           = 1
    doublet_removal              = true

    // Extension integration
    normalization_method         = 'log1p'
    feature_selection            = 'hvgs'
    integration_methods          = 'scvi,symphony'
    scib                         = true
    scib_max_cells               = 100000
    scib_metric_profile          = 'fast'

    // Downstream scope and scaling for 645k merged cells
    clustering_resolutions       = '1.0'
    analysis_plan                = 'https://scdownstream.nbg1.your-objectstorage.com/test-data/samplesheets/analysis_plan_minimal.csv'
    cytetype_study_context       = ''
    skip_liana                   = true
    skip_qc_report               = true
    memory_scale                 = 3
}
