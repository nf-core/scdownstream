nextflow_process {

    name "Test Process SCANPY_SCRUBLET"
    script "../main.nf"
    process "SCANPY_SCRUBLET"

    tag "modules"
    tag "modules_nfcore"
    tag "scanpy"
    tag "scanpy/scrublet"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = Channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'sample'
                """
            }
        }

        then {
            assertAll(
            { assert process.success },
            {
                def predictions = parquet(process.out.predictions[0][1])
                assert file(process.out.predictions[0][1]).name == 'test_scrublet.parquet'
                assert predictions.columnNames == ['__index__', 'test_scrublet']
                assert predictions.schema.fields.find { it.name == 'test_scrublet' }.physicalType == 'BOOLEAN'
                assert predictions.compressionCodecs == ['SNAPPY']
                def rows = predictions.rows
                assert rows.size() > 0
                assert rows.every { it.__index__ instanceof String && it.test_scrublet instanceof Boolean }
                assert rows.collect { it.__index__ }.toSet().size() == rows.size()
                assert rows.findAll { !it.test_scrublet }.collect { it.__index__ } == anndata(process.out.h5ad[0][1]).obs.index.values
                def scores = parquet(process.out.scores[0][1])
                assert scores.columnNames == ['__index__', 'scrublet_score']
                assert scores.compressionCodecs == ['SNAPPY']
                assert scores.rows.collect { it.__index__ } == rows.collect { it.__index__ }
                assert scores.rows.every { it.scrublet_score instanceof Number }
            },
            { assert snapshot(
                sanitizeOutput(process.out, unstableKeys: ["h5ad", "predictions", "scores"]),
                process.out.versions.collect { path(it).yaml }
            ).match() }
            )
        }

    }

    test("Should run with empty string for batch_col") {

        when {
            process {
                """
                input[0] = Channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
            { assert process.success },
            {
                def unbatchedScores = parquet(process.out.scores[0][1])
                assert unbatchedScores.columnNames == ['__index__', 'scrublet_score']
                assert snapshot(
                sanitizeOutput(process.out, unstableKeys: ["h5ad", "predictions", "scores"]),
                process.out.versions.collect { path(it).yaml }
            ).match() }
            )
        }

    }

    test("Should run with empty array for batch_col") {

        when {
            process {
                """
                input[0] = Channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = []
                """
            }
        }

        then {
            assertAll(
            { assert process.success },
            {
                def emptyBatchScores = parquet(process.out.scores[0][1])
                assert emptyBatchScores.rows.collect { it.__index__ } == parquet(process.out.predictions[0][1]).rows.collect { it.__index__ }
                assert snapshot(
                sanitizeOutput(process.out, unstableKeys: ["h5ad", "predictions", "scores"]),
                process.out.versions.collect { path(it).yaml }
            ).match() }
            )
        }

    }


    test("Should fail with non-existing batch_col") {

        when {
            process {
                """
                input[0] = Channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'non_existing_col'
                """
            }
        }

        then {
            assertAll(
            { assert process.failed }
            )
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            process {
                """
                input[0] = Channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'sample'
                """
            }
        }

        then {
            assertAll(
            { assert process.success },
            { assert snapshot(
                sanitizeOutput(process.out),
                process.out.versions.collect { path(it).yaml }
            ).match() }
            )
        }

    }

}
