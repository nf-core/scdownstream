nextflow_process {

    name "Test Process SCVITOOLS_SOLO"
    script "../main.nf"
    process "SCVITOOLS_SOLO"

    tag "modules"
    tag "modules_nfcore"
    tag "scvitools"
    tag "scvitools/solo"

    test("Should run without batch column") {
        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                ]
                input[1] = []
                input[2] = 1
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                {
                    def predictions = path(process.out.predictions[0][1]).parquet
                    assert file(process.out.predictions[0][1]).name == 'test_solo.parquet'
                    assert predictions.columnNames == ['__index__', 'test_solo']
                    assert predictions.schemaDetails.fields.find { it.name == 'test_solo' }.physicalType == 'BOOLEAN'
                    assert predictions.compressionCodecs == ['SNAPPY']
                    def rows = predictions.rowMaps
                    assert rows.size() > 0
                    assert rows.every { it.__index__ instanceof String && it.test_solo instanceof Boolean }
                    assert rows.collect { it.__index__ }.toSet().size() == rows.size()
                    assert rows.findAll { !it.test_solo }.collect { it.__index__ } == anndata(process.out.h5ad[0][1]).obs.index.values
                },
                { assert snapshot(
                    process.out.versions,
                    file(process.out.h5ad[0][1]).name,
                    file(process.out.predictions[0][1]).name
                ).match() }
            )
        }

    }

    test("Should run with batch column") {
        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                ]
                input[1] = 'sample'
                input[2] = 1
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    file(process.out.h5ad[0][1]).name,
                    file(process.out.predictions[0][1]).name
                ).match() }
            )
        }

    }

    test("Should fail with invalid batch column") {
        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                ]
                input[1] = 'invalid'
                input[2] = 1
                """
            }
        }

        then {
            assertAll(
                { assert process.failed }
            )
        }

    }

    test("Should run with batch column - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                ]
                input[1] = []
                input[2] = 1
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
