nextflow_process {

    name "Test CyteType grouping namespaces through finalisation"
    script "modules/local/adata/extend/main.nf"
    process "ADATA_EXTEND"
    config "./adapter.config"

    tag "modules"
    tag "modules_local"

    test("Should retain different global and subset annotations on overlapping cells") {
        setup {
            run("ADATA_READCSV") {
                script "../../adata/readcsv/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id: 'counts'],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679756_filtered_matrix.csv', checkIfExists: true)
                    ])
                    """
                }
            }
            run("ADATA_EXTEND", alias: "ADD_GROUPS") {
                script "../../adata/extend/main.nf"
                process {
                    """
                    csv = file(params.pipelines_testdata_base_path + '/pbmc/SRR28679756_filtered_matrix.csv', checkIfExists: true)
                    cells = csv.readLines().drop(1).collect { it.split(',')[0] }
                    rows = cells.withIndex().collect { cell, i ->
                        cell + ',' + (i < 32 ? 'sample_a' : 'sample_b') + ',' + (i % 2) + ',' + (i % 2)
                    }
                    obs = channel.of('cell,sample,pca-global-0.5_leiden,pca-subset_with_underscore-0.5_leiden\\n' + rows.join('\\n') + '\\n')
                        .collectFile(name: 'groups.csv')
                    input[0] = ADATA_READCSV.out.h5ad.combine(obs).map { meta, h5ad, fragment ->
                        [[id: 'grouped', base_index: cells], h5ad, [fragment], [], [], [], [], []]
                    }
                    """
                }
            }
            run("ADATA_SPLITCOL") {
                script "../../adata/splitcol/main.nf"
                process {
                    """
                    input[0] = ADD_GROUPS.out.h5ad
                    input[1] = 'sample'
                    """
                }
            }
            run("SCANPY_RANKGENESGROUPS", alias: "RANK_GLOBAL") {
                script "../../scanpy/rankgenesgroups/main.nf"
                process {
                    """
                    input[0] = ADD_GROUPS.out.h5ad.map { meta, h5ad -> [meta + [id: 'global'], h5ad] }
                    input[1] = 'pca-global-0.5_leiden'
                    input[2] = [[], []]
                    input[3] = 'wilcoxon'
                    input[4] = 'rank_global'
                    input[5] = true
                    """
                }
            }
            run("SCANPY_RANKGENESGROUPS", alias: "RANK_SUBSET") {
                script "../../scanpy/rankgenesgroups/main.nf"
                process {
                    """
                    input[0] = ADATA_SPLITCOL.out.h5ad.map { meta, files ->
                        [meta + [id: 'subset'], files.sort { it.name }.first()]
                    }
                    input[1] = 'pca-subset_with_underscore-0.5_leiden'
                    input[2] = [[], []]
                    input[3] = 'wilcoxon'
                    input[4] = 'rank_subset'
                    input[5] = true
                    """
                }
            }
            run("CYTETYPE", alias: "CYTETYPE_GLOBAL") {
                script "../main.nf"
                process {
                    """
                    input[0] = RANK_GLOBAL.out.h5ad
                    input[1] = 'index'
                    input[2] = 'Offline global annotation'
                    input[3] = 'pca-global-0.5_leiden'
                    input[4] = 'rank_global'
                    input[5] = 'pca'
                    input[6] = '0.5'
                    """
                }
            }
            run("CYTETYPE", alias: "CYTETYPE_SUBSET") {
                script "../main.nf"
                process {
                    """
                    input[0] = RANK_SUBSET.out.h5ad
                    input[1] = 'index'
                    input[2] = 'Offline subset annotation'
                    input[3] = 'pca-subset_with_underscore-0.5_leiden'
                    input[4] = 'rank_subset'
                    input[5] = 'pca'
                    input[6] = '0.5'
                    """
                }
            }
        }

        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = CYTETYPE_GLOBAL.out.obs.mix(CYTETYPE_SUBSET.out.obs).collect().map { fragments -> [fragments] }
                    .combine(CYTETYPE_SUBSET.out.h5ad).combine(ADD_GROUPS.out.h5ad)
                    .map { fragments, _subsetMeta, subset, baseMeta, base -> [
                        [id: 'finalised', subset_h5ad: subset.toString(), base_index: baseMeta.base_index],
                        base, fragments, [], [], [], [], []
                    ] }
                """
            }
        }

        then {
            assert process.success
            def result = anndata(process.out.h5ad[0][1])
            def subset = anndata(process.out.h5ad[0][0].subset_h5ad)
            assert result.obs.index.values.toList() == process.out.h5ad[0][0].base_index
            assert subset.n_obs > 0
            assert subset.n_obs < result.n_obs
            def fields = [cell_type: 'annotation', ontology_term: 'cellOntologyTerm', ontology_term_id: 'cellOntologyTermID', cell_state: 'cellState']
            def overlap = result.obs.index.values.findIndexOf { it == subset.obs.index.values[0] }
            assert overlap >= 0
            fields.each { field, libraryField ->
                def globalColumn = "annotation:cytetype:pca:0.5:pca-global-0.5_leiden:${field}".toString()
                def subsetColumn = "annotation:cytetype:pca:0.5:pca-subset_with_underscore-0.5_leiden:${field}".toString()
                assert globalColumn in result.obs.colnames
                assert subsetColumn in result.obs.colnames
                assert !("annotation:cytetype:pca:0.5:${field}".toString() in result.obs.colnames)
                assert result.obs.get(globalColumn).data[overlap] == "pca-global-0.5_leiden:${libraryField}".toString()
                assert result.obs.get(subsetColumn).data[overlap] == "pca-subset_with_underscore-0.5_leiden:${libraryField}".toString()
            }
        }
    }
}
