// CyteType calls the remote Nygen API. A failed call is not annotation coverage.

nextflow_process {

    name "Test Process CYTETYPE"
    script "modules/local/cytetype/main.nf"
    process "CYTETYPE"

    tag "modules"
    tag "modules_local"

    setup {
        run("SCANPY_RANKGENESGROUPS") {
            script "modules/local/scanpy/rankgenesgroups/main.nf"
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = "leiden"
                input[2] = [[], []]
                input[3] = "wilcoxon"
                input[4] = "rank_genes_groups"
                """
            }
        }
    }

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_RANKGENESGROUPS.out.h5ad
                input[1] = "index"
                input[2] = "Human B-cell scRNA-seq subset from GSE263932 (SLE/CAR-T study); synthetic test-design metadata."
                input[3] = "leiden"
                input[4] = "rank_genes_groups"
                input[5] = "scvi"
                input[6] = "0.5"
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            with(adata) {
                assert "leiden" in obs.colnames
                assert obs.colnames.any { it.startsWith("annotation:cytetype:") }
            }
            assert snapshot(path(process.out.versions[0]).yaml, adata.yaml).match()
        }

    }

    test("Should run with a symbol column other than index") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_RANKGENESGROUPS.out.h5ad
                input[1] = "symbols"
                input[2] = "Human B-cell scRNA-seq subset from GSE263932 (SLE/CAR-T study); synthetic test-design metadata."
                input[3] = "leiden"
                input[4] = "rank_genes_groups"
                input[5] = "scvi"
                input[6] = "0.5"
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            with(adata) {
                assert "leiden" in obs.colnames
                assert obs.colnames.any { it.startsWith("annotation:cytetype:") }
            }
            assert snapshot(path(process.out.versions[0]).yaml, adata.yaml).match()
        }

    }

    test("Should fail with a symbol column that does not exist") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_RANKGENESGROUPS.out.h5ad
                input[1] = "not_a_column"
                input[2] = "Human B-cell scRNA-seq subset from GSE263932 (SLE/CAR-T study); synthetic test-design metadata."
                input[3] = "leiden"
                input[4] = "rank_genes_groups"
                input[5] = "scvi"
                input[6] = "0.5"
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains('Symbol column not_a_column not found')
        }

    }

    test("Should fail with empty study context") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_RANKGENESGROUPS.out.h5ad
                input[1] = "index"
                input[2] = ""
                input[3] = "leiden"
                input[4] = "rank_genes_groups"
                input[5] = "scvi"
                input[6] = "0.5"
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains('cytetype_study_context must be a non-empty string')
        }

    }

    test("Should run without failures - stub") {

        tag "stub"

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_RANKGENESGROUPS.out.h5ad
                input[1] = "index"
                input[2] = "Human PBMC test context (nf-test stub)"
                input[3] = "leiden"
                input[4] = "rank_genes_groups"
                input[5] = "scvi"
                input[6] = "0.5"
                """
            }
        }

        then {
            assert process.success

            assert snapshot(process.out).match()
        }

    }

}
