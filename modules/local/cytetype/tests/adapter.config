process {
    withName: 'CYTETYPE_GLOBAL|CYTETYPE_SUBSET' {
        // The work directory is shared with containers; no host path enters Python's import path.
        beforeScript = "printf '%s' '${new File(projectDir.toString(), 'modules/local/cytetype/tests/cytetype_adapter.py').bytes.encodeBase64().toString()}' | base64 -d > cytetype.py"
    }
}
