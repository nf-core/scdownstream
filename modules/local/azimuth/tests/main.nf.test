nextflow_process {

    name "Test Process CELLTYPES_AZIMUTH"
    script "modules/local/azimuth/main.nf"
    process "CELLTYPES_AZIMUTH"

    tag "modules"
    tag "modules_local"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        "index",
                        "X"
                    ]
                )
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            with(adata) {
                assert "annotation:azimuth:broad:per_cell" in obs.colnames
                assert "annotation:azimuth:medium:per_cell" in obs.colnames
                assert "annotation:azimuth:fine:per_cell" in obs.colnames
                assert "annotation:azimuth:fine:per_cell:confidence" in obs.colnames
                assert "annotation:azimuth:full_hierarchy:per_cell" in obs.colnames
                assert "X_azimuth" in obsm
            }
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.obs.colnames
            ).match()
        }

    }

    test("Should run with a symbol column other than index") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        "symbols",
                        "X"
                    ]
                )
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            with(adata) {
                assert "annotation:azimuth:broad:per_cell" in obs.colnames
                assert "annotation:azimuth:medium:per_cell" in obs.colnames
                assert "annotation:azimuth:fine:per_cell" in obs.colnames
                assert "annotation:azimuth:fine:per_cell:confidence" in obs.colnames
                assert "annotation:azimuth:full_hierarchy:per_cell" in obs.colnames
                assert "X_azimuth" in obsm
            }
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.obs.colnames
            ).match()
        }

    }

    test("Should fail with a symbol column that does not exist") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        "not_a_column",
                        "X"
                    ]
                )
                """
            }
        }

        then {
            assert process.failed
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        "index",
                        "X"
                    ]
                )
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
