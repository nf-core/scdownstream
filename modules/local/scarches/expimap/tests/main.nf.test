nextflow_process {

    name "Test Process SCARCHES_EXPIMAP"
    script "modules/local/scarches/expimap/main.nf"
    process "SCARCHES_EXPIMAP"

    tag "modules"
    tag "modules_local"

    test("Should run without failures") {

        config './nextflow.config'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = channel.value([
                        [ id: 'expimap' ],
                        file("${projectDir}/assets/databases/expimap/pathways.gmt", checkIfExists: true)
                    ]
                )
                input[2] = 'batch'
                input[3] = 'X'
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            def base = anndata(new File(file(process.out.h5ad[0][1]).parent, 'combined_filtered_matrix.h5ad').toString())
            assert adata.n_obs == base.n_obs
            assert adata.n_vars == base.n_vars
            assert adata.obs.index.values == base.obs.index.values
            assert adata.var.index.values == base.var.index.values
            assert adata.obs.colnames == base.obs.colnames
            assert adata.var.colnames == base.var.colnames
            assert adata.obs.get('batch').data == base.obs.get('batch').data
            assert adata.layers == base.layers
            assert adata.varm == base.varm
            assert adata.uns == base.uns
            assert adata.obsp == base.obsp
            assert adata.varp == base.varp
            assert adata.obsm.toSet() == (base.obsm + ['X_emb']).toSet()
            assert "X_emb" in adata.obsm
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = [[], []]
                input[2] = 'batch'
                input[3] = 'X'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
