nextflow_process {

    name "Test Process SCARCHES_EXPIMAP"
    script "modules/local/scarches/expimap/main.nf"
    process "SCARCHES_EXPIMAP"

    tag "modules"
    tag "modules_local"

    test("Should run without failures") {

        config './nextflow.config'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/anndata-variations/batch_correct_name.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = channel.value([
                        [ id: 'expimap' ],
                        file("${projectDir}/assets/databases/expimap/pathways.gmt", checkIfExists: true)
                    ]
                )
                input[2] = 'batch'
                input[3] = 'X'
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            assert "X_emb" in adata.obsm
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/anndata-variations/batch_correct_name.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = [[], []]
                input[2] = 'batch'
                input[3] = 'X'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
