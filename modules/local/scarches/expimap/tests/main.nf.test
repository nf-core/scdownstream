nextflow_process {

    name "Test Process SCARCHES_EXPIMAP"
    script "modules/local/scarches/expimap/main.nf"
    process "SCARCHES_EXPIMAP"

    tag "modules"
    tag "modules_local"
    tag "fragment_embeddings"

    test("Should run without failures") {

        config './nextflow.config'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = channel.value([
                        [ id: 'expimap' ],
                        file("${projectDir}/assets/databases/expimap/pathways.gmt", checkIfExists: true)
                    ]
                )
                input[2] = 'batch'
                input[3] = 'X'
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            assert "X_emb" in adata.obsm
            assert file(process.out.obsm[0]).name == 'X_test.parquet'
            def embedding = path(process.out.obsm[0]).parquet
            assert embedding.rowCount == adata.n_obs
            assert embedding.columnNames[0] == '__index__'
            assert embedding.columnNames.drop(1) == (0..<(embedding.columnNames.size() - 1)).collect { it.toString() }
            assert embedding.schemaDetails.fields[0].logicalType.type == 'STRING'
            assert embedding.schemaDetails.fields.drop(1).every { it.physicalType in ['FLOAT', 'DOUBLE'] }
            assert embedding.compressionCodecs == ['SNAPPY']
            assert embedding.rowMaps.collect { it.__index__ } == adata.obs.index.values
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should accept MSE reconstruction loss") {

        config './nextflow.config'

        when {
            params {
                outdir = "$outputDir"
                expimap_test_recon_loss = 'mse'
            }
            process {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                ])
                input[1] = channel.value([
                    [id: 'expimap'],
                    file("${projectDir}/assets/databases/expimap/pathways.gmt", checkIfExists: true)
                ])
                input[2] = 'batch'
                input[3] = 'X'
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            assert 'X_emb' in adata.obsm
            assert file(process.out.obsm[0]).name == 'X_test.parquet'
            def embedding = path(process.out.obsm[0]).parquet
            assert embedding.rowCount == adata.n_obs
            assert embedding.columnNames[0] == '__index__'
            assert embedding.columnNames.drop(1) == (0..<(embedding.columnNames.size() - 1)).collect { it.toString() }
            assert embedding.schemaDetails.fields[0].logicalType.type == 'STRING'
            assert embedding.schemaDetails.fields.drop(1).every { it.physicalType in ['FLOAT', 'DOUBLE'] }
            assert embedding.compressionCodecs == ['SNAPPY']
            assert embedding.rowMaps.collect { it.__index__ } == adata.obs.index.values
        }

    }

    test("Should reject ZINB reconstruction loss") {

        config './nextflow.config'

        when {
            params {
                outdir = "$outputDir"
                expimap_test_recon_loss = 'zinb'
            }
            process {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                ])
                input[1] = [[], []]
                input[2] = 'batch'
                input[3] = 'X'
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains("invalid choice: 'zinb'")
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = [[], []]
                input[2] = 'batch'
                input[3] = 'X'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
