nextflow_process {

    name "Test Process CELLTYPES_CELLTYPIST"
    script "modules/local/celltypist/main.nf"
    process "CELLTYPES_CELLTYPIST"

    tag "modules"
    tag "modules_local"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        "index"
                    ]
                )
                input[1] = ["Adult_COVID19_PBMC"]
                input[2] = 'h5ad'
                """
            }
        }

        then {
            def adata = anndata(process.out.anndata[0][1])
            assert process.success
            with(adata) {
                assert "annotation:celltypist:Adult_COVID19_PBMC:per_cell" in obs.colnames
                assert "annotation:celltypist:Adult_COVID19_PBMC:per_cell:confidence" in obs.colnames
            }
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.obs.colnames
            ).match()
        }

    }

    test("Should run with a symbol column other than index") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        "symbols"
                    ]
                )
                input[1] = ["Adult_COVID19_PBMC"]
                input[2] = 'h5ad'
                """
            }
        }

        then {
            def adata = anndata(process.out.anndata[0][1])
            assert process.success
            with(adata) {
                assert "annotation:celltypist:Adult_COVID19_PBMC:per_cell" in obs.colnames
                assert "annotation:celltypist:Adult_COVID19_PBMC:per_cell:confidence" in obs.colnames
            }
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.obs.colnames
            ).match()
        }

    }

    test("Should fail with a symbol column that does not exist") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        "not_a_column"
                    ]
                )
                input[1] = ["Adult_COVID19_PBMC"]
                input[2] = 'h5ad'
                """
            }
        }

        then {
            assert process.failed
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        "index"
                    ]
                )
                input[1] = ["Adult_COVID19_PBMC"]
                input[2] = 'h5ad'
                """
            }
        }

        then {
            assert process.success

            assert snapshot(process.out).match()
        }

    }

    test("Should not write the object - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        "index"
                    ]
                )
                input[1] = ["Adult_COVID19_PBMC"]
                input[2] = ''
                """
            }
        }

        then {
            assert process.success
            assert process.out.anndata.size() == 0
            assert snapshot(process.out).match()
        }

    }

}
