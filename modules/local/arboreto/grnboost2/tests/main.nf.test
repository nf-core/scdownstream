nextflow_process {

    name "Test Process ARBORETO_GRNBOOST2"
    script "modules/local/arboreto/grnboost2/main.nf"
    process "ARBORETO_GRNBOOST2"

    tag "modules"
    tag "modules_local"

    test("Should infer one network per group") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test', obs_key: 'synthetic_label' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = []
                input[2] = 100
                input[3] = 50
                input[4] = 200
                input[5] = 0
                """
            }
        }

        then {
            assert process.success
            assert file(process.out.uns[0]).name == 'test_grn.parquet'
            def fragment = parquet(process.out.uns[0])
            assert fragment.columnNames == ['__index__', 'group', 'TF', 'target', 'importance']
            assert fragment.compressionCodecs == ['SNAPPY']
            assert fragment.schema.fields.find { it.name == '__index__' }.logicalType.type == 'STRING'
            assert fragment.schema.fields.find { it.name == 'group' }.logicalType.type == 'STRING'
            assert fragment.schema.fields.find { it.name == 'importance' }.physicalType == 'DOUBLE'
            def rows = fragment.rows
            assert rows.collect { it.group }.toSet() == ['TypeA', 'TypeB'].toSet()
            rows.groupBy { it.group }.each { _group, links ->
                assert links.size() <= 200
                def importances = links.collect { it.importance }
                assert importances == importances.sort(false).reverse()
            }
            assert rows.every { it.TF != it.target && it.importance > 0 }
            def table = path(process.out.tsv[0][1]).csv(sep: '\t')
            assert table.columnNames == ['group', 'TF', 'target', 'importance']
            assert table.rowCount == fragment.rowCount
            assert snapshot(
                path(process.out.versions[0]).yaml,
                rows.collect { it.group }.toSet().sort()
            ).match()
        }

    }

    test("Should restrict regulators to a transcription factor list") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                def tfs = file("\${workDir}/tfs.txt")
                tfs.text = 'CD74\\nS100A8\\nNOTAGENE\\n'
                input[0] = channel.of([
                        [ id: 'test', obs_key: 'synthetic_label' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = tfs
                input[2] = 1
                input[3] = 50
                input[4] = 0
                input[5] = 0
                """
            }
        }

        then {
            assert process.success
            def rows = parquet(process.out.uns[0]).rows
            assert rows.size() > 0
            assert rows.collect { it.TF }.toSet().every { it in ['CD74', 'S100A8'] }
            assert rows.collect { it.target }.toSet().size() == 1
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test', obs_key: 'synthetic_label' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = []
                input[2] = 100
                input[3] = 50
                input[4] = 200
                input[5] = 0
                """
            }
        }

        then {
            assert process.success

            assert snapshot(process.out).match()
        }

    }

}
