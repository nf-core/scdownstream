nextflow_process {

    name "Test Process SCCONCEPT_EMBED"
    script "modules/local/scconcept/embed/main.nf"
    process "SCCONCEPT_EMBED"

    tag "modules"
    tag "modules_local"
    tag "scconcept"

    test("human PBMC counts - pretrained embedding") {
        when {
            process {
                """
                input[0] = channel.of([
                    [id: 'pbmc'],
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                ])
                input[1] = channel.value([
                    [id: 'corpus40M-model30M'],
                    file(params.scconcept_model + '/config.yaml', checkIfExists: true),
                    file(params.scconcept_model + '/model.ckpt', checkIfExists: true),
                    file(params.scconcept_model + '/gene_mappings/hsapiens.csv', checkIfExists: true),
                ])
                """
            }
        }

        then {
            assert process.success
            def input = anndata("${file(process.out.h5ad[0][1]).parent}/input/counts.h5ad")
            def output = anndata(process.out.h5ad[0][1])
            def embedding = parquet(process.out.obsm[0])
            assert output.obs.index.values == input.obs.index.values
            assert output.var.index.values == input.var.index.values
            assert 'X_emb' in output.obsm
            assert embedding.rowCount == output.n_obs
            assert embedding.rows.collect { it.__index__ } == input.obs.index.values
            assert embedding.columnNames == ['__index__'] + (0..<512).collect { it.toString() }
            assert embedding.schema.fields.drop(1).every { it.physicalType == 'FLOAT' }
            assert file(process.out.obsm[0]).name == 'X_pbmc.parquet'
            def versions = path(process.out.versions[0]).yaml.SCCONCEPT_EMBED
            assert snapshot(output.n_obs, output.n_vars, versions['sc-concept']).match()
        }
    }

    test("human PBMC counts - pretrained embedding - stub") {
        options "-stub"

        when {
            process {
                """
                def fixture = file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                input[0] = channel.of([[id: 'pbmc'], fixture])
                input[1] = channel.value([[id: 'stub'], fixture, fixture, fixture])
                """
            }
        }

        then {
            assert process.success
            assert file(process.out.h5ad[0][1]).name == 'pbmc.h5ad'
            assert file(process.out.obsm[0]).name == 'X_pbmc.parquet'
            assert file(process.out.versions[0]).name == 'versions.yml'
            assert snapshot(process.out.h5ad[0][0]).match()
        }
    }
}
