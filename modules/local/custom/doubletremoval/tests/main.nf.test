nextflow_process {

    name "Test Process CUSTOM_DOUBLETREMOVAL"
    script "modules/local/custom/doubletremoval/main.nf"
    process "CUSTOM_DOUBLETREMOVAL"

    tag "modules"
    tag "modules_local"

    test("Should remove only cells with two Boolean votes and leave annotations in the fragment") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                pdd = channel.of('cell,arbitrary_prefix\\n' + (127..0).collect { i -> String.format('cell_%03d,%s\\n', i, i < 3) }.join('')).collectFile(name: 'dd calls.csv')
                psc = channel.of('cell,arbitrary_prefix\\n' + (127..0).collect { i -> String.format('cell_%03d,%s\\n', i, i in [1,3]) }.join('')).collectFile(name: 'sc.csv')
                pscr = channel.of('cell,arbitrary_prefix\\n' + (127..0).collect { i -> String.format('cell_%03d,%s\\n', i, i in [0,3]) }.join('')).collectFile(name: 'scr.csv')
                psolo = channel.of('cell,arbitrary_prefix\\n' + (127..0).collect { i -> String.format('cell_%03d,%s\\n', i, i == 4) }.join('')).collectFile(name: 'solo.csv')
                input[0] = pdd.combine(psc).combine(pscr).combine(psolo).map { a,b,c,d -> [
                    [id: 'votes', counts_layer: 'X'],
                    file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true),
                    ['doubletdetection','scdblfinder','scrublet','solo'], [a,b,c,d]
                ] }
                input[1] = 2
                input[2] = true
                """
            }
        }
        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            assert adata.n_obs == 125
            assert adata.n_vars == 128
            assert adata.layers.toList().sort() == ['counts','spliced','unspliced']
            assert adata.obs.index.values == (0..<128).findAll { !(it in [0,1,3]) }.collect { String.format('cell_%03d', it) }
            assert !adata.obs.colnames.any { it.startsWith('scrublet_') || it.startsWith('scdblfinder_') || it.startsWith('solo_') || it.startsWith('doubletdetection_') }
            assert process.out.h5ad[0][0].counts_layer == 'X'
            assert process.out.obs[0][0] == process.out.h5ad[0][0]
            assert path(process.out.obs[0][1]).exists()
            assert path(process.out.multiqc_files[0]).exists()
            assert snapshot(adata.yaml, path(process.out.versions[0]).yaml).match()
        }
    }

    test("Should retain all cells and layers with removal disabled") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                p = channel.of('cell,any_prefix\\n' + (127..0).collect { i -> String.format('cell_%03d,true\\n', i) }.join('')).collectFile(name: 'scrublet calls.csv')
                input[0] = p.map { prediction -> [
                    [id: 'annotate'],
                    file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true),
                    ['scrublet'], [prediction]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            def source = anndata(new File(process.out.h5ad[0][1].toString()).parentFile.toPath().resolve('with_layers.h5ad').toString())
            assert adata.n_obs == source.n_obs
            assert adata.n_vars == source.n_vars
            assert adata.obs.index.values == source.obs.index.values
            assert adata.var.index.values == source.var.index.values
            assert adata.layers == source.layers
            assert adata.obs.colnames == source.obs.colnames
            assert snapshot(adata.yaml).match()
        }
    }

    test("Should accept SOLO alone without score inputs") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,solo_sample\\n' + (127..0).collect { i -> String.format('cell_%03d,%s\\n', i, i == 1) }.join(''))
                    .collectFile(name: 'solo.csv').map { p -> [
                        [id: 'solo'],
                        file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true),
                        ['solo'], [p]
                    ] }
                input[1] = 1
                input[2] = true
                """
            }
        }
        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            assert adata.n_obs == 127
            assert adata.obs.index.values == (0..<128).findAll { it != 1 }.collect { String.format('cell_%03d', it) }
            assert !('solo_class' in adata.obs.colnames)
            assert path(process.out.obs[0][1]).exists()
            assert snapshot(adata.yaml).match()
        }
    }

    test("Should emit the base and fragment in stub mode") {
        options "-stub"
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,solo\\ncell_000,true\\n').collectFile(name: 'solo.csv').map { p -> [
                    [id: 'stub'],
                    file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true),
                    ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = true
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }

    test("Should accept existing Boolean prediction pickles") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of([
                    [id: 'pickle'],
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                    ['solo'],
                    [file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_solo.pkl', checkIfExists: true)]
                ])
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            assert adata.n_obs == 384
            assert !('solo_class' in adata.obs.colnames)
            assert path(process.out.obs[0][1]).exists()
        }
    }
}
