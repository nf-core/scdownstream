nextflow_process {

    name "Test Process CUSTOM_DOUBLETREMOVAL"
    script "modules/local/custom/doubletremoval/main.nf"
    process "CUSTOM_DOUBLETREMOVAL"

    tag "modules"
    tag "modules_local"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        [
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_doubletdetection.parquet', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_scrublet.parquet', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_solo.parquet', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = 2
                input[2] = true
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            assert adata.n_obs == 370
            def predictions = ['test_doubletdetection', 'test_scrublet', 'test_solo'].collect { adata.obs.get(it).data }
            assert (0..<adata.n_obs).every { row -> predictions.count { it[row].toString().equalsIgnoreCase('true') } < 2 }
            def versions = path(process.out.versions[0]).yaml.CUSTOM_DOUBLETREMOVAL
            assert snapshot(
                process.out.h5ad,
                versions.findAll { key, value -> key != 'matplotlib' },
                adata.yaml
            ).match()
        }

    }

    test("Should annotate doublets without removing cells") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        [
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_doubletdetection.parquet', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_scrublet.parquet', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_solo.parquet', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = 2
                input[2] = false
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            assert adata.n_obs == 384
            assert "test_scrublet" in adata.obs.colnames
            assert "test_solo" in adata.obs.colnames
            assert "test_doubletdetection" in adata.obs.colnames
        }

    }

    test("Should reject legacy CSV prediction tables") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,doublet\\ncell_000,false\\n')
                    .collectFile(name: 'predictions.csv')
                    .map { table -> [
                        [id: 'legacy'],
                        file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true),
                        [table]
                    ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('ValueError: Unsupported prediction file extension: predictions.csv')
        }
    }

    test("Should reject prediction tables without an explicit index") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = [
                    [id: 'missing_index'],
                    file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true),
                    [file(params.pipelines_testdata_base_path + '/intermediates/fragments/regressions/missing_index.parquet', checkIfExists: true)]
                ]
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("Prediction table 'missing_index.parquet' is missing the '__index__' column")
        }
    }

    test("Should run without failures - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        [
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_doubletdetection.parquet', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_scrublet.parquet', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_solo.parquet', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = 2
                input[2] = true
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
