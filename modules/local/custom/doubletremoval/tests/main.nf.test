nextflow_process {

    name "Test Process CUSTOM_DOUBLETREMOVAL"
    script "modules/local/custom/doubletremoval/main.nf"
    process "CUSTOM_DOUBLETREMOVAL"

    tag "modules"
    tag "modules_local"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        [
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_doubletdetection.pkl', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_scrublet.pkl', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_solo.pkl', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = 2
                input[2] = true
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            assert adata.n_obs == 370
            def predictions = ['doubletdetection', 'scrublet', 'solo'].collect { adata.obs.get(it).data }
            assert (0..<adata.n_obs).every { row -> predictions.count { it[row].toString().equalsIgnoreCase('true') } < 2 }
            def versions = path(process.out.versions[0]).yaml.CUSTOM_DOUBLETREMOVAL
            assert snapshot(
                process.out.h5ad,
                versions.findAll { key, value -> key != 'matplotlib' },
                adata.yaml
            ).match()
        }

    }

    test("Should annotate doublets without removing cells") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        [
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_doubletdetection.pkl', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_scrublet.pkl', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_solo.pkl', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = 2
                input[2] = false
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            assert adata.n_obs == 384
            // Call columns are named after the method only, so that they are identical across datasets
            assert "scrublet" in adata.obs.colnames
            assert "solo" in adata.obs.colnames
            assert "doubletdetection" in adata.obs.colnames
            assert !adata.obs.colnames.any { it.startsWith("test_") }
            // A method that was not run must not show up as an implicit singlet call
            assert !("scdblfinder" in adata.obs.colnames)
        }

    }

    test("Should run without failures - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        [
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_doubletdetection.pkl', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_scrublet.pkl', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/test_solo.pkl', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = 2
                input[2] = true
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
