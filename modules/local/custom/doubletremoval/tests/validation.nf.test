nextflow_process {

    name "Test strict doublet prediction validation"
    script "modules/local/custom/doubletremoval/main.nf"
    process "CUSTOM_DOUBLETREMOVAL"

    tag "modules"
    tag "modules_local"

    test("Should leave existing call annotations to finalisation") {
        setup {
            run("ADATA_EXTEND") {
                script "../../../adata/extend/main.nf"
                process {
                    """
                    input[0] = channel.of(file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/regressions/existing.parquet', checkIfExists: true)).map { obs -> [
                        [id: 'existing'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), [obs], [], [], [], [], []
                    ] }
                    """
                }
            }
        }
        when {
            params { outdir = "$outputDir" }
            process {
                """
                p = channel.of(file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/regressions/zero.parquet', checkIfExists: true))
                input[0] = ADATA_EXTEND.out.h5ad.combine(p).map { meta, base, prediction -> [meta + [id: 'existing_calls'], base, ['solo'], [prediction]] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            assert adata.n_obs == 128
            assert adata.obs.get('solo_class').data[0] == 'singlet'
            assert !('solo_predicted_doublet' in adata.obs.colnames)
            assert path(process.out.obs[0][1]).exists()
        }
    }

    test("Should reject duplicate input H5AD barcodes") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,call\\ncell_000,false\\n').collectFile(name: 'p.csv').map { p -> [
                    [id: 'input'], file(params.pipelines_testdata_base_path + '/anndata-variations/obs_duplicate_names.h5ad', checkIfExists: true), ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('Input H5AD contains duplicate barcodes')
        }
    }

    test("Should reject duplicate prediction indices") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of(file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/regressions/duplicate.parquet', checkIfExists: true)).map { p -> [
                    [id: 'duplicate'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("Prediction table 'duplicate.parquet' contains duplicate indices")
        }
    }

    test("Should reject missing prediction barcodes even when another table covers them") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                p = channel.of(file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/regressions/missing.parquet', checkIfExists: true))
                solo = channel.of(file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/regressions/zero.parquet', checkIfExists: true))
                input[0] = p.combine(solo).map { a,b -> [
                    [id: 'missing'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['scrublet','solo'], [a,b]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('predictions/missing.parquet must contain each input barcode exactly once')
        }
    }

    test("Should reject extra prediction barcodes") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of(file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/regressions/extra.parquet', checkIfExists: true)).map { p -> [
                    [id: 'extra'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('predictions/extra.parquet must contain each input barcode exactly once')
        }
    }

    test("Should reject multiple prediction columns") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of(file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/regressions/columns.parquet', checkIfExists: true)).map { p -> [
                    [id: 'columns'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('predictions/columns.parquet must contain exactly one Boolean column')
        }
    }

    test("Should reject null Boolean predictions") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of(file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/regressions/null.parquet', checkIfExists: true)).map { p -> [
                    [id: 'null'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('predictions/null.parquet must contain non-null Boolean predictions')
        }
    }

    test("Should reject ambiguous Boolean predictions") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of(file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/regressions/invalid.parquet', checkIfExists: true)).map { p -> [
                    [id: 'invalid'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('predictions/invalid.parquet must contain non-null Boolean predictions')
        }
    }

    test("Should reject numeric values instead of treating them as Boolean calls") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of(file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/regressions/numeric.parquet', checkIfExists: true)).map { p -> [
                    [id: 'numeric'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('predictions/numeric.parquet must contain non-null Boolean predictions')
        }
    }

    test("Should reject fewer prediction files than methods") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of(file(params.pipelines_testdata_base_path + '/intermediates/doublet_detection/regressions/zero.parquet', checkIfExists: true)).map { p -> [
                    [id: 'count'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo', 'scrublet'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('zip() argument 2 is shorter than argument 1')
        }
    }
}
