nextflow_process {

    name "Test strict doublet prediction validation"
    script "modules/local/custom/doubletremoval/main.nf"
    process "CUSTOM_DOUBLETREMOVAL"

    tag "modules"
    tag "modules_local"

    test("Should reject canonical call names already present in the input") {
        setup {
            run("ADATA_EXTEND") {
                script "../../../adata/extend/main.nf"
                process {
                    """
                    input[0] = channel.of('cell,solo_class\\ncell_000,singlet\\n').collectFile(name: 'existing.csv').map { obs -> [
                        [id: 'existing'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), [obs], [], [], [], [], []
                    ] }
                    """
                }
            }
        }
        when {
            params { outdir = "$outputDir" }
            process {
                """
                p = channel.of('cell,call\\n' + (0..<128).collect { i -> String.format('cell_%03d,false\\n', i) }.join('')).collectFile(name: 'p.csv')
                input[0] = ADATA_EXTEND.out.h5ad.combine(p).map { meta, base, prediction -> [meta, base, ['solo'], [prediction]] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("Canonical annotation names collide with input observation columns: ['solo_class']")
        }
    }

    test("Should reject duplicate prediction paths") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,call\\ncell_000,false\\n').collectFile(name: 'p.csv').map { p -> [
                    [id: 'duplicate_path'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['scrublet','solo'], [p,p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('input file name collision')
            assert process.errorReport.contains('predictions/p.csv')
        }
    }

    test("Should reject duplicate input H5AD barcodes") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,call\\ncell_000,false\\n').collectFile(name: 'p.csv').map { p -> [
                    [id: 'input'], file(params.pipelines_testdata_base_path + '/anndata-variations/obs_duplicate_names.h5ad', checkIfExists: true), ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('Input H5AD contains duplicate barcodes')
        }
    }

    test("Should reject duplicate prediction indices") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,call\\ncell_000,true\\ncell_000,false\\n').collectFile(name: 'duplicate.csv').map { p -> [
                    [id: 'duplicate'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("solo table 'predictions/duplicate.csv' contains duplicate indices")
            assert process.errorReport.contains('cell_000')
        }
    }

    test("Should reject missing prediction barcodes even when another table covers them") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                p = channel.of('cell,call\\n' + (1..<128).collect { i -> String.format('cell_%03d,false\\n', i) }.join('')).collectFile(name: 'missing.csv')
                solo = channel.of('cell,call\\n' + (0..<128).collect { i -> String.format('cell_%03d,false\\n', i) }.join('')).collectFile(name: 'complete.csv')
                input[0] = p.combine(solo).map { a,b -> [
                    [id: 'missing'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['scrublet','solo'], [a,b]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("scrublet table 'predictions/missing.csv' barcode coverage mismatch")
            assert process.errorReport.contains("missing=['cell_000']")
        }
    }

    test("Should reject extra prediction barcodes") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,call\\n' + (0..128).collect { i -> String.format('cell_%03d,false\\n', i) }.join('')).collectFile(name: 'extra.csv').map { p -> [
                    [id: 'extra'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("solo table 'predictions/extra.csv' barcode coverage mismatch")
            assert process.errorReport.contains("extra=['cell_128']")
        }
    }

    test("Should reject duplicate prediction CSV headers before pandas renames them") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,call,call\\ncell_000,true,false\\n').collectFile(name: 'headers.csv').map { p -> [
                    [id: 'headers'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("solo table 'predictions/headers.csv' contains duplicate CSV headers")
        }
    }

    test("Should reject multiple prediction columns") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,call,score\\n' + (0..<128).collect { i -> String.format('cell_%03d,false,9999\\n', i) }.join('')).collectFile(name: 'columns.csv').map { p -> [
                    [id: 'columns'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("solo prediction 'predictions/columns.csv' must contain exactly one Boolean column")
        }
    }

    test("Should reject null Boolean predictions") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,call\\n' + (0..<128).collect { i -> String.format('cell_%03d,%s\\n', i, i == 5 ? '' : 'false') }.join('')).collectFile(name: 'null.csv').map { p -> [
                    [id: 'null'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('null or invalid Boolean votes')
            assert process.errorReport.contains('cell_005')
        }
    }

    test("Should reject ambiguous Boolean predictions") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,call\\n' + (0..<128).collect { i -> String.format('cell_%03d,%s\\n', i, i == 5 ? 'singlet' : 'false') }.join('')).collectFile(name: 'invalid.csv').map { p -> [
                    [id: 'invalid'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("solo prediction 'predictions/invalid.csv' contains null or invalid Boolean votes")
        }
    }

    test("Should reject duplicate method records") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,call\\ncell_000,false\\n').collectFile(name: 'p.csv').map { p -> [
                    [id: 'methods'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo','solo'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('Duplicate doublet methods')
        }
    }

    test("Should reject unknown method identifiers") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,call\\ncell_000,false\\n').collectFile(name: 'p.csv').map { p -> [
                    [id: 'unknown'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['unknown'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('Unknown or empty doublet methods')
        }
    }

    test("Should reject unsorted methods") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,call\\ncell_000,false\\n').collectFile(name: 'p.csv').map { p -> [
                    [id: 'unsorted'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo','scrublet'], [p]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('Doublet methods must be sorted')
        }
    }

    test("Should reject missing prediction files") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of([
                    [id: 'count'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['solo'], []
                ])
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('Table counts must match methods')
        }
    }
}
