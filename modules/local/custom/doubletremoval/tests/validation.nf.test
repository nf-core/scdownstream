                p = channel.of('cell,call\\n' + (0..<128).collect { i -> String.format('cell_%03d,false\\n', i) }.join('')).collectFile(name: 'p.csv')
                s = channel.of('cell,doublet_score,predicted_doublet\\n' + (0..<128).collect { i -> String.format('cell_%03d,1,%s\\n', i, i == 3 ? '' : 'false') }.join('')).collectFile(name: 'null_native.csv')
                input[0] = p.combine(s).map { a,b -> [
                    [id: 'native'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['scrublet'], [a], [b]
                ] }
                input[1] = 1
