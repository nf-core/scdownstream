    test("Should reject contradictory native scDblFinder classes") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                p = channel.of('cell,call\\n' + (0..<128).collect { i -> String.format('cell_%03d,false\\n', i) }.join('')).collectFile(name: 'p.csv')
                s = channel.of('cell,scDblFinder.score,scDblFinder.class\\n' + (0..<128).collect { i -> String.format('cell_%03d,1,%s\\n', i, i == 3 ? 'doublet' : 'singlet') }.join('')).collectFile(name: 'contradiction.csv')
                input[0] = p.combine(s).map { a,b -> [
                    [id: 'class'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['scdblfinder'], [a], [b]
