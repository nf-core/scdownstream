    test("Should reject contradictory native Boolean calls") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                p = channel.of('cell,call\\n' + (0..<128).collect { i -> String.format('cell_%03d,false\\n', i) }.join('')).collectFile(name: 'p.csv')
                s = channel.of('cell,doublet_score,doublet\\n' + (0..<128).collect { i -> String.format('cell_%03d,1,%s\\n', i, i == 3) }.join('')).collectFile(name: 'contradiction.csv')
                input[0] = p.combine(s).map { a,b -> [
                    [id: 'native'], file(params.pipelines_testdata_base_path + '/anndata-variations/with_layers.h5ad', checkIfExists: true), ['doubletdetection'], [a], [b]
                ] }
                input[1] = 1
                input[2] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("doubletdetection scores 'scores/contradiction.csv' native call contradicts Boolean predictions")
        }
    }

    test("Should reject null native Boolean calls") {
        when {
            params { outdir = "$outputDir" }
            process {
