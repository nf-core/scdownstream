    test("Should reject invalid numeric scores rather than using them as votes") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                p = channel.of('cell,call\\n' + (0..<128).collect { i -> String.format('cell_%03d,false\\n', i) }.join('')).collectFile(name: 'p.csv')
