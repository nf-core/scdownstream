nextflow_process {

    name "Test Process CUSTOM_AGGREGATE_PER_CELL_ANNOTATIONS"
    script "modules/local/custom/aggregate_per_cell_annotations/main.nf"
    process "CUSTOM_AGGREGATE_PER_CELL_ANNOTATIONS"

    tag "modules"
    tag "modules_local"

    test("Should distinguish named subsets and preserve global annotation names") {

        setup {
            run("ADATA_EXTEND") {
                script "../../../adata/extend/main.nf"
                process {
                    """
                    input[0] = channel.of('cell,annotation:test:per_cell\\nSRR28679756_AAACCTGAGAGCTGGT,T_cell\\nSRR28679756_AAACCTGAGATGCCTT,T_cell\\n')
                        .collectFile(name: 'annotations.csv')
                        .map { obs -> [
                            [id: 'annotations'],
                            file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                            [obs], [], [], [], [], []
                        ] }
                    """
                }
            }
        }

        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = ADATA_EXTEND.out.h5ad.flatMap { meta, h5ad -> [
                    [[id: 'global', subset: 'global'], h5ad],
                    [[id: 'named', subset: 'T_cells'], h5ad],
                    [[id: 'unsplit'], h5ad]
                ] }
                input[1] = 'annotation:test:per_cell'
                input[2] = 'annotation:test:per_cell'
                input[3] = 'scvi'
                input[4] = '0.5'
                """
            }
        }

        then {
            assert process.success
            assert process.out.obs.size() == 3
            def names = [:]
            process.out.aggregate_per_cell_annotations.each { summary ->
                def file = path(summary)
                def context = file.fileName.toString().split('_aggregate')[0]
                names[context] = file.text.readLines().drop(1).collect { it.split(',')[2] }.toSet().toList().sort()
            }
            assert names.global == ['annotation:test:aggregated:scvi:0.5']
            assert names.unsplit == names.global
            assert names.named == ['annotation:test:aggregated:scvi:0.5:subset:T_cells']
            assert snapshot(names).match()
        }

    }

    test("Should reject annotation columns without a per-cell suffix") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'leiden'
                input[2] = 'sample'
                input[3] = 'scvi'
                input[4] = '0.5'
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains("ValueError: Unexpected per-cell annotation column: 'sample'")
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'leiden'
                input[2] = 'annotation:celltypist:Adult_COVID19_PBMC:per_cell'
                input[3] = 'scvi'
                input[4] = '0.5'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
