nextflow_process {

    name "Test Process CELL2CELL_TENSOR"
    script "modules/local/cell2cell/tensor/main.nf"
    process "CELL2CELL_TENSOR"

    tag "modules"
    tag "modules_local"

    test("Should decompose by-sample LIANA results") {

        setup {
            run("LIANA_BYSAMPLE") {
                script "modules/local/liana/bysample/main.nf"
                process {
                    """
                    input[0] = channel.of([
                            [ id: 'test', obs_key: 'leiden' ],
                            file(params.pipelines_testdata_base_path + '/pbmc/with_label_and_condition_pca.h5ad', checkIfExists: true)
                        ]
                    )
                    input[1] = 'leiden'
                    input[2] = 'condition'
                    input[3] = 10
                    input[4] = 500
                    input[5] = 'stratified_obs'
                    input[6] = 42
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = LIANA_BYSAMPLE.out.results
                    .join(LIANA_BYSAMPLE.out.contexts)
                    .map { meta, results, contexts -> [meta, results, contexts] }
                input[1] = 'condition'
                input[2] = 2
                input[3] = 42
                input[4] = 'human'
                """
            }
        }

        then {
            assert process.success
            assert process.out.plots
            assert process.out.loadings
            assert process.out.tensor
            assert process.out.multiqc_files
            def plot_names = process.out.plots[0][1].collect { file(it).name }.sort()
            def loading_names = process.out.loadings.flatten().collect { file(it).name }.sort()
            def mqc_names = process.out.multiqc_files.flatten().collect { file(it).name }.sort()
            assert plot_names.any { it.endsWith('_loadings_product.png') }
            assert plot_names.any { it.endsWith('_tensor_factors.png') }
            assert plot_names.any { it.endsWith('_loadings_lr_clustermap.png') }
            assert plot_names.any { it.endsWith('_loadings_contexts_clustermap.png') }
            // Pathway enrichment needs Omnipath; assert only when produced
            if (plot_names.any { it.endsWith('_pathway_enrichment_dotplot.png') }) {
                assert mqc_names.any { it.endsWith('_pathway_enrichment_dotplot_mqc.json') }
            }
            assert mqc_names.every { it.endsWith('_mqc.json') }
            assert mqc_names.size() == plot_names.size()
            assert loading_names.any { it.contains('loadings_contexts') }
            assert loading_names.any { it.contains('loadings_sender_cells') }
            assert loading_names.any { it.contains('loadings_receiver_cells') }
            assert snapshot(
                path(process.out.versions[0]).yaml,
                plot_names,
                loading_names,
                mqc_names
            ).match()
        }

    }

    test("Should run without failures - stub") {

        tag "stub"

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_pca.h5ad', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'sample'
                input[2] = 2
                input[3] = 42
                input[4] = 'human'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
