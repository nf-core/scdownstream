nextflow_process {

    name "Test Process DROPLETUTILS_EMPTYDROPS"
    script "modules/local/dropletutils/emptydrops/main.nf"
    process "DROPLETUTILS_EMPTYDROPS"

    tag "modules"
    tag "modules_local"
    tag "dropletutils"
    tag "dropletutils/emptydrops"

    test("Should call cells from an unfiltered matrix") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 100
                input[2] = 0.01
                """
            }
        }

        then {
            assert process.success
            def results = path(process.out.results[0][1]).readLines()
            assert path(process.out.barcodes[0][1]).readLines().size() > 0
            assert results[0] == '"barcode","Total","LogProb","PValue","Limited","FDR"'
            assert snapshot(
                process.out.barcodes,
                file(process.out.results[0][1]).name,
                results.size(),
                path(process.out.versions[0]).yaml
            ).match()
        }

    }

    test("Should call cells from an unfiltered matrix - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 100
                input[2] = 0.01
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
