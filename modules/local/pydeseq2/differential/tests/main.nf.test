nextflow_process {

    name "Test Process PYDESEQ2_DIFFERENTIAL"
    script "modules/local/pydeseq2/differential/main.nf"
    process "PYDESEQ2_DIFFERENTIAL"

    tag "modules"
    tag "modules_local"

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [id: 'test'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = ''
                input[2] = ''
                input[3] = []
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
