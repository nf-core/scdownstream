nextflow_process {

    name "Test Process LIANA_BYSAMPLE"
    script "modules/local/liana/bysample/main.nf"
    process "LIANA_BYSAMPLE"

    tag "modules"
    tag "modules_local"

    test("Should run by-sample LIANA with multi-context input") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test', obs_key: 'leiden' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'leiden'
                input[2] = 'condition'
                input[3] = 10
                input[4] = 500
                input[5] = 'stratified_obs'
                input[6] = 42
                input[7] = true
                input[8] = 'human'
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
            assert process.out.contexts
            def results = file(process.out.results[0][1])
            def contexts = file(process.out.contexts[0][1])
            assert results.exists()
            assert contexts.exists()
            def contextNames = contexts.readLines().drop(1).collect { it.split('\t')[0] }.toSet()
            assert contextNames == ['Disease', 'Healthy'].toSet()
            def rows = new java.util.zip.GZIPInputStream(new FileInputStream(results)).withCloseable { stream ->
                stream.getText('UTF-8').readLines()
            }
            def columns = rows[0].split(',').toList()
            assert columns.containsAll(['condition', 'magnitude_rank', 'ligand_means', 'receptor_means'])
            def contextIndex = columns.indexOf('condition')
            def rankIndex = columns.indexOf('magnitude_rank')
            def interactions = rows.drop(1).collect { it.split(',') }
            assert interactions.collect { it[contextIndex] }.toSet() == contextNames
            assert interactions.every { it[rankIndex].toDouble() >= 0 && it[rankIndex].toDouble() <= 1 }
            assert snapshot(
                path(process.out.versions[0]).yaml,
                results.name,
                contexts.name
            ).match()
        }

    }

    test("Should skip when fewer than two contexts") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test', obs_key: 'leiden' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'leiden'
                input[2] = 'sample'
                input[3] = 10
                input[4] = 500
                input[5] = 'stratified_obs'
                input[6] = 42
                input[7] = true
                input[8] = 'human'
                """
            }
        }

        then {
            assert process.success
            assert process.out.results.size() == 0
            assert process.out.contexts.size() == 0
            assert snapshot(
                path(process.out.versions[0]).yaml
            ).match()
        }

    }

    test("Should select the mouse resource for by-sample mouse analysis") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of([
                    [id: 'mouse_resource', obs_key: 'leiden'],
                    file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)
                ])
                input[1] = 'leiden'
                input[2] = 'condition'
                input[3] = 10
                input[4] = 500
                input[5] = 'stratified_obs'
                input[6] = 42
                input[7] = true
                input[8] = 'mouse'
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains('mouseconsensus')
            assert process.errorReport.contains('Too few features from the resource were found in the data')
        }
    }

    test("Should run without failures - stub") {

        tag "stub"

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'leiden'
                input[2] = 'sample'
                input[3] = 10
                input[4] = 500
                input[5] = 'stratified_obs'
                input[6] = 42
                input[7] = true
                input[8] = 'human'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
