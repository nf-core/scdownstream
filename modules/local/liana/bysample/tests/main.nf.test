nextflow_process {

    name "Test Process LIANA_BYSAMPLE"
    script "modules/local/liana/bysample/main.nf"
    process "LIANA_BYSAMPLE"

    tag "modules"
    tag "modules_local"

    test("Should run by-sample LIANA with multi-context input") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test', obs_key: 'leiden' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/with_label_and_condition_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'leiden'
                input[2] = 'condition'
                input[3] = 10
                input[4] = 500
                input[5] = 'stratified_obs'
                input[6] = 42
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
            assert process.out.contexts
            def results = file(process.out.results[0][1])
            def contexts = file(process.out.contexts[0][1])
            assert results.exists()
            assert contexts.exists()
            assert snapshot(
                path(process.out.versions[0]).yaml,
                results.name,
                contexts.name
            ).match()
        }

    }

    test("Should skip when fewer than two contexts") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test', obs_key: 'leiden' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'leiden'
                input[2] = 'sample'
                input[3] = 10
                input[4] = 500
                input[5] = 'stratified_obs'
                input[6] = 42
                """
            }
        }

        then {
            assert process.success
            assert process.out.results.size() == 0
            assert process.out.contexts.size() == 0
            assert snapshot(
                path(process.out.versions[0]).yaml
            ).match()
        }

    }

    test("Should run without failures - stub") {

        tag "stub"

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'leiden'
                input[2] = 'sample'
                input[3] = 10
                input[4] = 500
                input[5] = 'stratified_obs'
                input[6] = 42
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
