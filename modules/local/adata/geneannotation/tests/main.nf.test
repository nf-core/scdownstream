nextflow_process {

    name "Test Process ADATA_GENEANNOTATION"
    script "../main.nf"
    process "ADATA_GENEANNOTATION"

    tag "modules"
    tag "modules_local"
    tag "adata/geneannotation"

    test("Should annotate genes from a GTF-derived gene table") {

        when {
            process {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                ])
                input[1] = file("${projectDir}/modules/local/adata/geneannotation/tests/gene_table.tsv", checkIfExists: true)
                input[2] = 'human'
                """
            }
        }

        then {
            assert process.success
            def lines = path(process.out.csv[0][1]).readLines()
            def rows = lines.drop(1).collectEntries { line -> [(line.tokenize(',')[0]): line] }
            assertAll(
                { assert lines[0] == ',gene_biotype,chromosome,biotype_group,gene_annotation_ambiguous' },
                { assert lines.size() == 3001 },
                { assert rows['RPL8'] == 'RPL8,protein_coding,8,protein_coding,False' },
                { assert rows['RPL21P105'] == 'RPL21P105,processed_pseudogene,12,pseudogene,False' },
                { assert rows['LINC00996'] == 'LINC00996,lncRNA,7,lncRNA,False' },
                // Alternate-haplotype entries are ignored when a primary chromosome is present
                { assert rows['IGHM'] == 'IGHM,IG_C_gene,14,IG_TR_gene,False' },
                { assert rows['HLA-B'] == 'HLA-B,protein_coding,6,protein_coding,False' },
                // Genes missing from the table are kept with empty annotations
                { assert rows['CD33'] == 'CD33,,,,False' },
                { assert path(process.out.versions[0]).yaml.ADATA_GENEANNOTATION.containsKey('pandas') }
            )
        }

    }

    test("Should annotate genes with mygene") {

        when {
            process {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                ])
                input[1] = []
                input[2] = 'human'
                """
            }
        }

        then {
            if (process.failed) {
                assert process.errorReport.contains('502 Bad Gateway')
            } else {
                def lines = path(process.out.csv[0][1]).readLines()
                def rows = lines.drop(1).collectEntries { line -> [(line.tokenize(',')[0]): line] }
                assertAll(
                    { assert lines[0] == ',gene_biotype,chromosome,biotype_group,gene_annotation_ambiguous' },
                    { assert lines.size() == 3001 },
                    // Alias hits (e.g. MPP2 for DLG2) must not make the chromosome ambiguous
                    { assert rows['DLG2'].startsWith('DLG2,protein_coding,11,protein_coding,') },
                    { assert rows['IGHM'].startsWith('IGHM,IG_C_gene,14,IG_TR_gene,') },
                    { assert path(process.out.versions[0]).yaml.ADATA_GENEANNOTATION.containsKey('mygene') }
                )
            }
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            process {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                ])
                input[1] = []
                input[2] = 'human'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.csv[0][1]).readLines()[0] == ',gene_biotype,chromosome,biotype_group,gene_annotation_ambiguous' },
                { assert process.out.var.size() == 1 }
            )
        }

    }

}
