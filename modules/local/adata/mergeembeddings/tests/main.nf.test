nextflow_process {

    name "Test Process ADATA_MERGEEMBEDDINGS"
    script "modules/local/adata/mergeembeddings/main.nf"
    process "ADATA_MERGEEMBEDDINGS"

    tag "modules"
    tag "modules_local"
    tag "fragment_embeddings"

    test("Should merge scvi embeddings") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                    [id: 'scvi'],
                    'scvi',
                    file(params.pipelines_testdata_base_path + '/intermediates/merge_embeddings/integrated_scvi.h5ad', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + '/intermediates/merge_embeddings/base_scvi.h5ad', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + '/intermediates/merge_embeddings/combined_scvi.h5ad', checkIfExists: true)
                ])
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            with(adata) {
                assert "X_emb" in obsm
                assert obs.rownames.size() == 80
            }
            assert file(process.out.obsm[0]).name == "X_scvi.parquet"
            def embedding = parquet(process.out.obsm[0])
            assert embedding.rowCount == adata.n_obs
            assert embedding.columnNames[0] == '__index__'
            assert embedding.columnNames.drop(1) == (0..<(embedding.columnNames.size() - 1)).collect { it.toString() }
            assert embedding.schema.fields[0].logicalType.type == 'STRING'
            assert embedding.schema.fields.drop(1).every { it.physicalType in ['FLOAT', 'DOUBLE'] }
            assert embedding.compressionCodecs == ['SNAPPY']
            assert embedding.rows.collect { it.__index__ } == adata.obs.index.values
            assert process.out.obs.size() == 0
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should merge scanvi embeddings with labels") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                    [id: 'scanvi'],
                    'scanvi',
                    file(params.pipelines_testdata_base_path + '/intermediates/merge_embeddings/integrated_scanvi.h5ad', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + '/intermediates/merge_embeddings/base_scanvi.h5ad', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + '/intermediates/merge_embeddings/combined_scanvi.h5ad', checkIfExists: true)
                ])
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            with(adata) {
                assert "X_emb" in obsm
                assert "label:scANVI" in obs.colnames
                assert obs.rownames.size() == 80
            }
            assert file(process.out.obsm[0]).name == "X_scanvi.parquet"
            assert file(process.out.obs[0]).name == "scanvi.parquet"
            def embedding = parquet(process.out.obsm[0])
            assert embedding.rowCount == adata.n_obs
            assert embedding.columnNames[0] == '__index__'
            assert embedding.columnNames.drop(1) == (0..<(embedding.columnNames.size() - 1)).collect { it.toString() }
            assert embedding.schema.fields[0].logicalType.type == 'STRING'
            assert embedding.schema.fields.drop(1).every { it.physicalType in ['FLOAT', 'DOUBLE'] }
            assert embedding.compressionCodecs == ['SNAPPY']
            assert embedding.rows.collect { it.__index__ } == adata.obs.index.values
            def labels = parquet(process.out.obs[0])
            assert labels.columnNames == ['__index__', 'label:scANVI']
            assert labels.rowCount == adata.n_obs
            assert labels.schema.fields[0].logicalType.type == 'STRING'
            assert labels.compressionCodecs == ['SNAPPY']
            assert labels.rows.collect { it.__index__ } == adata.obs.index.values
            assert labels.rows.collect { it['label:scANVI'] } == adata.obs.get('label:scANVI').data
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                    [id: 'scvi'],
                    'scvi',
                    file(params.pipelines_testdata_base_path + '/intermediates/merge_embeddings/integrated_scvi.h5ad', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + '/intermediates/merge_embeddings/base_scvi.h5ad', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + '/intermediates/merge_embeddings/combined_scvi.h5ad', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assert file(process.out.obsm[0]).name == 'X_scvi.parquet'
            assert file(process.out.obs[0]).name == 'scvi.parquet'
            assert snapshot(process.out).match()
        }

    }

}
