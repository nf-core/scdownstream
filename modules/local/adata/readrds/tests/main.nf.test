        }

    }

    test("Should read SCE file - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [id: 'test'],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679757_filtered_matrix.sce.rds', checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            assert process.success

            assert snapshot(process.out).match()
        }

    }

}
