nextflow_process {

    name "Test Process ADATA_EXTEND"
    script "modules/local/adata/extend/main.nf"
    process "ADATA_EXTEND"

    tag "modules"
    tag "modules_local"

    test("Should merge compatible obs and var updates without losing base rows") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                def fixtures = params.pipelines_testdata_base_path + '/intermediates/fragments/regressions/'
                input[0] = [
                    [id: 'compatible'],
                    file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                    ['a_obs', 'b_obs'].collect { file(fixtures + it + '.parquet', checkIfExists: true) },
                    ['a_var', 'b_var'].collect { file(fixtures + it + '.parquet', checkIfExists: true) },
                    [], [], [], []
                ]
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            assert adata.n_obs == 16
            assert adata.n_vars == 32
            assert adata.obs.colnames.toList().unique().size() == adata.obs.colnames.size()
            assert adata.var.colnames.toList().unique().size() == adata.var.colnames.size()
            assert adata.obs.index.values.take(3) == ['SRR28679756::CCTTTCTTCTGCTGCT', 'SRR28679756::ATCATCTTCTGCTGTC', 'SRR28679756::ATTTCTGGTGGTTTCA']
            assert adata.var.index.values.take(3) == ['FAM177A1P1', 'POMP', 'DLG2']
            assert adata.obs.get('label').data.take(3) == ['T_cell', 'B_cell', 'TypeA']
            assert adata.obs.get('n_counts').data[0] == 100.0
            assert adata.obs.get('original_total_counts').data.take(3) == [1055, 651, 643]
            assert adata.obs.get('score').data.take(2) == [1.0, 2.0]
            assert adata.obs.get('flag').data.take(2).collect { it.toString().toLowerCase() } == ['true', 'false']
            assert adata.obs.get('version.1').data.take(2) == ['first', 'second']
            assert adata.var.get('selected').data.take(2).collect { it.toString().toLowerCase() } == ['true', 'false']
            assert adata.var.get('score').data.take(2) == [1.0, 2.5]
            assert adata.obs.get('score').data[0] instanceof Number
            assert adata.var.get('score').data[0] instanceof Number
            assert snapshot(path(process.out.versions[0]).yaml, adata.yaml).match()
        }

    }

    test("Should reject conflicting obs fragments and identify both sources") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                def fixtures = params.pipelines_testdata_base_path + '/intermediates/fragments/regressions/'
                input[0] = [
                    [id: 'conflict'],
                    file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                    ['a_conflict', 'b_conflict'].collect { file(fixtures + it + '.parquet', checkIfExists: true) },
                    [], [], [], [], []
                ]
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains("ValueError: Conflicting non-null values in column 'label'")
            assert process.errorReport.contains('a_conflict.parquet')
            assert process.errorReport.contains('b_conflict.parquet')
        }

    }

    test("Should reject conflicting var fragments") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                def fixtures = params.pipelines_testdata_base_path + '/intermediates/fragments/regressions/'
                input[0] = [
                    [id: 'conflict'],
                    file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                    [], ['a_score', 'b_score'].collect { file(fixtures + it + '.parquet', checkIfExists: true) },
                    [], [], [], []
                ]
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains("ValueError: Conflicting non-null values in column 'score'")
            assert process.errorReport.contains('a_score.parquet')
            assert process.errorReport.contains('b_score.parquet')
        }

    }

    test("Should reject duplicate fragment indices") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = [
                    [id: 'duplicate'],
                    file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                    [file(params.pipelines_testdata_base_path + '/intermediates/fragments/regressions/duplicate_index.parquet', checkIfExists: true)],
                    [], [], [], [], []
                ]
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains("ValueError: Fragment 'duplicate_index.parquet' requires unique, non-null string indices")
        }

    }

    test("Should reject legacy CSV table fragments") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = channel.of('cell,label,label\\nSRR28679756::CCTTTCTTCTGCTGCT,T_cell,B_cell\\n')
                    .collectFile(name: 'duplicate_columns.csv')
                    .map { obs -> [
                        [id: 'duplicate'],
                        file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                        [obs], [], [], [], [], []
                    ] }
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains('ValueError: Unsupported file extension: obs/duplicate_columns.csv')
        }

    }

    test("Should reject Parquet fragments without an explicit index") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = [
                    [id: 'missing_index'],
                    file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                    [file(params.pipelines_testdata_base_path + '/intermediates/fragments/regressions/missing_index.parquet', checkIfExists: true)],
                    [], [], [], [], []
                ]
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("Fragment 'missing_index.parquet' is missing the '__index__' column")
        }
    }

    test("Should reject null fragment identifiers") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = [
                    [id: 'null_index'],
                    file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                    [file(params.pipelines_testdata_base_path + '/intermediates/fragments/regressions/null_index.parquet', checkIfExists: true)],
                    [], [], [], [], []
                ]
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("Fragment 'null_index.parquet' requires unique, non-null string indices")
        }
    }

    test("Should reject legacy pickled embedding tables") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = [
                    [id: 'legacy'],
                    file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                    [], [], [file(params.pipelines_testdata_base_path + '/intermediates/fragments/X_scvi.pkl', checkIfExists: true)],
                    [], [], []
                ]
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('ValueError: Unsupported file extension: obsm/X_scvi.pkl')
        }
    }

    test("Should reject pickled DataFrames in uns") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = [
                    [id: 'legacy_uns'],
                    file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                    [], [], [], [],
                    [file(params.pipelines_testdata_base_path + '/intermediates/fragments/X_scvi.pkl', checkIfExists: true)], []
                ]
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("Tabular uns fragment 'X_scvi.pkl' must use Parquet")
        }
    }

    test("Should extend with obs data") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [id: 'test'],
                        file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                         [file(params.pipelines_testdata_base_path + '/intermediates/fragments/scvi-global-1.0_leiden.parquet', checkIfExists: true)],
                        [],
                        [],
                        [],
                        [],
                        []
                    ]
                )
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            with(adata) {
                assert "scvi-global-1.0_leiden" in obs.colnames
            }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should extend with obsm data") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [id: 'test'],
                        file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                        [],
                        [],
                         [file(params.pipelines_testdata_base_path + '/intermediates/fragments/X_scvi.parquet', checkIfExists: true)],
                        [],
                        [],
                        []
                    ]
                )
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            with(adata) {
                assert "X_scvi" in obsm
            }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should extend with multiple obs and obsm data") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [id: 'test'],
                        file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                        [
                             file(params.pipelines_testdata_base_path + '/intermediates/fragments/scvi-global-1.0_leiden.parquet', checkIfExists: true),
                             file(params.pipelines_testdata_base_path + '/intermediates/fragments/scvi-global-1.0_entropy.parquet', checkIfExists: true)
                        ],
                        [],
                        [
                             file(params.pipelines_testdata_base_path + '/intermediates/fragments/X_scvi.parquet', checkIfExists: true),
                             file(params.pipelines_testdata_base_path + '/intermediates/fragments/X_scvi-global_umap.parquet', checkIfExists: true)
                        ],
                        [],
                        [],
                        []
                    ]
                )
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            with(adata) {
                assert "scvi-global-1.0_leiden" in obs.colnames
                assert "scvi-global-1.0:entropy" in obs.colnames
                assert "X_scvi" in obsm
                assert "X_scvi-global_umap" in obsm
            }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should extend with uns data") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [id: 'test'],
                        file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                        [],
                        [],
                        [],
                        [],
                        [file(params.pipelines_testdata_base_path + '/intermediates/fragments/scvi-global-1.0_paga.pkl', checkIfExists: true)],
                        []
                    ]
                )
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            with(adata) {
                assert "scvi-global-1.0_paga" in uns
            }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should extend with a tabular uns fragment") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = [
                    [id: 'tabular_uns'],
                    file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                    [], [], [], [],
                    [file(params.pipelines_testdata_base_path + '/intermediates/fragments/regressions/uns_table.parquet', checkIfExists: true)], []
                ]
                """
            }
        }
        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            assert 'uns_table' in adata.uns
            assert !('__index__' in adata.obs.colnames)
            assert !('__index__' in adata.var.colnames)
        }
    }

    test("Should run with no extensions") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [id: 'test'],
                        file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                        [],
                        [],
                        [],
                        [],
                        [],
                        []
                    ]
                )
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [id: 'test'],
                        file(params.pipelines_testdata_base_path + '/intermediates/fragments/merged_outer.h5ad', checkIfExists: true),
                        [],
                        [],
                        [],
                        [],
                        [],
                        []
                    ]
                )
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
