import java.nio.file.Path
import nictru.nf.anndata.DataFrame
import nictru.nf.anndata.store.AnnDataStore

nextflow_process {

    name "Test Process ADATA_MERGE"
    script "modules/local/adata/merge/main.nf"
    process "ADATA_MERGE"

    tag "modules"
    tag "modules_local"

    setup {
        run("AMBIENT_CORRECTION") {
            script "subworkflows/local/ambient_correction/main.nf"
            workflow {
                """
                input[0] = channel.of([
                    [id: 'SRR28679756'],
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                    []
                ])
                input[1] = 'decontx'
                input[2] = false
                input[3] = null
                """
            }
        }
        run("ADATA_UNIFY") {
            script "modules/local/adata/unify/main.nf"
            process {
                """
                input[0] = AMBIENT_CORRECTION.out.h5ad.mix(channel.of([
                        [id: 'SRR28679759'],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]))
                input[1] = 'sample'
                input[2] = ''
                input[3] = ''
                input[4] = 'unknown'
                input[5] = 'index'
                input[6] = 'X'
                input[7] = 'make_unique'
                input[8] = false
                input[9] = ""
                """
            }
        }
        run("ADATA_MERGE", alias: "MERGE_REFERENCE") {
            script "modules/local/adata/merge/main.nf"
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.filter { meta, _h5ad -> meta.id == 'SRR28679759' }
                input[1] = [[], []]
                input[2] = ''
                """
            }
        }
        run("SCANPY_LOG1PNORM") {
            script "modules/local/scanpy/log1pnorm/main.nf"
            process {
                """
                input[0] = MERGE_REFERENCE.out.outer
                """
            }
        }
    }

    test("Should run without base") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.map{ _meta, h5ad -> [[id: 'combined'], h5ad] }.groupTuple().map{ meta, h5ads -> [meta, h5ads.sort{ a, b -> a.name <=> b.name }] }
                input[1] = [[], []]
                input[2] = ''
                """
            }
        }

        then {
            def adata_outer = anndata(process.out.outer[0][1])
            def adata_integrate = anndata(process.out.integrate[0][1])
            assert process.success
            with(adata_outer) {
                assert "intersection" in var.colnames
                assert var.get("intersection").any()
            }
            assert adata_integrate.n_obs == adata_outer.n_obs
            assert adata_integrate.n_vars == adata_outer.n_vars
            // nft-anndata exposes HDF5 Boolean enum values as uppercase strings.
            assert adata_outer.obs.get('is_selected_filtered_cell').data.every { it == 'TRUE' }
            assert adata_integrate.obs.get('is_selected_filtered_cell').data.every { it == 'TRUE' }
            assert 'raw_counts' in adata_outer.layers
            assert 'ambient_corrected_decontx' in adata_outer.layers
            assert adata_outer.obs.get('ambient_correction_method').unique() == ['decontx', 'none'].toSet()
            assert adata_outer.obs.get('analysis_counts_source').unique() == ['raw_counts'].toSet()
            def samples = adata_outer.obs.get('sample').data
            def methods = adata_outer.obs.get('ambient_correction_method').data
            assert (0..<adata_outer.n_obs).every { i -> methods[i] == (samples[i] == 'SRR28679756' ? 'decontx' : 'none') }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata_outer.yaml,
                adata_integrate.yaml
            ).match()
        }

    }

    test("Should run without base - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.map{ _meta, h5ad -> [[id: 'combined'], h5ad] }.groupTuple().map{ meta, h5ads -> [meta, h5ads.sort{ it.name }] }
                input[1] = [[], []]
                input[2] = ''
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run with base") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.filter { meta, _h5ad -> meta.id == 'SRR28679756' }
                input[1] = MERGE_REFERENCE.out.outer
                input[2] = ''
                """
            }
        }

        then {
            def adata_outer = anndata(process.out.outer[0][1])
            def adata_integrate = anndata(process.out.integrate[0][1])
            assert process.success
            with(adata_outer) {
                assert "intersection" in var.colnames
            }
            assert adata_integrate.n_vars == adata_outer.n_vars
            assert adata_integrate.n_obs < adata_outer.n_obs
            assert adata_outer.obs.get('is_selected_filtered_cell').data.every { it == 'TRUE' }
            assert adata_integrate.obs.get('is_selected_filtered_cell').data.every { it == 'TRUE' }
            with(adata_integrate) {
                assert "label" in obs.colnames
                assert obs.get("label").unique().every { it == "Unknown" }
            }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata_outer.yaml,
                adata_integrate.yaml
            ).match()
        }

    }

    test("Should retain per-sample gene presence when extending a merged base") {
        tag "gene_presence"

        setup {
            run("SCANPY_FILTER", alias: "FILTER_BASE_SAMPLE") {
                script "modules/local/scanpy/filter/main.nf"
                process {
                    """
                    input[0] = ADATA_UNIFY.out.h5ad
                        .filter { meta, _h5ad -> meta.id == 'SRR28679756' }
                        .map { meta, h5ad -> [meta + [id: 'filtered_base_sample'], h5ad] }
                    input[1] = 'index'
                    input[2] = ''
                    input[3] = 20
                    input[4] = ''
                    input[5] = ''
                    input[6] = 100
                    input[7] = 0
                    input[8] = 100
                    input[9] = 0
                    input[10] = 0
                    input[11] = 0
                    input[12] = 0
                    input[13] = []
                    input[14] = false
                    """
                }
            }
            run("ADATA_MERGE", alias: "MERGE_BASE") {
                script "modules/local/adata/merge/main.nf"
                process {
                    """
                    input[0] = ADATA_UNIFY.out.h5ad.filter { meta, _h5ad -> meta.id == 'SRR28679759' }
                        .mix(FILTER_BASE_SAMPLE.out.h5ad)
                        .map { _meta, h5ad -> [[id: 'base'], h5ad] }
                        .groupTuple()
                        .map { meta, h5ads -> [meta, h5ads.sort { it.name }] }
                    input[1] = [[], []]
                    input[2] = ''
                    """
                }
            }
            run("ADATA_UNIFY", alias: "UNIFY_QUERY") {
                script "modules/local/adata/unify/main.nf"
                process {
                    """
                    input[0] = [[id: 'query'], file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)]
                    input[1] = 'sample'
                    input[2] = ''
                    input[3] = ''
                    input[4] = 'unknown'
                    input[5] = 'index'
                    input[6] = 'X'
                    input[7] = 'make_unique'
                    input[8] = false
                    input[9] = ''
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = UNIFY_QUERY.out.h5ad
                input[1] = MERGE_BASE.out.outer
                input[2] = ''
                """
            }
        }

        then {
            assert process.success
            def outer = anndata(process.out.outer[0][1])
            def integrate = anndata(process.out.integrate[0][1])
            def shared = outer.var.get('intersection').data.toList()
            def states = shared.toSet()
            assert states == ['TRUE', 'FALSE'].toSet()
            assert integrate.var.get('intersection').data.toList() == shared
            assert integrate.var.rownames.toList() == outer.var.rownames.toList()
            assert integrate.obs.get('sample').unique() == ['query'].toSet()
            [process.out.outer[0][1], process.out.integrate[0][1]].each { h5ad ->
                AnnDataStore.open(Path.of(h5ad.toString())).withCloseable { store ->
                    def presence = new DataFrame(store.getGroup('varm').getChild('gene_presence').asGroup())
                    assert presence.rownames.toList() == outer.var.rownames.toList()
                    assert presence.colnames.toList().toSet() == ['SRR28679756', 'SRR28679759', 'query'].toSet()
                    assert presence.get('SRR28679756').data.toList() == shared
                    assert presence.get('SRR28679759').data.every { it == 'TRUE' }
                    assert presence.get('query').data.every { it == 'TRUE' }
                }
            }
        }
    }

    test("Should merge a layered reference with a layerless query") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.filter { meta, _h5ad -> meta.id == 'SRR28679756' }
                input[1] = SCANPY_LOG1PNORM.out.h5ad
                input[2] = ''
                """
            }
        }

        then {
            assert process.success
            def outer = anndata(process.out.outer[0][1])
            def query = anndata(process.out.integrate[0][1])
            assert query.n_obs > 0
            assert query.n_obs < outer.n_obs
            assert query.obs.get('sample').unique() == ['SRR28679756'].toSet()
            assert !('counts' in outer.layers)
            assert !('counts' in query.layers)
            assert 'raw_counts' in outer.layers
            assert 'raw_counts' in query.layers
            assert 'ambient_corrected_decontx' in outer.layers
            assert 'ambient_corrected_decontx' in query.layers
            assert query.obs.get('ambient_correction_method').unique() == ['decontx'].toSet()
        }
    }

    test("Should run with base - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.filter { meta, _h5ad -> meta.id == 'SRR28679756' }
                input[1] = MERGE_REFERENCE.out.outer
                input[2] = ''
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should reject an input without raw count provenance") {
        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                    [id: 'legacy'],
                    [file(params.pipelines_testdata_base_path + '/pbmc/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)]
                ])
                input[1] = [[], []]
                input[2] = ''
                """
            }
        }
        then {
            assert !process.success
            assert process.errorReport.contains("has no raw_counts layer.")
        }
    }
}
