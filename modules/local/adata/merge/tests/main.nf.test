nextflow_process {

    name "Test Process ADATA_MERGE"
    script "modules/local/adata/merge/main.nf"
    process "ADATA_MERGE"

    tag "modules"
    tag "modules_local"

    setup {
        run("ADATA_UNIFY") {
            script "modules/local/adata/unify/main.nf"
            process {
                """
                input[0] = channel.of([
                        [id: 'SRR28679756'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ], [
                        [id: 'SRR28679759'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'sample'
                input[2] = ''
                input[3] = ''
                input[4] = 'unknown'
                input[5] = 'index'
                input[6] = 'X'
                input[7] = 'make_unique'
                input[8] = false
                input[9] = ""
                input[10] = 'h5ad'
                """
            }
        }
    }

    test("Should run without base") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_UNIFY.out.anndata.map{ _meta, h5ad -> [[id: 'combined'], h5ad] }.groupTuple().map{ meta, h5ads -> [meta, h5ads.sort{ a, b -> a.name <=> b.name }] }
                input[1] = [[], []]
                input[2] = ''
                input[3] = 'h5ad'
                """
            }
        }

        then {
            def adata_outer = anndata(process.out.outer[0][1])
            def adata_integrate = anndata(process.out.integrate[0][1])
            assert process.success
            with(adata_outer) {
                assert "intersection" in var.colnames
                assert var.get("intersection").any()
            }
            assert adata_integrate.n_obs == adata_outer.n_obs
            assert adata_integrate.n_vars == adata_outer.n_vars
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata_outer.yaml,
                adata_integrate.yaml
            ).match()
        }

    }

    test("Should run without base - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_UNIFY.out.anndata.map{ _meta, h5ad -> [[id: 'combined'], h5ad] }.groupTuple().map{ meta, h5ads -> [meta, h5ads.sort{ it.name }] }
                input[1] = [[], []]
                input[2] = ''
                input[3] = 'h5ad'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should fail without an output format") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_UNIFY.out.anndata.map{ _meta, h5ad -> [[id: 'combined'], h5ad] }.groupTuple().map{ meta, h5ads -> [meta, h5ads.sort{ it.name }] }
                input[1] = [[], []]
                input[2] = ''
                input[3] = ''
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains("ADATA_MERGE only outputs the AnnData object; anndata_format must not be empty")
        }

    }

    test("Should run with base") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                ch_h5ad = ADATA_UNIFY.out.anndata.branch{ meta, h5ad ->
                    sample1: meta.id == 'SRR28679756'
                    sample2: meta.id == 'SRR28679759'
                }
                input[0] = ch_h5ad.sample1
                input[1] = ch_h5ad.sample2
                input[2] = ''
                input[3] = 'h5ad'
                """
            }
        }

        then {
            def adata_outer = anndata(process.out.outer[0][1])
            def adata_integrate = anndata(process.out.integrate[0][1])
            assert process.success
            with(adata_outer) {
                assert "intersection" in var.colnames
            }
            assert adata_integrate.n_vars == adata_outer.n_vars
            assert adata_integrate.n_obs < adata_outer.n_obs
            with(adata_integrate) {
                assert "label" in obs.colnames
                assert obs.get("label").unique().every { it == "Unknown" }
            }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata_outer.yaml,
                adata_integrate.yaml
            ).match()
        }

    }

    test("Should run with base - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                ch_h5ad = ADATA_UNIFY.out.anndata.branch{ meta, h5ad ->
                    sample1: meta.id == 'SRR28679756'
                    sample2: meta.id == 'SRR28679759'
                }
                input[0] = ch_h5ad.sample1
                input[1] = ch_h5ad.sample2
                input[2] = ''
                input[3] = 'h5ad'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should read and write zarr without base") {

        setup {
            run("ADATA_UNIFY", alias: "UNIFY_ZARR") {
                script "modules/local/adata/unify/main.nf"
                process {
                    """
                    input[0] = channel.of([
                            [id: 'SRR28679756'],
                            file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                        ], [
                            [id: 'SRR28679759'],
                            file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                        ]
                    )
                    input[1] = 'sample'
                    input[2] = ''
                    input[3] = ''
                    input[4] = 'unknown'
                    input[5] = 'index'
                    input[6] = 'X'
                    input[7] = 'make_unique'
                    input[8] = false
                    input[9] = ""
                    input[10] = 'zarr'
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = UNIFY_ZARR.out.anndata.map{ _meta, zarr -> [[id: 'combined'], zarr] }.groupTuple().map{ meta, zarrs -> [meta, zarrs.sort{ a, b -> a.name <=> b.name }] }
                input[1] = [[], []]
                input[2] = ''
                input[3] = 'zarr'
                """
            }
        }

        then {
            assert process.success
            def outer_path = process.out.outer[0][1]
            def integrate_path = process.out.integrate[0][1]
            assert outer_path.endsWith('combined_outer.zarr')
            assert integrate_path.endsWith('combined_integrate.zarr')
            assert new File(outer_path, 'zarr.json').isFile()
            assert new File(integrate_path, 'zarr.json').isFile()
            def adata_outer = anndata(outer_path)
            def adata_integrate = anndata(integrate_path)
            with(adata_outer) {
                assert "intersection" in var.colnames
            }
            assert adata_integrate.n_obs == adata_outer.n_obs
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata_outer.yaml,
                adata_integrate.yaml
            ).match()
        }

    }

    test("Should read and write zarr with base") {

        setup {
            run("ADATA_UNIFY", alias: "UNIFY_ZARR") {
                script "modules/local/adata/unify/main.nf"
                process {
                    """
                    input[0] = channel.of([
                            [id: 'SRR28679756'],
                            file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                        ], [
                            [id: 'SRR28679759'],
                            file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                        ]
                    )
                    input[1] = 'sample'
                    input[2] = ''
                    input[3] = ''
                    input[4] = 'unknown'
                    input[5] = 'index'
                    input[6] = 'X'
                    input[7] = 'make_unique'
                    input[8] = false
                    input[9] = ""
                    input[10] = 'zarr'
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                ch_zarr = UNIFY_ZARR.out.anndata.branch{ meta, _zarr ->
                    sample1: meta.id == 'SRR28679756'
                    sample2: meta.id == 'SRR28679759'
                }
                input[0] = ch_zarr.sample1
                input[1] = ch_zarr.sample2
                input[2] = ''
                input[3] = 'zarr'
                """
            }
        }

        then {
            assert process.success
            def outer_path = process.out.outer[0][1]
            def integrate_path = process.out.integrate[0][1]
            assert outer_path.endsWith('SRR28679756_outer.zarr')
            assert integrate_path.endsWith('SRR28679756_integrate.zarr')
            assert new File(integrate_path, 'zarr.json').isFile()
            def adata_outer = anndata(outer_path)
            def adata_integrate = anndata(integrate_path)
            assert adata_integrate.n_obs < adata_outer.n_obs
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata_outer.yaml,
                adata_integrate.yaml
            ).match()
        }

    }

}
