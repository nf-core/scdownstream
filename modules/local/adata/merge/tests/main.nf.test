nextflow_process {

    name "Test Process ADATA_MERGE"
    script "modules/local/adata/merge/main.nf"
    process "ADATA_MERGE"

    tag "modules"
    tag "modules_local"

    setup {
        run("ADATA_UNIFY") {
            script "modules/local/adata/unify/main.nf"
            process {
                """
                input[0] = channel.of([
                        [id: 'SRR28679756'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ], [
                        [id: 'SRR28679759'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'sample'
                input[2] = ''
                input[3] = ''
                input[4] = 'unknown'
                input[5] = 'index'
                input[6] = 'X'
                input[7] = 'make_unique'
                input[8] = false
                input[9] = ""
                """
            }
        }
        run("SCANPY_LOG1PNORM") {
            script "modules/local/scanpy/log1pnorm/main.nf"
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.filter { meta, _h5ad -> meta.id == 'SRR28679759' }
                """
            }
        }
    }

    test("Should run without base") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.map{ _meta, h5ad -> [[id: 'combined'], h5ad] }.groupTuple().map{ meta, h5ads -> [meta, h5ads.sort{ a, b -> a.name <=> b.name }] }
                input[1] = [[], []]
                input[2] = ''
                """
            }
        }

        then {
            def adata_outer = anndata(process.out.outer[0][1])
            def adata_integrate = anndata(process.out.integrate[0][1])
            assert process.success
            with(adata_outer) {
                assert "intersection" in var.colnames
                assert var.get("intersection").any()
            }
            assert adata_integrate.n_obs == adata_outer.n_obs
            assert adata_integrate.n_vars == adata_outer.n_vars
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata_outer.yaml,
                adata_integrate.yaml
            ).match()
        }

    }

    test("Should run without base - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.map{ _meta, h5ad -> [[id: 'combined'], h5ad] }.groupTuple().map{ meta, h5ads -> [meta, h5ads.sort{ it.name }] }
                input[1] = [[], []]
                input[2] = ''
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run with base") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                ch_h5ad = ADATA_UNIFY.out.h5ad.branch{ meta, h5ad ->
                    sample1: meta.id == 'SRR28679756'
                    sample2: meta.id == 'SRR28679759'
                }
                input[0] = ch_h5ad.sample1
                input[1] = ch_h5ad.sample2
                input[2] = ''
                """
            }
        }

        then {
            def adata_outer = anndata(process.out.outer[0][1])
            def adata_integrate = anndata(process.out.integrate[0][1])
            assert process.success
            with(adata_outer) {
                assert "intersection" in var.colnames
            }
            assert adata_integrate.n_vars == adata_outer.n_vars
            assert adata_integrate.n_obs < adata_outer.n_obs
            with(adata_integrate) {
                assert "label" in obs.colnames
                assert obs.get("label").unique().every { it == "Unknown" }
            }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata_outer.yaml,
                adata_integrate.yaml
            ).match()
        }

    }

    test("Should preserve counts when merging a layered reference and a layerless query") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.filter { meta, _h5ad -> meta.id == 'SRR28679756' }
                input[1] = SCANPY_LOG1PNORM.out.h5ad
                input[2] = ''
                """
            }
        }

        then {
            assert process.success
            def outer = anndata(process.out.outer[0][1])
            def query = anndata(process.out.integrate[0][1])
            assert query.n_obs > 0
            assert query.n_obs < outer.n_obs
            assert query.obs.get('sample').unique() == ['SRR28679756'].toSet()
            for (output in [process.out.outer[0][1], process.out.integrate[0][1]]) {
                assert 'counts' in anndata(output).layers
                nictru.nf.anndata.store.AnnDataStore.open(java.nio.file.Path.of(output.toString())).withCloseable { store ->
                    def x = store.getGroup('X')
                    def counts = store.getGroup('layers').getChild('counts').asGroup()
                    assert x.getChild('data').asArray().readData().length > 0
                    for (field in ['data', 'indices', 'indptr']) {
                        assert java.util.Arrays.equals(
                            x.getChild(field).asArray().readData(),
                            counts.getChild(field).asArray().readData(),
                        )
                    }
                }
            }
        }
    }

    test("Should run with base - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                ch_h5ad = ADATA_UNIFY.out.h5ad.branch{ meta, h5ad ->
                    sample1: meta.id == 'SRR28679756'
                    sample2: meta.id == 'SRR28679759'
                }
                input[0] = ch_h5ad.sample1
                input[1] = ch_h5ad.sample2
                input[2] = ''
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }
}
