nextflow_process {

    name "Test Process ADATA_MERGE"
    script "modules/local/adata/merge/main.nf"
    process "ADATA_MERGE"

    tag "modules"
    tag "modules_local"

    setup {
        run("AMBIENT_CORRECTION") {
            script "subworkflows/local/ambient_correction/main.nf"
            workflow {
                """
                input[0] = channel.of([
                    [id: 'SRR28679756'],
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                    []
                ])
                input[1] = 'decontx'
                input[2] = false
                input[3] = null
                """
            }
        }
        run("ADATA_UNIFY") {
            script "modules/local/adata/unify/main.nf"
            process {
                """
                input[0] = AMBIENT_CORRECTION.out.h5ad.mix(channel.of([
                        [id: 'SRR28679759'],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]))
                input[1] = 'sample'
                input[2] = ''
                input[3] = ''
                input[4] = 'unknown'
                input[5] = 'index'
                input[6] = 'X'
                input[7] = 'make_unique'
                input[8] = false
                input[9] = ""
                """
            }
        }
        run("SCANPY_LOG1PNORM") {
            script "modules/local/scanpy/log1pnorm/main.nf"
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.filter { meta, _h5ad -> meta.id == 'SRR28679759' }
                """
            }
        }
    }

    test("Should run without base") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.map{ _meta, h5ad -> [[id: 'combined'], h5ad] }.groupTuple().map{ meta, h5ads -> [meta, h5ads.sort{ a, b -> a.name <=> b.name }] }
                input[1] = [[], []]
                input[2] = ''
                """
            }
        }

        then {
            def adata_outer = anndata(process.out.outer[0][1])
            def adata_integrate = anndata(process.out.integrate[0][1])
            assert process.success
            with(adata_outer) {
                assert "intersection" in var.colnames
                assert var.get("intersection").any()
            }
            assert adata_integrate.n_obs == adata_outer.n_obs
            assert adata_integrate.n_vars == adata_outer.n_vars
            assert 'raw_counts' in adata_outer.layers
            assert 'ambient_corrected_decontx' in adata_outer.layers
            assert adata_outer.obs.get('ambient_correction_method').unique() == ['decontx', 'none'].toSet()
            assert adata_outer.obs.get('analysis_counts_source').unique() == ['raw_counts'].toSet()
            def samples = adata_outer.obs.get('sample').data
            def methods = adata_outer.obs.get('ambient_correction_method').data
            assert (0..<adata_outer.n_obs).every { i -> methods[i] == (samples[i] == 'SRR28679756' ? 'decontx' : 'none') }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata_outer.yaml,
                adata_integrate.yaml
            ).match()
        }

    }

    test("Should run without base - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.map{ _meta, h5ad -> [[id: 'combined'], h5ad] }.groupTuple().map{ meta, h5ads -> [meta, h5ads.sort{ it.name }] }
                input[1] = [[], []]
                input[2] = ''
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run with base") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                ch_h5ad = ADATA_UNIFY.out.h5ad.branch{ meta, h5ad ->
                    sample1: meta.id == 'SRR28679756'
                    sample2: meta.id == 'SRR28679759'
                }
                input[0] = ch_h5ad.sample1
                input[1] = ch_h5ad.sample2
                input[2] = ''
                """
            }
        }

        then {
            def adata_outer = anndata(process.out.outer[0][1])
            def adata_integrate = anndata(process.out.integrate[0][1])
            assert process.success
            with(adata_outer) {
                assert "intersection" in var.colnames
            }
            assert adata_integrate.n_vars == adata_outer.n_vars
            assert adata_integrate.n_obs < adata_outer.n_obs
            with(adata_integrate) {
                assert "label" in obs.colnames
                assert obs.get("label").unique().every { it == "Unknown" }
            }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata_outer.yaml,
                adata_integrate.yaml
            ).match()
        }

    }

    test("Should merge a layered reference with a layerless query") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.filter { meta, _h5ad -> meta.id == 'SRR28679756' }
                input[1] = SCANPY_LOG1PNORM.out.h5ad
                input[2] = ''
                """
            }
        }

        then {
            assert process.success
            def outer = anndata(process.out.outer[0][1])
            def query = anndata(process.out.integrate[0][1])
            assert query.n_obs > 0
            assert query.n_obs < outer.n_obs
            assert query.obs.get('sample').unique() == ['SRR28679756'].toSet()
            assert !('counts' in outer.layers)
            assert !('counts' in query.layers)
            assert 'raw_counts' in outer.layers
            assert 'raw_counts' in query.layers
            assert 'ambient_corrected_decontx' in outer.layers
            assert 'ambient_corrected_decontx' in query.layers
            assert query.obs.get('ambient_correction_method').unique() == ['decontx'].toSet()
        }
    }

    test("Should run with base - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                ch_h5ad = ADATA_UNIFY.out.h5ad.branch{ meta, h5ad ->
                    sample1: meta.id == 'SRR28679756'
                    sample2: meta.id == 'SRR28679759'
                }
                input[0] = ch_h5ad.sample1
                input[1] = ch_h5ad.sample2
                input[2] = ''
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should reject an input without raw count provenance") {
        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                    [id: 'legacy'],
                    [file(params.pipelines_testdata_base_path + '/pbmc/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)]
                ])
                input[1] = [[], []]
                input[2] = ''
                """
            }
        }
        then {
            assert !process.success
            assert process.trace.failed().size() == 1
        }
    }
}
