nextflow_process {

    name "Test Process ADATA_PREPCELLXGENE"
    script "modules/local/adata/prepcellxgene/main.nf"
    process "ADATA_PREPCELLXGENE"

    tag "modules"
    tag "modules_local"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [id: 'test'],
                        file(params.pipelines_testdata_base_path + '/extension_base/merged.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = true
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should export already logged expression without another log1p") {

        setup {
            run("ADATA_PREPCELLXGENE", alias: "LOGGED") {
                script "../main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id: 'logged_input'],
                        file(params.pipelines_testdata_base_path + '/extension_base/merged.h5ad', checkIfExists: true)
                    ])
                    input[1] = true
                    """
                }
            }
        }

        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = LOGGED.out.h5ad.map { meta, h5ad -> [meta + [id: 'logged_output'], h5ad] }
                input[1] = false
                """
            }
        }

        then {
            assert process.success
            assert process.out.h5ad.size() == 1
            assert !anndata(process.out.h5ad[0][1]).uns.contains('log1p')
        }
    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [id: 'test'],
                        file(params.pipelines_testdata_base_path + '/extension_base/merged.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = true
                """
            }
        }

        then {
            assert process.success

            assert snapshot(process.out).match()
        }

    }

}
