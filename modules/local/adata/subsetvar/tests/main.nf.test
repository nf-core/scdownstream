nextflow_process {

    name "Test Process ADATA_SUBSETVAR"
    script "modules/local/adata/subsetvar/main.nf"
    process "ADATA_SUBSETVAR"

    tag "modules"
    tag "modules_local"

    setup {
        run("ADATA_UNIFY") {
            script "modules/local/adata/unify/main.nf"
            process {
                """
                input[0] = channel.of([
                        [id: 'SRR28679756'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ], [
                        [id: 'SRR28679759'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'sample'
                input[2] = ''
                input[3] = ''
                input[4] = 'unknown'
                input[5] = 'index'
                input[6] = 'X'
                input[7] = 'make_unique'
                input[8] = false
                input[9] = ""
                """
            }
        }
        run("ADATA_MERGE") {
            script "modules/local/adata/merge/main.nf"
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad.map{ _meta, h5ad -> [[id: 'combined'], h5ad] }.groupTuple().map{ meta, h5ads -> [meta, h5ads.sort{ a, b -> a.name <=> b.name }] }
                input[1] = [[], []]
                """
            }
        }
        run("SCANPY_LOG1PNORM") {
            script "modules/local/scanpy/log1pnorm/main.nf"
            process {
                """
                input[0] = ADATA_MERGE.out.outer
                """
            }
        }
    }

    test("Should subset by intersection column") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_LOG1PNORM.out.h5ad
                input[1] = 'intersection'
                """
            }
        }

        then {
            def adata_out = anndata(process.out.h5ad[0][1])
            assert process.success
            assert adata_out.n_vars > 0
            assert "intersection" in adata_out.var.colnames
            assert "counts" in adata_out.layers
            assert "log1p" in adata_out.layers
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata_out.yaml
            ).match()
        }

    }

    test("Should fail when column is absent") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_LOG1PNORM.out.h5ad
                input[1] = 'missing_column'
                """
            }
        }

        then {
            assert process.failed
        }

    }

    test("Should fail when column is not boolean") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_MERGE.out.outer
                input[1] = 'sample'
                """
            }
        }

        then {
            assert process.failed
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_LOG1PNORM.out.h5ad
                input[1] = 'intersection'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }
}
