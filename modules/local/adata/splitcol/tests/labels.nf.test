nextflow_process {

    name "Test ADATA_SPLITCOL label validation"
    script "modules/local/adata/splitcol/main.nf"
    process "ADATA_SPLITCOL"

    tag "modules"
    tag "modules_local"

    setup {
        run("ADATA_EXTEND") {
            script "modules/local/adata/extend/main.nf"
            process {
                """
                rows = (0..<128).collect { i ->
                    def cell = String.format('cell_%03d', i)
                    def safe = ['A B', 'a_b', 'T:CD4+', 'B-cell.(naive)'][i % 4]
                    def collision = i == 0 ? 'safe' : (i % 2 ? 'A B' : 'A_B')
                    def unsafe = i == 0 ? 'safe' : 'bad/name'
                    def traversal = i == 0 ? 'safe' : '..'
                    def staged_input = i % 2 ? 'labels' : 'safe'
                    "\${cell},\${safe},\${collision},\${unsafe},\${traversal},\${staged_input}"
                }
                input[0] = channel.of('cell,safe,collision,path,traversal,staged_input\\n' + rows.join('\\n') + '\\n')
                    .collectFile(name: 'labels.csv')
                    .map { obs -> [
                        [id: 'labels'],
                        file(params.pipelines_testdata_base_path + '/anndata-variations/counts_in_X.h5ad', checkIfExists: true),
                        [obs], [], [], [], [], []
                    ] }
                """
            }
        }
    }

    test("Should preserve safe punctuation, case and space normalisation") {
        when {
            process {
                """
                input[0] = ADATA_EXTEND.out.h5ad
                input[1] = 'safe'
                """
            }
        }
        then {
            assert process.success
            def outputs = process.out.h5ad[0][1]
            assert outputs.collect { path(it).fileName.toString() }.sort() == ['A_B.h5ad', 'B-cell.(naive).h5ad', 'T:CD4+.h5ad', 'a_b.h5ad'].sort()
            def originalLabels = ['A_B.h5ad': 'A B', 'a_b.h5ad': 'a_b', 'T:CD4+.h5ad': 'T:CD4+', 'B-cell.(naive).h5ad': 'B-cell.(naive)']
            outputs.each { output ->
                def adata = anndata(output)
                assert adata.n_obs == 32
                assert adata.obs.get('safe').data.every { it == originalLabels[path(output).fileName.toString()] }
            }
        }
    }

    test("Should reject normalised collisions before writing any subsets") {
        tag "subset_collision"

        when {
            process {
                """
                input[0] = ADATA_EXTEND.out.h5ad
                input[1] = 'collision'
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('subset basename collision')
            assert process.errorReport.contains("['A B', 'A_B'] -> 'A_B'")
            def work = process.errorReport =~ /Work dir:\s+([^\n]+)/
            assert work.find()
            assert new File(work.group(1).trim()).listFiles().findAll {
                it.name.endsWith('.h5ad') && !java.nio.file.Files.isSymbolicLink(it.toPath())
            }.isEmpty()
        }
    }

    test("Should reject directory separators before writing any subsets") {
        when {
            process {
                """
                input[0] = ADATA_EXTEND.out.h5ad
                input[1] = 'path'
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("'bad/name' -> 'bad/name': unsafe subset basename")
            def work = process.errorReport =~ /Work dir:\s+([^\n]+)/
            assert work.find()
            assert new File(work.group(1).trim()).listFiles().findAll {
                it.name.endsWith('.h5ad') && !java.nio.file.Files.isSymbolicLink(it.toPath())
            }.isEmpty()
        }
    }

    test("Should reject a staged input destination before writing subsets or changing the source") {
        tag "subset_existing_destination"

        when {
            process {
                """
                input[0] = ADATA_EXTEND.out.h5ad
                input[1] = 'staged_input'
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("'labels' -> 'labels.h5ad': subset output path already exists")
            def work = process.errorReport =~ /Work dir:\s+([^\n]+)/
            assert work.find()
            def workdir = new File(work.group(1).trim())
            assert workdir.listFiles().findAll {
                it.name.endsWith('.h5ad') && !java.nio.file.Files.isSymbolicLink(it.toPath())
            }.isEmpty()
            def input = new File(workdir, 'labels.h5ad').toPath()
            assert java.nio.file.Files.isSymbolicLink(input)
            def source = anndata(input.toRealPath().toString())
            assert source.n_obs == 128
            assert source.n_vars == 128
            assert source.obs.index.values == (0..<128).collect { String.format('cell_%03d', it) }
            assert source.obs.get('staged_input').data == (0..<128).collect { it % 2 ? 'labels' : 'safe' }
        }
    }

    test("Should reject traversal basenames before writing any subsets") {
        when {
            process {
                """
                input[0] = ADATA_EXTEND.out.h5ad
                input[1] = 'traversal'
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("'..' -> '..': unsafe subset basename")
            def work = process.errorReport =~ /Work dir:\s+([^\n]+)/
            assert work.find()
            assert new File(work.group(1).trim()).listFiles().findAll {
                it.name.endsWith('.h5ad') && !java.nio.file.Files.isSymbolicLink(it.toPath())
            }.isEmpty()
        }
    }
}
