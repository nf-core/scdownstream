nextflow_process {

    name "Test Process ADATA_SPLITCOL"
    script "modules/local/adata/splitcol/main.nf"
    process "ADATA_SPLITCOL"

    tag "modules"
    tag "modules_local"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                ])
                input[1] = 'sample'
                input[2] = 'h5ad'
                """
            }
        }

        then {
            def adatas = process.out.anndata[0][1].collect { anndata(it) }
            assert process.success
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adatas.collect { it.yaml }
            ).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            process {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                ])
                input[1] = 'sample'
                input[2] = 'h5ad'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should fail without an output format") {

        when {
            process {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                ])
                input[1] = 'sample'
                input[2] = ''
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains("ADATA_SPLITCOL only outputs the AnnData object; anndata_format must not be empty")
        }

    }

    test("Should read and write zarr") {

        setup {
            run("ADATA_UNIFY") {
                script "modules/local/adata/unify/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id: 'SRR28679756'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ])
                    input[1] = 'sample'
                    input[2] = ''
                    input[3] = ''
                    input[4] = 'unknown'
                    input[5] = 'index'
                    input[6] = 'X'
                    input[7] = 'make_unique'
                    input[8] = false
                    input[9] = ""
                    input[10] = 'zarr'
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = ADATA_UNIFY.out.anndata
                input[1] = 'batch'
                input[2] = 'zarr'
                """
            }
        }

        then {
            assert process.success
            def zarr_path = process.out.anndata[0][1]
            assert zarr_path.endsWith('SRR28679756_SRR28679756.zarr')
            assert new File(zarr_path, 'zarr.json').isFile()
            def adata = anndata(zarr_path)
            assert "batch" in adata.obs.colnames
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

}
