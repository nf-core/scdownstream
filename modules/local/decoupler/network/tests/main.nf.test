nextflow_process {

    name "Test Process DECOUPLER_NETWORK"
    script "modules/local/decoupler/network/main.nf"
    process "DECOUPLER_NETWORK"

    tag "modules"
    tag "modules_local"

    def networkTsv = [
        'source\ttarget\tweight',
        'AP1\tCD69\t1\nAP1\tFOS\t1\nAP1\tJUNB\t1\nAP1\tHSPA8\t1\nAP1\tPDCD4\t-1\nAP1\tCDKN1B\t-1',
        'BCELL\tCD22\t1\nBCELL\tCD79A\t1\nBCELL\tCR2\t1\nBCELL\tFCER2\t1\nBCELL\tFCRL1\t1\nBCELL\tFCRL3\t1\nBCELL\tIGHM\t1\nBCELL\tTNFRSF13C\t1',
        'IFN\tDDX60\t1\nIFN\tIFNGR2\t1\nIFN\tSP100\t1\nIFN\tSP140\t1\nIFN\tSTAT1\t1\nIFN\tZC3HAV1\t1',
        'MHC\tB2M\t1\nMHC\tCD74\t1\nMHC\tHLA-A\t1\nMHC\tHLA-B\t1\nMHC\tHLA-C\t1\nMHC\tHLA-DPA1\t1\nMHC\tHLA-DPB1\t1\nMHC\tHLA-DRA\t1\nMHC\tHLA-DRB1\t1\nMHC\tHLA-E\t1',
        'RIBO\tRPL11\t1\nRIBO\tRPL4\t1\nRIBO\tRPL8\t1\nRIBO\tRPS15\t1\nRIBO\tRPS23\t1\nRIBO\tRPS24\t1\nRIBO\tRPSA\t1',
        'SMALL\tCD44\t1\nSMALL\tVIM\t1\nSMALL\tNOTAGENE\t1',
    ].join('\n') + '\n'

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([ [ id: 'progeny' ], [] ])
                input[1] = 'human'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should convert a custom TSV network") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of('''${networkTsv}''')
                    .collectFile(name: 'network.tsv')
                    .map { network -> [[ id: 'custom' ], network] }
                input[1] = 'human'
                """
            }
        }

        then {
            assert process.success
            def lines = path(process.out.network[0][1]).readLines()
            assert lines[0] == "source\ttarget\tweight"
            assert lines.size() == 41
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml
            ).match()
        }

    }

    test("Should convert a custom GMT network") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of(
                    'BCELL\\tB cell markers\\tCD22\\tCD79A\\tCR2\\tFCER2\\tFCRL1\\tFCRL3\\tIGHM\\tTNFRSF13C\\n' +
                    'MHC\\tMHC genes\\tB2M\\tCD74\\tHLA-A\\tHLA-B\\tHLA-C\\tHLA-DPA1\\tHLA-DPB1\\tHLA-DRA\\tHLA-DRB1\\tHLA-E\\n' +
                    'RIBO\\tRibosomal proteins\\tRPL11\\tRPL4\\tRPL8\\tRPS15\\tRPS23\\tRPS24\\tRPSA\\n'
                ).collectFile(name: 'network.gmt')
                    .map { network -> [[ id: 'custom_gmt' ], network] }
                input[1] = 'human'
                """
            }
        }

        then {
            assert process.success
            def lines = path(process.out.network[0][1]).readLines()
            assert lines[0] == "source\ttarget\tweight"
            assert lines.size() == 26
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml
            ).match()
        }

    }

    test("Should download PROGENy from Omnipath") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([ [ id: 'progeny' ], [] ])
                input[1] = 'human'
                """
            }
        }

        then {
            assert process.success
            def lines = path(process.out.network[0][1]).readLines()
            assert lines[0] == "source\ttarget\tweight"
            // Omnipath content can change over time, so only the structure is snapshotted
            def sources = lines.drop(1).collect { it.split('\t')[0] }.unique().sort()
            assert sources.size() == 14
            assert snapshot(
                path(process.out.versions[0]).yaml,
                sources
            ).match()
        }

    }

}
