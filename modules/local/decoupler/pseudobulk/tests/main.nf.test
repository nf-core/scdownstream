nextflow_process {

    name "Test Process DECOUPLER_PSEUDOBULK"
    script "modules/local/decoupler/pseudobulk/main.nf"
    process "DECOUPLER_PSEUDOBULK"

    tag "modules"
    tag "modules_local"

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [
                            id: 'test',
                            obs_key: 'leiden',
                            condition_col: 'condition',
                        ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'X'
                input[2] = 'batch'
                input[3] = 'leiden'
                input[4] = 'condition'
                input[5] = 10
                input[6] = 1000
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should reject missing donor identities without unification") {
        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/anndata-variations/label_with_nan.h5ad', checkIfExists: true)
                ])
                input[1] = 'X'
                input[2] = 'cell_type'
                input[3] = 'sample'
                input[4] = 'sample'
                input[5] = 1
                input[6] = 0
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("Donor column 'cell_type' contains missing values")
        }
    }

    test("Should aggregate fractional SoupX counts without rounding") {
        setup {
            run("SOUPX") {
                script "modules/local/soupx/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id: 'test'],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_pca.h5ad', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_raw_matrix.h5ad', checkIfExists: true)
                    ])
                    input[1] = 0.8
                    input[2] = 'X'
                    input[3] = 'ambient_corrected_soupx'
                    """
                }
            }
        }
        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SOUPX.out.h5ad
                input[1] = 'ambient_corrected_soupx'
                input[2] = 'donor'
                input[3] = 'leiden'
                input[4] = 'condition'
                input[5] = 1
                input[6] = 0
                """
            }
        }
        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            assert adata.n_obs > 0
            assert adata.obs.get("total_counts").unique().any { (it as double) != Math.rint(it as double) }
        }
    }

    test("Should export shared genes after pseudobulk sample filtering") {
        tag "pseudobulk_gene_intersection"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                def fixture = 'https://raw.githubusercontent.com/nictru/test-datasets/80a11d44b1f0f224e3663a3e5bf3e743643098ab/extension_base_gene_presence/merged.h5ad'
                input[0] = [[id: 'test'], file(fixture, checkIfExists: true)]
                input[1] = 'raw_counts'
                input[2] = 'synthetic_donor'
                input[3] = 'synthetic_label'
                input[4] = 'synthetic_condition'
                input[5] = 1
                input[6] = 13000
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            // Eleven profiles reach 13,000 counts across all genes. None reach it across shared genes.
            assert adata.n_obs == 11
            assert adata.n_vars == 341
            assert adata.var.get('intersection').data.every { it == 'TRUE' }
            assert adata.obs.get('total_counts').data.every { (it as double) >= 13000 }
        }
    }

    test("Should aggregate pseudobulk profiles with decoupler") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'X'
                input[2] = 'sample'
                input[3] = 'leiden'
                input[4] = 'condition'
                input[5] = 10
                input[6] = 1000
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            with(adata) {
                assert n_obs > 0
                assert "donor" in obs.colnames
                assert "celltype" in obs.colnames
                assert "condition" in obs.colnames
            }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

}
