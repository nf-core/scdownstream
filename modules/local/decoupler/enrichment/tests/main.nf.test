nextflow_process {

    name "Test Process DECOUPLER_ENRICHMENT"
    script "modules/local/decoupler/enrichment/main.nf"
    process "DECOUPLER_ENRICHMENT"

    tag "modules"
    tag "modules_local"

    def networkTsv = [
        'source\ttarget\tweight',
        'AP1\tCD69\t1\nAP1\tFOS\t1\nAP1\tJUNB\t1\nAP1\tHSPA8\t1\nAP1\tPDCD4\t-1\nAP1\tCDKN1B\t-1',
        'BCELL\tCD22\t1\nBCELL\tCD79A\t1\nBCELL\tCR2\t1\nBCELL\tFCER2\t1\nBCELL\tFCRL1\t1\nBCELL\tFCRL3\t1\nBCELL\tIGHM\t1\nBCELL\tTNFRSF13C\t1',
        'IFN\tDDX60\t1\nIFN\tIFNGR2\t1\nIFN\tSP100\t1\nIFN\tSP140\t1\nIFN\tSTAT1\t1\nIFN\tZC3HAV1\t1',
        'MHC\tB2M\t1\nMHC\tCD74\t1\nMHC\tHLA-A\t1\nMHC\tHLA-B\t1\nMHC\tHLA-C\t1\nMHC\tHLA-DPA1\t1\nMHC\tHLA-DPB1\t1\nMHC\tHLA-DRA\t1\nMHC\tHLA-DRB1\t1\nMHC\tHLA-E\t1',
        'RIBO\tRPL11\t1\nRIBO\tRPL4\t1\nRIBO\tRPL8\t1\nRIBO\tRPS15\t1\nRIBO\tRPS23\t1\nRIBO\tRPS24\t1\nRIBO\tRPSA\t1',
        'SMALL\tCD44\t1\nSMALL\tVIM\t1\nSMALL\tNOTAGENE\t1',
    ].join('\n') + '\n'

    test("Should run without failures - stub") {

        options '-stub'

        setup {
            run("DECOUPLER_PSEUDOBULK") {
                script "modules/local/decoupler/pseudobulk/main.nf"
                process {
                    """
                    input[0] = channel.of([
                            [ id: 'test', integration: 'scvi' ],
                            file(params.pipelines_testdata_base_path + '/pbmc/with_label_and_condition_pca.h5ad', checkIfExists: true)
                        ]
                    )
                    input[1] = 'X'
                    input[2] = 'leiden'
                    input[3] = 'label'
                    input[4] = 'condition'
                    input[5] = 10
                    input[6] = 1000
                    """
                }
            }
            run("EDGEPYTHON_DIFFERENTIAL") {
                script "modules/local/edgepython/differential/main.nf"
                process {
                    """
                    input[0] = DECOUPLER_PSEUDOBULK.out.h5ad.map { meta, h5ad -> [meta + [de_method: 'edgepython'], h5ad] }
                    input[1] = 'Healthy'
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = EDGEPYTHON_DIFFERENTIAL.out.results
                input[1] = channel.of('''${networkTsv}''').collectFile(name: 'network.tsv')
                input[2] = 'ulm'
                input[3] = 5
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should enrich DE results without stat column") {

        setup {
            run("DECOUPLER_PSEUDOBULK") {
                script "modules/local/decoupler/pseudobulk/main.nf"
                process {
                    """
                    input[0] = channel.of([
                            [ id: 'test', integration: 'scvi' ],
                            file(params.pipelines_testdata_base_path + '/pbmc/with_label_and_condition_pca.h5ad', checkIfExists: true)
                        ]
                    )
                    input[1] = 'X'
                    input[2] = 'leiden'
                    input[3] = 'label'
                    input[4] = 'condition'
                    input[5] = 10
                    input[6] = 1000
                    """
                }
            }
            run("EDGEPYTHON_DIFFERENTIAL") {
                script "modules/local/edgepython/differential/main.nf"
                process {
                    """
                    input[0] = DECOUPLER_PSEUDOBULK.out.h5ad.map { meta, h5ad -> [meta + [de_method: 'edgepython'], h5ad] }
                    input[1] = 'Healthy'
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = EDGEPYTHON_DIFFERENTIAL.out.results
                input[1] = channel.of('''${networkTsv}''').collectFile(name: 'network.tsv')
                input[2] = 'ulm'
                input[3] = 5
                """
            }
        }

        then {
            assert process.success
            assert file(process.out.results[0][1]).name == 'test_edgepython_enrichment.parquet'
            assert file(process.out.uns[0]).name == 'test_edgepython_decoupler_enrichment.pkl'
            assert file(process.out.multiqc_files[0]).name == 'test_edgepython_network_enrichment_mqc.json'
            // Enrichment tables and the plots drawn from them differ in the last float digits across CPUs, so only their names are snapshotted
            assert snapshot(
                process.out.results.collect { meta, parquet -> [meta, file(parquet).name] },
                process.out.uns.collect { file(it).name },
                process.out.plots.collect { file(it).name },
                process.out.multiqc_files.collect { file(it).name },
                path(process.out.versions[0]).yaml
            ).match()
        }

    }

    test("Should enrich PyDESeq2 results") {

        setup {
            run("DECOUPLER_PSEUDOBULK") {
                script "modules/local/decoupler/pseudobulk/main.nf"
                process {
                    """
                    input[0] = channel.of([
                            [ id: 'test', integration: 'scvi' ],
                            file(params.pipelines_testdata_base_path + '/pbmc/with_label_and_condition_pca.h5ad', checkIfExists: true)
                        ]
                    )
                    input[1] = 'X'
                    input[2] = 'leiden'
                    input[3] = 'label'
                    input[4] = 'condition'
                    input[5] = 10
                    input[6] = 1000
                    """
                }
            }
            run("PYDESEQ2_DIFFERENTIAL") {
                script "modules/local/pydeseq2/differential/main.nf"
                process {
                    """
                    input[0] = DECOUPLER_PSEUDOBULK.out.h5ad.map { meta, h5ad -> [meta + [de_method: 'pydeseq2'], h5ad] }
                    input[1] = ''
                    input[2] = 'Healthy'
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = PYDESEQ2_DIFFERENTIAL.out.results
                input[1] = channel.of('''${networkTsv}''').collectFile(name: 'network.tsv')
                input[2] = 'ulm'
                input[3] = 5
                """
            }
        }

        then {
            assert process.success
            assert file(process.out.results[0][1]).name == 'test_pydeseq2_enrichment.parquet'
            assert file(process.out.uns[0]).name == 'test_pydeseq2_decoupler_enrichment.pkl'
            assert file(process.out.multiqc_files[0]).name == 'test_pydeseq2_network_enrichment_mqc.json'
            assert snapshot(
                process.out.results.collect { _meta, parquet -> file(parquet).name },
                process.out.uns.collect { file(it).name },
                path(process.out.versions[0]).yaml
            ).match()
        }

    }

}
