nextflow_process {

    name "Test Process SCDBLFINDER"
    script "modules/local/scdblfinder/main.nf"
    process "SCDBLFINDER"

    tag "modules"
    tag "modules_local"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        null,
                        '',
                        null
                    ]
                )
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.h5ad[0][1]).parent.resolve('.command.err').text.contains('using scDblFinder package default for dbr.sd')
            def adata = anndata(process.out.h5ad[0][1])
            with(adata) {
                assert "scdblfinder_class" in obs.colnames
                assert "scdblfinder_score" in obs.colnames
            }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should run with provided doublet_rate") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        0.08,
                        '',
                        null
                    ]
                )
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            with(adata) {
                assert "scdblfinder_class" in obs.colnames
                assert "scdblfinder_score" in obs.colnames
            }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should run with valid batch_col") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        null,
                        'sample',
                        null
                    ]
                )
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            with(adata) {
                assert "scdblfinder_class" in obs.colnames
                assert "scdblfinder_score" in obs.colnames
            }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should run when batch_col is missing") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        null,
                        null,
                        null
                    ]
                )
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            with(adata) {
                assert "scdblfinder_class" in obs.colnames
                assert "scdblfinder_score" in obs.colnames
            }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should fail with non-existing batch_col") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        null,
                        'non_existing_col',
                        null
                    ]
                )
                """
            }
        }

        then {
            assert process.failed
        }

    }

    test("Should pass dbr.sd of one with doublet_rate and batch_col") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'test' ],
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                    0.08,
                    'sample',
                    1
                ])
                """
            }
        }

        then {
            assert process.success
            def log = path(process.out.h5ad[0][1]).parent.resolve('.command.err').text
            assert log.contains('Using provided scDblFinder doublet-rate uncertainty (dbr.sd): 1')
            assert log.contains('Using provided doublet_rate (dbr): 0.08')
            assert log.contains('Using batch column for scDblFinder samples: sample')
            def adata = anndata(process.out.h5ad[0][1])
            assert adata.n_obs == 384
            assert 'scdblfinder_score' in adata.obs.colnames
            assert 'scdblfinder_class' in adata.obs.colnames
        }

    }

    test("Should preserve dbr.sd of zero") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'test' ],
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                    null,
                    '',
                    0
                ])
                """
            }
        }

        then {
            assert process.success
            def log = path(process.out.h5ad[0][1]).parent.resolve('.command.err').text
            assert log.contains('Using provided scDblFinder doublet-rate uncertainty (dbr.sd): 0')
            assert log.contains('using scDblFinder internal dbr estimation')
            def adata = anndata(process.out.h5ad[0][1])
            assert adata.n_obs == 384
            assert 'scdblfinder_score' in adata.obs.colnames
            assert 'scdblfinder_class' in adata.obs.colnames
        }

    }

    test("Should reject negative dbr.sd") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'test' ],
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                    null,
                    '',
                    -0.1
                ])
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains('scdblfinder_dbr_sd must be a number between 0 and 1')
        }

    }

    test("Should reject dbr.sd above one") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id: 'test' ],
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                    null,
                    '',
                    1.1
                ])
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains('scdblfinder_dbr_sd must be a number between 0 and 1')
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        null,
                        '',
                        null
                    ]
                )
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
