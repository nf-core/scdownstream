nextflow_process {

    name "Test Process SYMPHONY_HARMONYINTEGRATE"
    script "modules/local/symphony/harmonyintegrate/main.nf"
    process "SYMPHONY_HARMONYINTEGRATE"

    tag "modules"
    tag "modules_local"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = "sample"
                input[2] = "X"
                input[3] = 'h5ad'
                """
            }
        }

        then {
            def adata = anndata(process.out.anndata[0][1])
            def reference = anndata(process.out.reference[0][1])
            assert process.success
            assert "X_emb" in adata.obsm
            assert process.out.reference[0][1].endsWith('test_reference.h5ad')
            assert "harmony" in reference.uns
            assert "normalize" in reference.uns
            assert "mean" in reference.var.colnames
            assert "std" in reference.var.colnames
            assert "highly_variable" in reference.var.colnames
            assert "PCs" in reference.varm
            assert reference.n_obs == 0
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.yaml,
                reference.yaml
            ).match()
        }

    }

    test("Should read and write zarr") {

        setup {
            run("SCANPY_PCA", alias: "PCA_TO_ZARR") {
                script "modules/local/scanpy/pca/main.nf"
                process {
                    """
                    input[0] = channel.of([
                            [ id: 'input' ],
                            file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                        ]
                    )
                    input[1] = "X_pca"
                    input[2] = 'X'
                    input[3] = true
                    input[4] = 'zarr'
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = PCA_TO_ZARR.out.anndata.map { _meta, zarr -> [ [ id: 'test' ], zarr ] }
                input[1] = "sample"
                input[2] = "X"
                input[3] = 'zarr'
                """
            }
        }

        then {
            assert process.success
            def zarr_path = process.out.anndata[0][1]
            assert zarr_path.endsWith('test.zarr')
            assert new File(zarr_path, 'zarr.json').isFile()
            def adata = anndata(zarr_path)
            assert "X_emb" in adata.obsm
            assert "X_symphony" in adata.obsm
            assert process.out.reference[0][1].endsWith('test_reference.h5ad')
            def reference = anndata(process.out.reference[0][1])
            assert "harmony" in reference.uns
            assert reference.n_obs == 0
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.yaml,
                reference.yaml
            ).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = "sample"
                input[2] = "X"
                input[3] = 'h5ad'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should not write the object - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = "sample"
                input[2] = "X"
                input[3] = ''
                """
            }
        }

        then {
            assert process.success
            assert process.out.anndata.size() == 0
            assert process.out.reference.size() == 1
            assert snapshot(process.out).match()
        }

    }

}
