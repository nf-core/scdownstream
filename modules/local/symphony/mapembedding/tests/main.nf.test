nextflow_process {

    name "Test Process SYMPHONY_MAPEMBEDDING"
    script "modules/local/symphony/mapembedding/main.nf"
    process "SYMPHONY_MAPEMBEDDING"

    tag "modules"
    tag "modules_local"
    tag "fragment_embeddings"

    setup {
        run("SYMPHONY_HARMONYINTEGRATE") {
            script "modules/local/symphony/harmonyintegrate/main.nf"
            process {
                """
                input[0] = channel.of([
                        [ id: 'symphony' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = "sample"
                input[2] = "X"
                """
            }
        }
    }

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'symphony' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = SYMPHONY_HARMONYINTEGRATE.out.reference
                input[2] = "sample"
                input[3] = "X"
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            assert "X_emb" in adata.obsm
            assert "X_symphony" in adata.obsm
            assert file(process.out.obsm[0]).name == 'X_symphony.parquet'
            def embedding = path(process.out.obsm[0]).parquet
            assert embedding.rowCount == adata.n_obs
            assert embedding.columnNames[0] == '__index__'
            assert embedding.columnNames.drop(1) == (0..<(embedding.columnNames.size() - 1)).collect { it.toString() }
            assert embedding.schemaDetails.fields[0].logicalType.type == 'STRING'
            assert embedding.schemaDetails.fields.drop(1).every { it.physicalType in ['FLOAT', 'DOUBLE'] }
            assert embedding.compressionCodecs == ['SNAPPY']
            assert embedding.rowMaps.collect { it.__index__ } == adata.obs.index.values
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'symphony' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = channel.of([
                        [ id: 'symphony' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[2] = "sample"
                input[3] = "X"
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
