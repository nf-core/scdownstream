nextflow_process {

    name "Test Process SCIBMETRICS_BENCHMARK"
    script "modules/local/scibmetrics/benchmark/main.nf"
    process "SCIBMETRICS_BENCHMARK"

    tag "modules"
    tag "modules_local"

    setup {
        run("ADATA_UNIFY") {
            script "modules/local/adata/unify/main.nf"
            process {
                """
                input[0] = channel.of([
                        [ id: 'pca' ],
                        file(params.pipelines_testdata_base_path + '/anndata-variations/batch_correct_name.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'batch'
                input[2] = ''
                input[3] = ''
                input[4] = 'unknown'
                input[5] = 'index'
                input[6] = 'X'
                input[7] = 'sum'
                input[8] = false
                input[9] = ""
                """
            }
        }
        run("SCANPY_HVGS") {
            script "modules/local/scanpy/hvgs/main.nf"
            process {
                """
                input[0] = ADATA_UNIFY.out.h5ad
                input[1] = 500
                input[2] = []
                input[3] = 'X'
                input[4] = true
                """
            }
        }
        run("SCANPY_FILTER") {
            script "modules/local/scanpy/filter/main.nf"
            process {
                """
                input[0] = SCANPY_HVGS.out.h5ad
                input[1] = "index"
                input[2] = 1
                input[3] = 1
                input[4] = 1
                input[5] = 1
                input[6] = 100
                input[7] = 0
                input[8] = 100
                input[9] = 0
                input[10] = 0
                input[11] = 0
                input[12] = 0
                input[13] = []
                input[14] = false
                """
            }
        }
        run("SCANPY_PCA") {
            script "modules/local/scanpy/pca/main.nf"
            process {
                """
                input[0] = SCANPY_FILTER.out.h5ad
                input[1] = 'X_emb'
                input[2] = 'X'
                input[3] = true
                """
            }
        }
    }

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_PCA.out.h5ad
                input[1] = 0
                input[2] = 'stratified_label_batch'
                input[3] = 42
                input[4] = 'fast'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(path(process.out.versions[0]).yaml).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'pca' ],
                        file(params.pipelines_testdata_base_path + '/anndata-variations/batch_correct_name.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 0
                input[2] = 'stratified_label_batch'
                input[3] = 42
                input[4] = 'fast'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
