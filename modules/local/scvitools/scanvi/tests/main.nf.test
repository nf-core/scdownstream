nextflow_process {

    name "Test Process SCVITOOLS_SCANVI"
    script "modules/local/scvitools/scanvi/main.nf"
    process "SCVITOOLS_SCANVI"

    tag "modules"
    tag "modules_local"

    setup {
        run("SCANPY_HVGS") {
            script "modules/local/scanpy/hvgs/main.nf"
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 100
                input[2] = []
                input[3] = 'X'
                input[4] = true
                input[5] = ''
                """
            }
        }
    }

    test("Should run without failures") {

        config './nextflow.config'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_HVGS.out.h5ad
                input[1] = [[], []]
                input[2] = ''
                input[3] = ['label', 'Unknown']
                input[4] = 'sample'
                input[5] = ''
                input[6] = ''
                input[7] = 128
                input[8] = 2
                input[9] = 30
                input[10] = 'gene'
                input[11] = 'zinb'
                input[12] = 5
                input[13] = true
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            def original = anndata(SCANPY_HVGS.out.h5ad[0][1])
            assert adata.n_obs == original.n_obs
            assert adata.n_vars == original.n_vars
            assert adata.obs_names.toList() == original.obs_names.toList()
            assert adata.var_names.toList() == original.var_names.toList()
            assert adata.layers == original.layers
            assert adata.uns == original.uns
            assert adata.var.colnames.toList() == original.var.colnames.toList()
            original.obs.colnames.each { column ->
                assert adata.obs.get(column).data.toList() == original.obs.get(column).data.toList()
            }
            original.var.colnames.each { column ->
                assert adata.var.get(column).data.toList() == original.var.get(column).data.toList()
            }
            assert adata.obs.colnames.toList() == original.obs.colnames.toList() + ['label:scANVI']
            assert adata.obsm == original.obsm + ['X_emb']
            assert file(process.out.model[0][1]).size() > 0
            with(adata) {
                assert "X_emb" in obsm
            }
            assert snapshot(
                file(process.out.h5ad[0][1]).name,
                file(process.out.model[0][1]).name,
                file(process.out.obsm[0]).name,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should preserve query metadata when mapping to a scANVI reference") {

        config './nextflow.config'

        setup {
            run("SCANVI_REFERENCE") {
                script "modules/local/scvitools/scanvi/main.nf"
                process {
                    """
                    input[0] = SCANPY_HVGS.out.h5ad
                    input[1] = [[], []]
                    input[2] = ''
                    input[3] = ['label', 'Unknown']
                    input[4] = 'sample'
                    input[5] = 'donor'
                    input[6] = 'original_total_counts'
                    input[7] = 16
                    input[8] = 1
                    input[9] = 5
                    input[10] = 'gene'
                    input[11] = 'nb'
                    input[12] = 1
                    input[13] = true
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = channel.of([[id: 'query'], file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)])
                input[1] = SCANVI_REFERENCE.out.model
                input[2] = 'scanvi'
                input[3] = ['label', 'Unknown']
                input[4] = 'batch'
                input[5] = ''
                input[6] = ''
                input[7] = 16
                input[8] = 1
                input[9] = 5
                input[10] = 'gene'
                input[11] = 'nb'
                input[12] = 1
                input[13] = true
                """
            }
        }

        then {
            assert process.success
            def original = anndata(file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad'))
            def adata = anndata(process.out.h5ad[0][1])
            assert adata.n_vars > 100
            assert adata.obs_names.toList() == original.obs_names.toList()
            assert adata.var_names.toList() == original.var_names.toList()
            assert adata.layers == original.layers
            assert adata.uns == original.uns
            assert adata.var.colnames.toList() == original.var.colnames.toList()
            assert adata.obs.colnames.toList() == original.obs.colnames.toList() + ['label:scANVI']
            original.obs.colnames.each { column ->
                assert adata.obs.get(column).data.toList() == original.obs.get(column).data.toList()
            }
            original.var.colnames.each { column ->
                assert adata.var.get(column).data.toList() == original.var.get(column).data.toList()
            }
            assert adata.obsm == original.obsm + ['X_emb']
            assert adata.obs.get('label:scANVI').unique().every { it in original.obs.get('label').unique() }
            assert file(process.out.model[0][1]).size() > 0
        }
    }

    test("Should preserve query metadata when converting a scVI reference") {

        config './nextflow.config'

        setup {
            run("SCVI_REFERENCE") {
                script "modules/local/scvitools/scvi/main.nf"
                process {
                    """
                    input[0] = SCANPY_HVGS.out.h5ad
                    input[1] = [[], []]
                    input[2] = 'batch'
                    input[3] = 'sample'
                    input[4] = 'original_total_counts'
                    input[5] = 16
                    input[6] = 1
                    input[7] = 5
                    input[8] = 'gene'
                    input[9] = 'nb'
                    input[10] = 1
                    input[11] = true
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = channel.of([[id: 'query'], file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)])
                input[1] = SCVI_REFERENCE.out.model
                input[2] = 'scvi'
                input[3] = ['label', 'Unknown']
                input[4] = 'batch'
                input[5] = ''
                input[6] = ''
                input[7] = 16
                input[8] = 1
                input[9] = 5
                input[10] = 'gene'
                input[11] = 'nb'
                input[12] = 1
                input[13] = true
                """
            }
        }

        then {
            assert process.success
            def original = anndata(file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad'))
            def adata = anndata(process.out.h5ad[0][1])
            assert adata.n_vars > 100
            assert adata.obs_names.toList() == original.obs_names.toList()
            assert adata.var_names.toList() == original.var_names.toList()
            assert adata.layers == original.layers
            assert adata.uns == original.uns
            assert adata.var.colnames.toList() == original.var.colnames.toList()
            assert adata.obs.colnames.toList() == original.obs.colnames.toList() + ['label:scANVI']
            original.obs.colnames.each { column ->
                assert adata.obs.get(column).data.toList() == original.obs.get(column).data.toList()
            }
            original.var.colnames.each { column ->
                assert adata.var.get(column).data.toList() == original.var.get(column).data.toList()
            }
            assert adata.obsm == original.obsm + ['X_emb']
            assert adata.obs.get('label:scANVI').unique().every { it in original.obs.get('label').unique() }
            assert file(process.out.model[0][1]).size() > 0
        }
    }

    test("Should run without failures - stub") {

        config './nextflow.config'
        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_HVGS.out.h5ad
                input[1] = [[], []]
                input[2] = ''
                input[3] = ['label', 'Unknown']
                input[4] = 'sample'
                input[5] = ''
                input[6] = ''
                input[7] = 128
                input[8] = 2
                input[9] = 30
                input[10] = 'gene'
                input[11] = 'zinb'
                input[12] = 5
                input[13] = true
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should write label predictions to obs") {

        config './nextflow.config'

        // Expression-derived clusters provide learnable test classes, not donor identities.
        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_HVGS.out.h5ad
                input[1] = [[], []]
                input[2] = ''
                input[3] = ['leiden', 'Unknown']
                input[4] = 'batch'
                input[5] = ''
                input[6] = ''
                input[7] = 128
                input[8] = 2
                input[9] = 30
                input[10] = 'gene'
                input[11] = 'zinb'
                input[12] = 50
                input[13] = true
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            with(adata) {
                assert "label:scANVI" in obs.colnames
                assert obs.get("label:scANVI").unique().size() > 1
                assert obs.get("label:scANVI").unique().every { it in obs.get('leiden').unique() }
            }
            assert snapshot(
                file(process.out.h5ad[0][1]).name,
                file(process.out.model[0][1]).name,
                file(process.out.obsm[0]).name,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

}
