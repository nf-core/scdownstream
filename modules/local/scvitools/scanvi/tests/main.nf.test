nextflow_process {

    name "Test Process SCVITOOLS_SCANVI"
    script "modules/local/scvitools/scanvi/main.nf"
    process "SCVITOOLS_SCANVI"

    tag "modules"
    tag "modules_local"
    tag "fragment_embeddings"

    setup {
        run("SCANPY_HVGS") {
            script "modules/local/scanpy/hvgs/main.nf"
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 100
                input[2] = []
                input[3] = 'X'
                input[4] = true
                input[5] = ''
                """
            }
        }
    }

    test("Should run without failures") {

        config './nextflow.config'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_HVGS.out.h5ad
                input[1] = [[], []]
                input[2] = ''
                input[3] = ['label', 'Unknown']
                input[4] = 'sample'
                input[5] = ''
                input[6] = ''
                input[7] = 128
                input[8] = 2
                input[9] = 30
                input[10] = 'gene'
                input[11] = 'zinb'
                input[12] = 5
                input[13] = true
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            with(adata) {
                assert "X_emb" in obsm
            }
            assert file(process.out.obsm[0]).name == 'X_test_scanvi.parquet'
            assert file(process.out.obs[0]).name == 'test_scanvi.parquet'
            def embedding = parquet(process.out.obsm[0])
            assert embedding.rowCount == adata.n_obs
            assert embedding.columnNames == ['__index__'] + (0..<30).collect { it.toString() }
            assert embedding.schema.fields[0].logicalType.type == 'STRING'
            assert embedding.schema.fields.drop(1).every { it.physicalType in ['FLOAT', 'DOUBLE'] }
            assert embedding.compressionCodecs == ['SNAPPY']
            assert embedding.rows.collect { it.__index__ } == adata.obs.index.values
            def labels = parquet(process.out.obs[0])
            assert labels.columnNames == ['__index__', 'label:scANVI']
            assert labels.rowCount == adata.n_obs
            assert labels.schema.fields[0].logicalType.type == 'STRING'
            assert labels.compressionCodecs == ['SNAPPY']
            assert labels.rows.collect { it.__index__ } == adata.obs.index.values
            assert labels.rows.collect { it['label:scANVI'] } == adata.obs.get('label:scANVI').data
            assert snapshot(
                file(process.out.h5ad[0][1]).name,
                file(process.out.model[0][1]).name,
                file(process.out.obsm[0]).name,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should run without failures - stub") {

        config './nextflow.config'
        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_HVGS.out.h5ad
                input[1] = [[], []]
                input[2] = ''
                input[3] = ['label', 'Unknown']
                input[4] = 'sample'
                input[5] = ''
                input[6] = ''
                input[7] = 128
                input[8] = 2
                input[9] = 30
                input[10] = 'gene'
                input[11] = 'zinb'
                input[12] = 5
                input[13] = true
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should write label predictions to obs") {

        config './nextflow.config'

        // Expression-derived clusters provide learnable test classes, not donor identities.
        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_HVGS.out.h5ad
                input[1] = [[], []]
                input[2] = ''
                input[3] = ['leiden', 'Unknown']
                input[4] = 'batch'
                input[5] = ''
                input[6] = ''
                input[7] = 128
                input[8] = 2
                input[9] = 30
                input[10] = 'gene'
                input[11] = 'zinb'
                input[12] = 50
                input[13] = true
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            with(adata) {
                assert "label:scANVI" in obs.colnames
                assert obs.get("label:scANVI").unique().size() > 1
                assert obs.get("label:scANVI").unique().every { it in obs.get('leiden').unique() }
            }
            assert file(process.out.obsm[0]).name == 'X_test_scanvi.parquet'
            assert file(process.out.obs[0]).name == 'test_scanvi.parquet'
            def embedding = parquet(process.out.obsm[0])
            assert embedding.rowCount == adata.n_obs
            assert embedding.columnNames == ['__index__'] + (0..<30).collect { it.toString() }
            assert embedding.schema.fields[0].logicalType.type == 'STRING'
            assert embedding.schema.fields.drop(1).every { it.physicalType in ['FLOAT', 'DOUBLE'] }
            assert embedding.compressionCodecs == ['SNAPPY']
            assert embedding.rows.collect { it.__index__ } == adata.obs.index.values
            def labels = parquet(process.out.obs[0])
            assert labels.columnNames == ['__index__', 'label:scANVI']
            assert labels.rowCount == adata.n_obs
            assert labels.schema.fields[0].logicalType.type == 'STRING'
            assert labels.compressionCodecs == ['SNAPPY']
            assert labels.rows.collect { it.__index__ } == adata.obs.index.values
            assert labels.rows.collect { it['label:scANVI'] } == adata.obs.get('label:scANVI').data
            assert snapshot(
                file(process.out.h5ad[0][1]).name,
                file(process.out.model[0][1]).name,
                file(process.out.obsm[0]).name,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

}
