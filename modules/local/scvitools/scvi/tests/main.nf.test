nextflow_process {

    name "Test Process SCVITOOLS_SCVI"
    script "modules/local/scvitools/scvi/main.nf"
    process "SCVITOOLS_SCVI"

    tag "modules"
    tag "modules_local"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = [[], []]
                input[2] = 'sample'
                input[3] = ''
                input[4] = ''
                input[5] = 128
                input[6] = 2
                input[7] = 30
                input[8] = 'gene'
                input[9] = 'zinb'
                input[10] = 5
                input[11] = true
                input[12] = 'h5ad'
                """
            }
        }

        then {
            def adata = anndata(process.out.anndata[0][1])
            assert process.success
            with(adata) {
                assert "X_emb" in obsm
            }
            assert snapshot(
                    // Hashes are not stable due to floating point inaccuracies
                    path(process.out.versions[0]).yaml,
                    adata.yaml
                ).match()
        }

    }

    test("Should train after normalisation and HVG selection") {

        setup {
            run("SCANPY_SAMPLE") {
                script "modules/local/scanpy/sample/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id: 'counts'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ])
                    input[1] = 128
                    input[2] = []
                    input[3] = 'zarr'
                    """
                }
            }
            run("SCANPY_LOG1PNORM") {
                script "modules/local/scanpy/log1pnorm/main.nf"
                process {
                    """
                    input[0] = SCANPY_SAMPLE.out.anndata
                    input[1] = 'zarr'
                    """
                }
            }
            run("FEATURE_SELECTION") {
                script "subworkflows/local/feature_selection/main.nf"
                workflow {
                    """
                    input[0] = SCANPY_LOG1PNORM.out.anndata
                    input[1] = 'hvgs'
                    input[2] = 500
                    input[3] = []
                    input[4] = 'log1p'
                    input[5] = false
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = FEATURE_SELECTION.out.anndata
                input[1] = [[], []]
                input[2] = 'sample'
                input[3] = ''
                input[4] = ''
                input[5] = 16
                input[6] = 1
                input[7] = 5
                input[8] = 'gene'
                input[9] = 'nb'
                input[10] = 1
                input[11] = true
                input[12] = 'zarr'
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.anndata[0][1])
            assert adata.n_obs == 128
            assert 'X_emb' in adata.obsm
            assert 'counts' in adata.layers
            assert 'log1p' in adata.layers
            assert adata.obs.get('n_genes_by_counts').data.every { it > 0 }
        }
    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = [[], []]
                input[2] = 'sample'
                input[3] = ''
                input[4] = ''
                input[5] = 128
                input[6] = 2
                input[7] = 30
                input[8] = 'gene'
                input[9] = 'zinb'
                input[10] = 5
                input[11] = true
                input[12] = 'h5ad'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should not write the object - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = [[], []]
                input[2] = 'sample'
                input[3] = ''
                input[4] = ''
                input[5] = 128
                input[6] = 2
                input[7] = 30
                input[8] = 'gene'
                input[9] = 'zinb'
                input[10] = 5
                input[11] = true
                input[12] = ''
                """
            }
        }

        then {
            assert process.success
            assert process.out.anndata.size() == 0
            assert snapshot(process.out).match()
        }

    }

}
