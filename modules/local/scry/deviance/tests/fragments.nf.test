nextflow_process {

    name "Test scry fragments through ADATA_EXTEND"
    script "modules/local/adata/extend/main.nf"
    process "ADATA_EXTEND"

    tag "modules"
    tag "modules_local"

    test("Should preserve names and logical and numeric deviance columns") {
        setup {
            run("SCRY_DEVIANCE") {
                script "modules/local/scry/deviance/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id: 'test', subset: 'CD4_T'],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ])
                    input[1] = 100
                    input[2] = []
                    input[3] = ''
                    """
                }
            }
        }
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = SCRY_DEVIANCE.out.var.map { fragment -> [
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true),
                    [], [fragment], [], [], [], []
                ] }
                """
            }
        }
        then {
            assert process.success
            def output = path(process.out.h5ad[0][1])
            def adata = anndata(output)
            def fragment = parquet(output.parent.resolve('var/deviance_subset_CD4_T_features.parquet'))
            assert fragment.rows.collect { it.__index__ } == adata.var.rownames.toList()
            assert !adata.var.colnames.contains('__index__')
            assert adata.n_vars == 3000
            def flag = 'deviance:subset:CD4_T:highly_deviant'
            def score = 'deviance:subset:CD4_T:binomial_deviance'
            assert [flag, score].every { it in adata.var.colnames }
            assert fragment.rows.every { it[flag] instanceof Boolean && it[score] instanceof Number }
            assert adata.var.get(flag).data.collect { it.toString().toLowerCase() } == fragment.rows.collect { it[flag].toString() }
            assert adata.var.get(score).data.every { it instanceof Number }
            assert adata.var.get(score).data.toList() == fragment.rows.collect { it[score] }
        }
    }
}
