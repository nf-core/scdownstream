nextflow_process {

    name "Test Process SCANPY_TSNE"
    script "modules/local/scanpy/tsne/main.nf"
    process "SCANPY_TSNE"

    tag "modules"
    tag "modules_local"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'X_pca'
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            with(adata) {
                assert obsm.any { it.endsWith("_tsne") }
            }
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'X_pca'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should error when representation is missing") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'X_nonexistent'
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains("ValueError: Representation 'X_nonexistent' not found in adata.obsm")
        }

    }

    test("Should error when representation is empty") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_pca.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = ''
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains("ValueError: representation parameter is required but was not provided")
        }

    }

    test("Should use nondefault representation X_custom") {

        setup {
            run("SCANPY_PCA") {
                script "../../pca/main.nf"
                process {
                    """
                    input[0] = channel.of([
                            [ id: 'test' ],
                            file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                        ]
                    )
                    input[1] = 'X_custom'
                    input[2] = 'X'
                    input[3] = true
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_PCA.out.h5ad
                input[1] = 'X_custom'
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            with(adata) {
                assert obsm.any { it.endsWith("_tsne") }
                assert obsm.contains("X_custom")
            }
        }

    }

}
