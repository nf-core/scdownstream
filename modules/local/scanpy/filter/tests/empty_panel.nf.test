nextflow_process {

    name "Test SCANPY_FILTER empty gene panel"
    script "modules/local/scanpy/filter/main.nf"
    process "SCANPY_FILTER"

    tag "modules"
    tag "modules_local"

    setup {
        run("SCANPY_HVGS") {
            script "modules/local/scanpy/hvgs/main.nf"
            process {
                """
                input[0] = channel.of([
                    [id: 'empty'],
                    file(params.pipelines_testdata_base_path + '/anndata-variations/counts_in_X.h5ad', checkIfExists: true)
                ])
                input[1] = 10
                input[2] = channel.of((0..<128).collect { String.format('GENE%03d', it) }.join('\\n') + '\\n')
                    .collectFile(name: 'excluded_genes.txt')
                input[3] = 'X'
                input[4] = false
                input[5] = ''
                """
            }
        }
    }

    test("Should reject zero genes with a clear error") {
        when {
            process {
                """
                input[0] = SCANPY_HVGS.out.h5ad.map { meta, h5ad -> [[id: 'qc_empty'], h5ad] }
                input[1] = 'index'
                input[2] = 0
                input[3] = 0
                input[4] = 0
                input[5] = 0
                input[6] = 100
                input[7] = 0
                input[8] = 100
                input[9] = 0
                input[10] = 0
                input[11] = 0
                input[12] = 0
                input[13] = []
                input[14] = false
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('Cannot calculate QC metrics for an empty gene panel (zero genes)')
        }
    }
}
