nextflow_process {

    name "Test Process SCANPY_LOG1PNORM"
    script "modules/local/scanpy/log1pnorm/main.nf"
    process "SCANPY_LOG1PNORM"

    tag "modules"
    tag "modules_local"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            assert "counts" in adata.layers
            assert "log1p" in adata.layers
            nictru.nf.anndata.store.AnnDataStore.open(java.nio.file.Path.of(process.out.h5ad[0][1].toString())).withCloseable { store ->
                def x = store.getGroup('X')
                def counts = store.getGroup('layers').getChild('counts').asGroup()
                for (field in ['data', 'indices', 'indptr']) {
                    assert java.util.Arrays.equals(
                        x.getChild(field).asArray().readData(),
                        counts.getChild(field).asArray().readData(),
                    )
                }
            }
            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
