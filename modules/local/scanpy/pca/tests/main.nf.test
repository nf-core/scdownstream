nextflow_process {

    name "Test Process SCANPY_PCA"
    script "modules/local/scanpy/pca/main.nf"
    process "SCANPY_PCA"

    tag "modules"
    tag "modules_local"
    tag "fragment_embeddings"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = "X_pca"
                input[2] = 'X'
                input[3] = true
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])

            assert process.success
            assert "X_pca" in adata.obsm
            assert "X_pca" in adata.uns
            assert "X_pca" in adata.varm
            assert "pca_log1p" in adata.layers
            assert file(process.out.obsm[0]).name == 'X_test_pca.parquet'
            def embedding = parquet(process.out.obsm[0])
            assert embedding.rowCount == adata.n_obs
            assert embedding.columnNames[0] == '__index__'
            assert embedding.columnNames.drop(1) == (0..<(embedding.columnNames.size() - 1)).collect { it.toString() }
            assert embedding.schema.fields[0].logicalType.type == 'STRING'
            assert embedding.schema.fields.drop(1).every { it.physicalType in ['FLOAT', 'DOUBLE'] }
            assert embedding.compressionCodecs == ['SNAPPY']
            assert embedding.rows.collect { it.__index__ } == adata.obs.index.values

            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should preserve input layers") {

        setup {
            run("SCANPY_LOG1PNORM") {
                script "../../log1pnorm/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id: 'layered'],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)
                    ])
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = SCANPY_LOG1PNORM.out.h5ad
                input[1] = "X_pca"
                input[2] = "raw_counts"
                input[3] = true
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])

            assert process.success
            assert "X_pca" in adata.obsm
            assert "X_pca" in adata.uns
            assert "X_pca" in adata.varm

            with(adata) {
                assert layers.toSet() == ['raw_counts', 'log1p', 'pca_log1p'].toSet()
            }
            assert file(process.out.obsm[0]).name == 'X_layered_pca.parquet'
            def embedding = parquet(process.out.obsm[0])
            assert embedding.rowCount == adata.n_obs
            assert embedding.columnNames[0] == '__index__'
            assert embedding.columnNames.drop(1) == (0..<(embedding.columnNames.size() - 1)).collect { it.toString() }
            assert embedding.schema.fields[0].logicalType.type == 'STRING'
            assert embedding.schema.fields.drop(1).every { it.physicalType in ['FLOAT', 'DOUBLE'] }
            assert embedding.compressionCodecs == ['SNAPPY']
            assert embedding.rows.collect { it.__index__ } == adata.obs.index.values

            assert snapshot(
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should use an existing log1p layer without creating another expression matrix") {

        setup {
            run("SCANPY_LOG1PNORM") {
                script "../../log1pnorm/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id: 'layered'],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ])
                    """
                }
            }
        }

        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = SCANPY_LOG1PNORM.out.h5ad
                input[1] = 'X_custom'
                input[2] = 'log1p'
                input[3] = false
                """
            }
        }

        then {
            assert process.success
            def adata = anndata(process.out.h5ad[0][1])
            assert adata.layers.toSet() == ['log1p'].toSet()
            assert 'X_custom' in adata.obsm
            assert 'X_custom' in adata.varm
            assert 'X_custom' in adata.uns
            assert file(process.out.obsm[0]).name == 'X_layered_pca.parquet'
            def embedding = parquet(process.out.obsm[0])
            assert embedding.rowCount == adata.n_obs
            assert embedding.columnNames[0] == '__index__'
            assert embedding.columnNames.drop(1) == (0..<(embedding.columnNames.size() - 1)).collect { it.toString() }
            assert embedding.schema.fields[0].logicalType.type == 'STRING'
            assert embedding.schema.fields.drop(1).every { it.physicalType in ['FLOAT', 'DOUBLE'] }
            assert embedding.compressionCodecs == ['SNAPPY']
            assert embedding.rows.collect { it.__index__ } == adata.obs.index.values
            assert snapshot(path(process.out.versions[0]).yaml, adata.yaml).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = "X_pca"
                input[2] = 'X'
                input[3] = true
                """
            }
        }

        then {
            assert process.success

            assert snapshot(process.out).match()
        }

    }

}
