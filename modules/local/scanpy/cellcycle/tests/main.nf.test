nextflow_process {

    name "Test Process SCANPY_CELLCYCLE"
    script "modules/local/scanpy/cellcycle/main.nf"
    process "SCANPY_CELLCYCLE"

    tag "modules"
    tag "modules_local"

    test("Should run without failures - human") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = file("${projectDir}/assets/cell_cycle_genes/human_s_genes.txt")
                input[2] = file("${projectDir}/assets/cell_cycle_genes/human_g2m_genes.txt")
                input[3] = 'symbols'
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            def fragment = path(process.out.obs[0][1]).parquet
            assert file(process.out.obs[0][1]).name == 'test_cellcycle.parquet'
            assert fragment.columnNames == ['__index__', 'S_score', 'G2M_score', 'phase']
            assert fragment.compressionCodecs == ['SNAPPY']
            assert fragment.rowCount == adata.n_obs
            assert fragment.schemaDetails.fields.find { it.name == '__index__' }.logicalType.type == 'STRING'
            assert fragment.schemaDetails.fields.find { it.name == 'phase' }.logicalType.type == 'STRING'
            assert fragment.schemaDetails.fields.find { it.name == 'S_score' }.physicalType == 'DOUBLE'
            assert fragment.schemaDetails.fields.find { it.name == 'G2M_score' }.physicalType == 'DOUBLE'
            def rows = fragment.rowMaps
            assert rows.every { it.__index__ instanceof String }
            assert rows.collect { it.__index__ }.toSet().size() == fragment.rowCount
            assert rows.collect { it.__index__ } == adata.obs.index.values.toList()
            ['S_score', 'G2M_score', 'phase'].each { column ->
                assert rows.collect { it[column] } == adata.obs.get(column).data.toList()
            }
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = file("${projectDir}/assets/cell_cycle_genes/human_s_genes.txt")
                input[2] = file("${projectDir}/assets/cell_cycle_genes/human_g2m_genes.txt")
                input[3] = 'index'
                """
            }
        }

        then {
            assert process.success

            assert snapshot(process.out).match()
        }

    }

}
