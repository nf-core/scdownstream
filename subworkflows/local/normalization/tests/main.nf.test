nextflow_workflow {

    name "Test Workflow NORMALIZATION"
    script "subworkflows/local/normalization/main.nf"
    workflow "NORMALIZATION"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should run log1p normalization") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = ['log1p']
                input[2] = 'log1p_norm'
                """
            }
        }

        then {
            def adata = anndata(workflow.out.h5ad[0][1])
            assert workflow.success
            assert "log1p_norm" in adata.layers
            assert snapshot(workflow.out).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = ['log1p', 'scran']
                input[2] = ''
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.layers.size() == 2
            assert snapshot(workflow.out).match()
        }

    }

}
