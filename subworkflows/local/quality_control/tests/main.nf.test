    test("Should run without ambient RNA removal and doublet detection - with MAD filtering") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [
                            id: 'test',
                            batch_col: 'sample',
                            counts_layer: 'X',
                            max_mito_percentage: 8,
                            log1p_total_counts_nmads: 5,
                            log1p_n_genes_by_counts_nmads: 5,
                            pct_counts_in_top_20_genes_nmads: 5,
                            pct_counts_mt_nmads: 3
                        ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'cellbender'
                input[2] = 'none'
                input[3] = false
                input[4] = false
                input[5] = 'sum'
                input[6] = false
                input[7] = []
                input[8] = 1
                input[9] = false
                input[10] = null
                input[11] = null
                input[12] = null
                input[13] = null
                input[14] = false
                input[15] = []
                input[16] = []
                input[17] = 'human'
                """
            }
        }

        then {
            assert workflow.success
            def adata = anndata(workflow.out.h5ad[0][1])
            assert workflow.out.h5ad.size() == 1
            assert workflow.out.h5ad[0][0].counts_layer == 'X'
            assert workflow.out.h5ad[0][0].raw_counts_layer == 'raw_counts'
            assert workflow.out.h5ad[0][0].ambient_correction_layer == null
            assert workflow.out.h5ad[0][0].ambient_correction_method == 'none'
            assert workflow.out.h5ad[0][0].analysis_counts_source == 'raw_counts'
            assert 'raw_counts' in adata.layers
            assert adata.layers.size() == 1
            assert adata.obs.get('ambient_correction_method').unique().toSet() == ['none'].toSet()
            assert adata.obs.get('analysis_counts_source').unique().toSet() == ['raw_counts'].toSet()
            with(adata) {
                assert "log1p_total_counts" in obs.colnames
                assert "log1p_n_genes_by_counts" in obs.colnames
                assert "pct_counts_in_top_20_genes" in obs.colnames
                assert "pct_counts_mt" in obs.colnames
            }
            assert snapshot(
                workflow.out.multiqc_files,
                workflow.out.versions.collect { path(it).yaml },
                adata.n_obs,
                adata.n_vars,
                adata.yaml
            ).match()
        }

    }

    test("Should apply sc-best-practices QC filtering when samplesheet defaults are present in meta") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [
                            id: 'test',
                            batch_col: 'sample',
                            counts_layer: 'X',
                            min_genes: 0,
                            min_cells: 20,
                            max_mito_percentage: 8,
                            log1p_total_counts_nmads: 5,
                            log1p_n_genes_by_counts_nmads: 5,
                            pct_counts_in_top_20_genes_nmads: 5,
                            pct_counts_mt_nmads: 3
                        ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'cellbender'
                input[2] = 'none'
                input[3] = false
                input[4] = false
                input[5] = 'sum'
                input[6] = false
                input[7] = []
                input[8] = 1
                input[9] = false
                input[10] = null
                input[11] = null
                input[12] = null
                input[13] = null
                input[14] = false
                input[15] = []
                input[16] = []
                input[17] = 'human'
                """
            }
        }

        then {
            assert workflow.success
            def adata = anndata(workflow.out.h5ad[0][1])
            def meta = workflow.out.h5ad[0][0]
            assert workflow.out.h5ad.size() == 1
            assert meta.counts_layer == 'X'
            assert meta.raw_counts_layer == 'raw_counts'
            assert meta.ambient_correction_layer == null
            assert meta.ambient_correction_method == 'none'
            assert meta.analysis_counts_source == 'raw_counts'
            assert 'raw_counts' in adata.layers
            assert adata.layers.size() == 1
            assert adata.obs.get('ambient_correction_method').unique().toSet() == ['none'].toSet()
            assert adata.obs.get('analysis_counts_source').unique().toSet() == ['raw_counts'].toSet()
            // Samplesheet MAD defaults remove low-quality cells from the 12940-cell filtered input.
            assert adata.n_obs < 12940
            assert adata.n_obs > 10000
            with(adata) {
                assert "log1p_total_counts" in obs.colnames
                assert "pct_counts_mt" in obs.colnames
            }
            assert snapshot(meta, adata.yaml).match()
        }

    }

