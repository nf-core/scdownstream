nextflow_workflow {

    name "Test Workflow QUALITY_CONTROL"
    script "subworkflows/local/quality_control/main.nf"
    workflow "QUALITY_CONTROL"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should run without ambient RNA removal and doublet detection") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [
                            id: 'test',
                            batch_col: 'sample',
                            counts_layer: 'X',
                            min_cells: 0,
                            max_mito_percentage: 100,
                            log1p_total_counts_nmads: 0,
                            log1p_n_genes_by_counts_nmads: 0,
                            pct_counts_in_top_20_genes_nmads: 0,
                            pct_counts_mt_nmads: 0
                        ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'cellbender'
                input[2] = 'none'
                input[3] = false
                input[4] = false
                input[5] = 'sum'
                input[6] = false
                input[7] = []
                input[8] = 1
                input[9] = false
                input[10] = null
                input[11] = null
                input[12] = null
                input[13] = null
                input[14] = false
                input[15] = []
                input[16] = []
                input[17] = 'human'
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.h5ad.size() == 1
            def meta = workflow.out.h5ad[0][0]
            def adata = anndata(workflow.out.h5ad[0][1])
            assert meta.counts_layer == 'X'
            assert meta.raw_counts_layer == 'raw_counts'
            assert meta.ambient_correction_layer == null
            assert meta.ambient_correction_method == 'none'
            assert meta.analysis_counts_source == 'raw_counts'
            assert 'raw_counts' in adata.layers
            assert adata.layers.size() == 1
            assert adata.obs.get('ambient_correction_method').unique().toSet() == ['none'].toSet()
            assert adata.obs.get('analysis_counts_source').unique().toSet() == ['raw_counts'].toSet()
            assert snapshot(
                workflow.out.multiqc_files,
                workflow.out.versions.collect { path(it).yaml }
            ).match()
        }

    }

