    test("Should run with ambient RNA removal and doublet detection") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [
                            id: 'test',
                            batch_col: 'sample',
                            counts_layer: 'X',
                            use_ambient_corrected_counts: false,
                            min_cells: 0,
                            max_mito_percentage: 100,
                            log1p_total_counts_nmads: 0,
                            log1p_n_genes_by_counts_nmads: 0,
                            pct_counts_in_top_20_genes_nmads: 0,
                            pct_counts_mt_nmads: 0
                        ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'cellbender'
                input[2] = 'decontx'
                input[3] = true
                input[4] = false
                input[5] = 'sum'
                input[6] = false
                input[7] = ['scrublet']
                input[8] = 1
                input[9] = true
                input[10] = null
                input[11] = null
                input[12] = null
                input[13] = null
                input[14] = false
                input[15] = []
                input[16] = []
                input[17] = 'human'
                """
            }
        }

        then {
            assert workflow.success
            def adata = anndata(workflow.out.h5ad[0][1])
            def meta = workflow.out.h5ad[0][0]
            assert meta.counts_layer == 'X'
            assert meta.raw_counts_layer == 'raw_counts'
            assert meta.ambient_correction_layer == 'ambient_corrected_decontx'
            assert meta.ambient_correction_method == 'decontx'
            assert meta.analysis_counts_source == 'raw_counts'
            assert 'raw_counts' in adata.layers
            assert 'ambient_corrected_decontx' in adata.layers
            assert adata.layers.size() == 2
            assert adata.obs.get('ambient_correction_method').unique().toSet() == ['decontx'].toSet()
            assert adata.obs.get('analysis_counts_source').unique().toSet() == ['raw_counts'].toSet()
            assert adata.n_obs == adata.obs.rownames.size()
            assert adata.n_vars == adata.var.rownames.size()
            with(adata) {
                assert "pct_counts_mt" in obs.colnames
                assert "batch" in obs.colnames
                assert "label" in obs.colnames
                assert "condition" in obs.colnames
                assert "sample" in obs.colnames
            }
            assert snapshot(
                workflow.out.multiqc_files,
                workflow.out.versions.collect { path(it).yaml },
                adata.n_obs,
                adata.n_vars,
                adata.yaml
            ).match()
        }

    }

