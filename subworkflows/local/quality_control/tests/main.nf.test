nextflow_workflow {

    name "Test Workflow QUALITY_CONTROL"
    script "subworkflows/local/quality_control/main.nf"
    workflow "QUALITY_CONTROL"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should run without ambient RNA removal and doublet detection") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [
                            id: 'test',
                            batch_col: 'sample',
                            counts_layer: 'X',
                            min_cells: 0,
                            max_mito_percentage: 100,
                            log1p_total_counts_nmads: 0,
                            log1p_n_genes_by_counts_nmads: 0,
                            pct_counts_in_top_20_genes_nmads: 0,
                            pct_counts_mt_nmads: 0
                        ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'none'
                input[2] = false
                input[3] = false
                input[4] = 'sum'
                input[5] = false
                input[6] = []
                input[7] = 1
                input[8] = false
                input[9] = null
                input[10] = null
                input[11] = null
                input[12] = null
                input[13] = false
                input[14] = []
                input[15] = []
                input[16] = 'human'
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.h5ad.size() == 1
            assert snapshot(
                workflow.out.multiqc_files,
                workflow.out.versions.collect { path(it).yaml }
            ).match()
        }

    }

    test("Should run without ambient RNA removal and doublet detection, but with custom mito genes") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [
                            id: 'test',
                            batch_col: 'sample',
                            counts_layer: 'X',
                            min_cells: 0,
                            max_mito_percentage: 100,
                            log1p_total_counts_nmads: 0,
                            log1p_n_genes_by_counts_nmads: 0,
                            pct_counts_in_top_20_genes_nmads: 0,
                            pct_counts_mt_nmads: 0
                        ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'none'
                input[2] = false
                input[3] = false
                input[4] = 'sum'
                input[5] = false
                input[6] = []
                input[7] = 1
                input[8] = false
                input[9] = null
                input[10] = channel.of('POMP', 'DLG2')
                    .collectFile(name: 'mito_genes.txt')
                input[11] = null
                input[12] = null
                input[13] = false
                input[14] = []
                input[15] = []
                input[16] = 'human'
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.h5ad.size() == 1
            assert snapshot(
                workflow.out.multiqc_files,
                workflow.out.versions.collect { path(it).yaml }
            ).match()
        }

    }

    test("Should run with ambient RNA removal and doublet detection") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [
                            id: 'test',
                            batch_col: 'sample',
                            counts_layer: 'X',
                            min_cells: 0,
                            max_mito_percentage: 100,
                            log1p_total_counts_nmads: 0,
                            log1p_n_genes_by_counts_nmads: 0,
                            pct_counts_in_top_20_genes_nmads: 0,
                            pct_counts_mt_nmads: 0
                        ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'decontx'
                input[2] = false
                input[3] = false
                input[4] = 'sum'
                input[5] = false
                input[6] = ['scrublet']
                input[7] = 1
                input[8] = true
                input[9] = null
                input[10] = null
                input[11] = null
                input[12] = null
                input[13] = false
                input[14] = []
                input[15] = []
                input[16] = 'human'
                """
            }
        }

        then {
            def adata = anndata(workflow.out.h5ad[0][1])

            assert workflow.success
            with(adata) {
                assert "pct_counts_mt" in obs.colnames
                assert "batch" in obs.colnames
                assert "label" in obs.colnames
                assert "condition" in obs.colnames
                assert "sample" in obs.colnames
            }
            assert snapshot(
                workflow.out.multiqc_files,
                workflow.out.versions.collect { path(it).yaml },
                adata.n_obs,
                adata.n_vars,
                adata.yaml
            ).match()
        }

    }

    test("Should run with ambient RNA removal and doublet detection - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test', batch_col: 'sample', counts_layer: 'X' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'decontx'
                input[2] = false
                input[3] = false
                input[4] = 'sum'
                input[5] = false
                input[6] = ['scrublet']
                input[7] = 1
                input[8] = true
                input[9] = null
                input[10] = null
                input[11] = null
                input[12] = null
                input[13] = false
                input[14] = []
                input[15] = []
                input[16] = 'human'
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

    test("Should run without ambient RNA removal and doublet detection - with MAD filtering") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [
                            id: 'test',
                            batch_col: 'sample',
                            counts_layer: 'X',
                            max_mito_percentage: 8,
                            log1p_total_counts_nmads: 5,
                            log1p_n_genes_by_counts_nmads: 5,
                            pct_counts_in_top_20_genes_nmads: 5,
                            pct_counts_mt_nmads: 3
                        ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'none'
                input[2] = false
                input[3] = false
                input[4] = 'sum'
                input[5] = false
                input[6] = []
                input[7] = 1
                input[8] = false
                input[9] = null
                input[10] = null
                input[11] = null
                input[12] = null
                input[13] = false
                input[14] = []
                input[15] = []
                input[16] = 'human'
                """
            }
        }

        then {
            def adata = anndata(workflow.out.h5ad[0][1])

            assert workflow.success
            assert workflow.out.h5ad.size() == 1
            with(adata) {
                assert "log1p_total_counts" in obs.colnames
                assert "log1p_n_genes_by_counts" in obs.colnames
                assert "pct_counts_in_top_20_genes" in obs.colnames
                assert "pct_counts_mt" in obs.colnames
            }
            assert snapshot(
                workflow.out.multiqc_files,
                workflow.out.versions.collect { path(it).yaml },
                adata.n_obs,
                adata.n_vars,
                adata.yaml
            ).match()
        }

    }

    test("Should apply sc-best-practices QC filtering when samplesheet defaults are present in meta") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [
                            id: 'test',
                            batch_col: 'sample',
                            counts_layer: 'X',
                            min_genes: 0,
                            min_cells: 20,
                            max_mito_percentage: 8,
                            log1p_total_counts_nmads: 5,
                            log1p_n_genes_by_counts_nmads: 5,
                            pct_counts_in_top_20_genes_nmads: 5,
                            pct_counts_mt_nmads: 3
                        ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'none'
                input[2] = false
                input[3] = false
                input[4] = 'sum'
                input[5] = false
                input[6] = []
                input[7] = 1
                input[8] = false
                input[9] = null
                input[10] = null
                input[11] = null
                input[12] = null
                input[13] = false
                input[14] = []
                input[15] = []
                input[16] = 'human'
                """
            }
        }

        then {
            def adata = anndata(workflow.out.h5ad[0][1])

            assert workflow.success
            assert workflow.out.h5ad.size() == 1
            // Samplesheet MAD defaults remove low-quality cells from the 12940-cell filtered input.
            assert adata.n_obs < 12940
            assert adata.n_obs > 10000
            with(adata) {
                assert "log1p_total_counts" in obs.colnames
                assert "pct_counts_mt" in obs.colnames
            }
        }

    }

