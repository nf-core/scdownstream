nextflow_workflow {

    name "Test Workflow RANK_GENES_GROUPS"
    script "subworkflows/local/rank_genes_groups/main.nf"
    workflow "RANK_GENES_GROUPS"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should run differential expression with leiden clustering") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/pbmc/with_label_and_condition_pca.h5ad', checkIfExists: true)
                ]).map { meta, h5ad -> [meta + [obs_key: 'leiden', condition_col: 'condition', de_methods_resolved: ['wilcoxon'] as Set], h5ad] }
                input[1] = false
                input[2] = 'Test study context'
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.uns.size() >= 1
            assert workflow.out.multiqc_files.size() >= 1
            assert workflow.out.results.size() >= 1
            assert workflow.out.results.every { _meta, parquet -> file(parquet).name.contains("_results.parquet") }
            assert workflow.out.uns.any { file(it).name.endsWith("_characteristic_genes.pkl") }
            assert workflow.out.anndata.size() >= 1
            assert workflow.out.anndata.every { meta, _anndata -> meta.comparison_scope == 'global' }
            def adata = anndata(workflow.out.anndata[0][1])
            assert "rank_genes_groups" in adata.uns
            assert snapshot(
                workflow.out.versions.collect { path(it).yaml }
            ).match()
        }

    }

    test("Should run differential expression with label column") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/pbmc/with_label_and_condition_pca.h5ad', checkIfExists: true)
                ]).map { meta, h5ad -> [meta + [obs_key: 'label', condition_col: 'condition', de_methods_resolved: ['wilcoxon'] as Set], h5ad] }
                input[1] = false
                input[2] = 'Test study context'
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.results.size() >= 1
            assert workflow.out.results.every { _meta, parquet -> file(parquet).name.contains("_results.parquet") }
            assert snapshot(
                workflow.out.versions.collect { path(it).yaml }
            ).match()
        }

    }

    test("Should filter comparisons when the grouping has fewer than two values") {

        tag "eligibility"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/pbmc/with_label_and_condition_pca.h5ad', checkIfExists: true)
                ]).map { meta, h5ad -> [meta + [obs_key: 'batch', condition_col: 'condition', de_methods_resolved: ['wilcoxon'] as Set], h5ad] }
                input[1] = false
                input[2] = 'Test study context'
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 0
            assert workflow.out.uns.size() == 0
            assert workflow.out.anndata.size() == 0
            assert workflow.out.results.size() == 0
        }

    }

    test("Should run multiple rank-genes-groups methods in parallel") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/pbmc/with_label_and_condition_pca.h5ad', checkIfExists: true)
                ]).map { meta, h5ad -> [meta + [obs_key: 'leiden', condition_col: 'condition', de_methods_resolved: ['wilcoxon', 't-test'] as Set], h5ad] }
                input[1] = false
                input[2] = 'Test study context'
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.uns.size() >= 2
            assert workflow.out.results.size() >= 2
            assert workflow.out.results.every { _meta, parquet -> file(parquet).name.contains("_results.parquet") }
            assert workflow.out.anndata.size() == 2
            assert workflow.out.anndata.every { meta, _anndata -> meta.comparison_scope == 'global' }
            assert workflow.out.anndata.collect { meta, _anndata -> meta.de_method }.toSet() == ['wilcoxon', 't-test'] as Set
        }

    }

    test("Should not write the object without save_intermediates or CyteType study context") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/pbmc/with_label_and_condition_pca.h5ad', checkIfExists: true)
                ]).map { meta, h5ad -> [meta + [obs_key: 'leiden', condition_col: 'condition', de_methods_resolved: ['wilcoxon'] as Set], h5ad] }
                input[1] = false
                input[2] = ''
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.results.size() >= 1
            assert workflow.out.anndata.size() == 0
        }

    }

    test("Should write the object with save_intermediates") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/pbmc/with_label_and_condition_pca.h5ad', checkIfExists: true)
                ]).map { meta, h5ad -> [meta + [obs_key: 'leiden', condition_col: 'condition', de_methods_resolved: ['wilcoxon'] as Set], h5ad] }
                input[1] = true
                input[2] = ''
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.anndata.size() >= 1
            assert workflow.out.anndata.every { _meta, anndata -> file(anndata).name.endsWith('.zarr') }
        }

    }

}
