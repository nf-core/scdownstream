nextflow_workflow {

    name "Test Subworkflow MANIFOLD_LEARNING"
    script "../main.nf"
    workflow "MANIFOLD_LEARNING"

    test("Should run successfully on test dataset") {

        when {
            workflow {
                """
                input[0] = Channel.of([ [id:'test_sample'], file("${projectDir}/test_dataset.h5ad") ])
                input[1] = "phate,diffmap"
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.h5ad != null
            assert snapshot(workflow.out.versions).match()
        }

    }

}
