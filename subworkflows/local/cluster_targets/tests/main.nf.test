nextflow_workflow {

    name "Test Workflow CLUSTER_TARGETS"
    script "subworkflows/local/cluster_targets/main.nf"
    workflow "CLUSTER_TARGETS"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should preserve periods in per-label clustering targets") {

        setup {
            run("ADATA_UNIFY") {
                script "../../../../modules/local/adata/unify/main.nf"
                process {
                    """
                    input[0] = channel.of('B.naive', 'B.memory').map { id ->
                        [[id: id], file(params.pipelines_testdata_base_path + '/anndata-variations/counts_in_X.h5ad', checkIfExists: true)]
                    }
                    input[1] = 'sample'
                    input[2] = ''
                    input[3] = ''
                    input[4] = 'unknown'
                    input[5] = 'index'
                    input[6] = 'X'
                    input[7] = 'sum'
                    input[8] = false
                    input[9] = ''
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = ADATA_UNIFY.out.h5ad.map { meta, h5ad -> [meta + [integration: 'pca'], h5ad] }
                input[1] = true
                input[2] = false
                input[3] = 'sample'
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.targets.size() == 2
            assert workflow.out.targets.collect { it[0].subset }.toSet() == ['B.naive', 'B.memory'].toSet()
            assert workflow.out.targets.collect { it[0].id }.toSet() == ['pca-B.naive', 'pca-B.memory'].toSet()
            workflow.out.targets.each { meta, h5ad ->
                assert anndata(h5ad).obs['sample'].unique() == [meta.subset].toSet()
            }
        }
    }
}
