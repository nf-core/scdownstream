nextflow_workflow {

    name "Test Workflow COMBINE"
    script "subworkflows/local/combine/main.nf"
    workflow "COMBINE"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should run without failures - without base - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0]  = channel.of(
                    [[id: 'test1'], file(params.pipelines_testdata_base_path + '/anndata-variations/batch_correct_name.h5ad', checkIfExists: true)],
                    [[id: 'test2'], file(params.pipelines_testdata_base_path + '/anndata-variations/batch_correct_name.h5ad', checkIfExists: true)]
                )
                input[1]  = channel.value([[], []])
                input[2]  = false
                input[3]  = 'deviance'
                input[4]  = 0
                input[5]  = 'scvi'
                input[6]  = null
                input[7]  = 'log1p'
                input[8]  = null
                input[9]  = null
                input[10] = ''
                input[11] = ''
                input[12] = 128
                input[13] = 2
                input[14] = 30
                input[15] = 'gene'
                input[16] = 'zinb'
                input[17] = 5
                input[18] = true
                input[19] = 'https://zenodo.org/records/10685499/files/model_v1.1.tar.gz'
                input[20] = null
                input[21] = null
                input[22] = 'condition'
                input[23] = false
                input[24] = 0
                input[25] = 'stratified_label_batch'
                input[26] = 42
                input[27] = 'fast'
                input[28] = ''
                input[29] = false
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

    test("Should write zarr objects when no h5ad-only consumer is active - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0]  = channel.of(
                    [[id: 'test1'], file(params.pipelines_testdata_base_path + '/anndata-variations/batch_correct_name.h5ad', checkIfExists: true)],
                    [[id: 'test2'], file(params.pipelines_testdata_base_path + '/anndata-variations/batch_correct_name.h5ad', checkIfExists: true)]
                )
                input[1]  = channel.value([[], []])
                input[2]  = false
                input[3]  = 'hvgs'
                input[4]  = 0
                input[5]  = 'pca'
                input[6]  = null
                input[7]  = 'log1p'
                input[8]  = null
                input[9]  = null
                input[10] = ''
                input[11] = ''
                input[12] = 128
                input[13] = 2
                input[14] = 30
                input[15] = 'gene'
                input[16] = 'zinb'
                input[17] = 5
                input[18] = true
                input[19] = params.modules_testdata_base_path + 'generic/tar/hello.tar.gz'
                input[20] = null
                input[21] = null
                input[22] = 'condition'
                input[23] = false
                input[24] = 0
                input[25] = 'stratified_label_batch'
                input[26] = 42
                input[27] = 'fast'
                input[28] = ''
                input[29] = false
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.anndata[0][1].toString().endsWith('.zarr')
            assert workflow.out.anndata_inner[0][1].toString().endsWith('.zarr')
        }

    }

