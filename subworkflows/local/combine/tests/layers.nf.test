nextflow_workflow {

    name "Expression layers during extension"
    script "subworkflows/local/combine/tests/layers.nf"
    workflow "TEST_EXTENSION_LAYERS"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Preserve counts, populate query layers and retain query cells after HVG selection") {
        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.value([
                    file("${projectDir}/tests/expression_layers.py"),
                    [
                        file("${projectDir}/modules/local/scanpy/log1pnorm/templates/log1pnorm.py"),
                        file("${projectDir}/modules/local/adata/merge/templates/merge.py"),
                        file("${projectDir}/modules/local/scanpy/hvgs/templates/hvgs.py"),
                        file("${projectDir}/modules/local/scvitools/scvi/templates/scvi.py"),
                    ],
                ])
                """
            }
        }

        then {
            assert workflow.success
            assert path(workflow.out[0][0]).text == 'Expression layers preserved\n'
        }
    }
}
