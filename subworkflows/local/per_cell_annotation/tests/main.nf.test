nextflow_workflow {

    name "Test Workflow PER_CELL_ANNOTATION"
    script "subworkflows/local/per_cell_annotation/main.nf"
    workflow "PER_CELL_ANNOTATION"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should run with both celltypist and singler") {

        when {
            def referenceRoot = System.getenv('SCDOWNSTREAM_TEST_DATA_ROOT')
                ? new File(System.getenv('SCDOWNSTREAM_TEST_DATA_ROOT')).canonicalPath.replaceAll('/+$', '') + '/'
                : 'https://raw.githubusercontent.com/nf-core/test-datasets/scdownstream/'
            def referencesSheet = new File("$launchDir/singler-references.csv")
            referencesSheet.text = "id,label,reference,version\nhpca_celldex,label.main,hpca,2024-02-26\nimmune_celldex,label.fine,monaco_immune,2024-02-26\nhpca_direct,label.main,${referenceRoot}singleR/celldex_hpca__2024-02-26_h5_se.tar,\nimmune_direct,label.fine,${referenceRoot}singleR/celldex_monaco_immune__2024-02-26_h5_se.tar,\n"
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        "index",
                        "X"
                    ]
                )
                input[1] = "${referencesSheet.canonicalPath}"
                input[2] = "Adult_COVID19_PBMC"
                input[3] = false
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.obs.size() >= 1
            assert workflow.out.annotation_column_rows.size() >= 1
            assert snapshot(
                workflow.out.obs.size(),
                workflow.out.annotation_column_rows.collect { row -> [row.obs_column, row.aggregatable] }.unique()
            ).match()
        }

    }

    test("Should run with azimuth only") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        "index",
                        "X"
                    ]
                )
                input[1] = ''
                input[2] = ''
                input[3] = true
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.obs.size() == 1
            assert workflow.out.obsm.size() == 1
            assert file(workflow.out.obsm[0][1]).name == 'X_azimuth.pkl'
            assert snapshot(
                workflow.out.obs.size(),
                workflow.out.annotation_column_rows.collect { row -> [row.obs_column, row.aggregatable] }.unique()
            ).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            def referenceRoot = System.getenv('SCDOWNSTREAM_TEST_DATA_ROOT')
                ? new File(System.getenv('SCDOWNSTREAM_TEST_DATA_ROOT')).canonicalPath.replaceAll('/+$', '') + '/'
                : 'https://raw.githubusercontent.com/nf-core/test-datasets/scdownstream/'
            def referencesSheet = new File("$launchDir/singler-references.csv")
            referencesSheet.text = "id,label,reference,version\nhpca_celldex,label.main,hpca,2024-02-26\nimmune_celldex,label.fine,monaco_immune,2024-02-26\nhpca_direct,label.main,${referenceRoot}singleR/celldex_hpca__2024-02-26_h5_se.tar,\nimmune_direct,label.fine,${referenceRoot}singleR/celldex_monaco_immune__2024-02-26_h5_se.tar,\n"
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        "index",
                        "X"
                    ]
                )
                input[1] = "${referencesSheet.canonicalPath}"
                input[2] = "Adult_COVID19_PBMC"
                input[3] = false
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
