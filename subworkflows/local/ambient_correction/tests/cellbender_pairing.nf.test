nextflow_workflow {

    name "Test CellBender sample-specific correction destinations"
    script "subworkflows/local/ambient_correction/main.nf"
    workflow "AMBIENT_CORRECTION"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should pair each CellBender result with its resolved physical layer") {

        setup {
            run("CELDA_DECONTX", alias: "SETUP_SOURCE_LAYER") {
                script "modules/local/celda/decontx/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id: 'source'],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_raw_matrix.h5ad', checkIfExists: true)
                    ])
                    input[1] = []
                    input[2] = 'X'
                    input[3] = 'ambient_corrected_cellbender'
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = SETUP_SOURCE_LAYER.out.h5ad.flatMap { meta, h5ad ->
                    ['X', 'ambient_corrected_cellbender'].collect { source ->
                        [[id: source == 'X' ? 'ordinary' : 'collision', counts_layer: source],
                         h5ad,
                         file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_raw_matrix.h5ad', checkIfExists: true)]
                    }
                }
                input[1] = 'cellbender'
                input[2] = true
                input[3] = null
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.h5ad.size() == 2
            def outputs = workflow.out.h5ad.sort { it[0].id }
            assert outputs.collect { it[0].id } == ['collision', 'ordinary']
            outputs.each { meta, h5ad ->
                def destination = meta.id == 'collision' ? 'ambient_corrected_cellbender_internal' : 'ambient_corrected_cellbender'
                assert meta.raw_counts_layer == (meta.id == 'collision' ? 'ambient_corrected_cellbender' : 'X')
                assert meta.ambient_correction_layer == destination
                assert meta.counts_layer == destination
                assert meta.ambient_correction_method == 'cellbender'
                assert meta.analysis_counts_source == 'ambient_corrected_cellbender'
                def adata = anndata(h5ad)
                assert destination in adata.layers
                assert 'ambient_corrected_cellbender' in adata.layers
                assert ('ambient_corrected_cellbender_internal' in adata.layers) == (meta.id == 'collision')
                assert adata.n_obs == 384
                assert adata.n_vars > 0
            }
            def collision = anndata(outputs[0][1])
            def ordinary = anndata(outputs[1][1])
            assert collision.obs.rownames == ordinary.obs.rownames
            assert collision.var.rownames == ordinary.var.rownames
            assert snapshot(outputs.collect { it[0] }, outputs.collect { anndata(it[1]).yaml }).match()
        }

    }

}
