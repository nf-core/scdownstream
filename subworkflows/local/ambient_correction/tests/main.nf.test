            assert snapshot(meta, adata.yaml).match()
        }

    }

    test("Should preserve a raw selector that collides with the canonical correction destination") {

        setup {
            run("CELDA_DECONTX") {
                script "modules/local/celda/decontx/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id: 'source'],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_raw_matrix.h5ad', checkIfExists: true)
                    ])
                    input[1] = []
                    input[2] = 'X'
                    input[3] = 'ambient_corrected_decontx'
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = CELDA_DECONTX.out.h5ad.flatMap { meta, h5ad ->
                    [true, false].collect { selected ->
                        [meta + [id: "collision_\${selected}", counts_layer: 'ambient_corrected_decontx', use_ambient_corrected_counts: selected],
                         h5ad,
                         file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_raw_matrix.h5ad', checkIfExists: true)]
                    }
                }
                input[1] = 'decontx'
                input[2] = true
                input[3] = null
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.h5ad.size() == 2
            def outputs = workflow.out.h5ad.sort { it[0].id }
            outputs.each { meta, h5ad ->
                assert meta.id == "collision_${meta.use_ambient_corrected_counts}"
                assert meta.raw_counts_layer == 'ambient_corrected_decontx'
                assert meta.ambient_correction_method == 'decontx'
                assert meta.ambient_correction_layer != 'X'
                assert meta.ambient_correction_layer != meta.raw_counts_layer
                assert meta.counts_layer == (meta.use_ambient_corrected_counts ? meta.ambient_correction_layer : meta.raw_counts_layer)
                assert meta.analysis_counts_source == (meta.use_ambient_corrected_counts ? 'ambient_corrected_decontx' : 'raw_counts')
                def adata = anndata(h5ad)
                assert meta.raw_counts_layer in adata.layers
                assert meta.ambient_correction_layer in adata.layers
            }
            assert snapshot(outputs.collect { it[0] }, outputs.collect { anndata(it[1]).yaml }).match()
        }

    }

    test("Should fail with unknown ambient correction method") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'test'
                input[2] = false
                input[3] = null
                """
            }
        }

        then {
            assert !workflow.success
        }

    }

    test("Should not do anything if ambient correction is disabled in meta") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test', batch_col: 'sample', counts_layer: 'X', ambient_correction: false, use_ambient_corrected_counts: true ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'decontx'
                input[2] = true
                input[3] = null
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.h5ad.size() == 1
            def meta = workflow.out.h5ad[0][0]
            assert meta.id == 'test'
            assert meta.batch_col == 'sample'
            assert meta.ambient_correction == false
            assert meta.use_ambient_corrected_counts == true
            assert meta.raw_counts_layer == 'X'
            assert meta.counts_layer == 'X'
            assert meta.ambient_correction_layer == null
            assert meta.ambient_correction_method == 'none'
            assert meta.analysis_counts_source == 'raw_counts'
            assert snapshot(
                workflow.out.versions,
                workflow.out.h5ad.size()
            ).match()
        }

    }

