nextflow_workflow {

    name "Test Workflow AMBIENT_CORRECTION"
    script "subworkflows/local/ambient_correction/main.nf"
    workflow "AMBIENT_CORRECTION"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should run with 'none' ambient correction") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test', use_ambient_corrected_counts: true ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'none'
                input[2] = true
                input[3] = null
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.h5ad.size() == 1
            assert workflow.out.h5ad[0][0] == [
                id: 'test', use_ambient_corrected_counts: true, raw_counts_layer: 'X', counts_layer: 'X',
                ambient_correction_layer: null, ambient_correction_method: 'none',
                analysis_counts_source: 'raw_counts'
            ]
            assert snapshot(
                workflow.out.versions,
                workflow.out.h5ad.size()
            ).match()
        }

    }

    test("Should honour a sample selecting correction over the global raw setting") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'override', batch_col: 'sample', use_ambient_corrected_counts: true, donor_col: 'donor'],
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_raw_matrix.h5ad', checkIfExists: true)
                ])
                input[1] = 'decontx'
                input[2] = false
                input[3] = null
                """
            }
        }

        then {
            assert workflow.success
            def meta = workflow.out.h5ad[0][0]
            assert meta.id == 'override'
            assert meta.batch_col == 'sample'
            assert meta.donor_col == 'donor'
            assert meta.use_ambient_corrected_counts == true
            assert meta.raw_counts_layer == 'X'
            assert meta.counts_layer == 'ambient_corrected_decontx'
            assert meta.ambient_correction_layer == 'ambient_corrected_decontx'
            assert meta.ambient_correction_method == 'decontx'
            assert meta.analysis_counts_source == 'ambient_corrected_decontx'
            def adata = anndata(workflow.out.h5ad[0][1])
            assert 'ambient_corrected_decontx' in adata.layers
            assert snapshot(meta, adata.yaml).match()
        }

    }

