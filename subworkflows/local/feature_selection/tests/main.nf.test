nextflow_workflow {

    name "Test Workflow FEATURE_SELECTION"
    script "subworkflows/local/feature_selection/main.nf"
    workflow "FEATURE_SELECTION"

    tag "subworkflows"
    tag "subworkflows_local"

    setup {
        run("SCANPY_LOG1PNORM") {
            script "modules/local/scanpy/log1pnorm/main.nf"
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                """
            }
        }
    }

    test("Should run hvgs feature selection") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = SCANPY_LOG1PNORM.out.h5ad
                input[1] = 'hvgs'
                input[2] = 2000
                input[3] = []
                input[4] = 'log1p'
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.h5ad.size() == 1
            def adata = anndata(workflow.out.h5ad[0][1])
            assert adata.n_obs > 0
            assert adata.n_vars > 0
            assert "highly_variable" in adata.var.colnames
            assert adata.n_vars == 2000
            assert adata.var.get('highly_variable').data.every { it.toString().equalsIgnoreCase('true') }
            assert 'log1p' in adata.layers
            assert !('counts' in adata.layers)
            assert adata.obs.rownames.toList().toSet().size() == adata.n_obs
            assert adata.var.rownames.toList().toSet().size() == adata.n_vars
            assert snapshot(workflow.out.h5ad[0][0], workflow.out.var, adata.yaml).match()
        }

    }

    test("Should run pearson_residuals_hvgs feature selection - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'pearson_residuals_hvgs'
                input[2] = 500
                input[3] = []
                input[4] = 'log1p'
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
