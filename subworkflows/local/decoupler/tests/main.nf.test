nextflow_workflow {

    name "Test Workflow DECOUPLER"
    script "subworkflows/local/decoupler/main.nf"
    workflow "DECOUPLER"

    tag "subworkflows"
    tag "subworkflows_local"

    def networkTsv = [
        'source\ttarget\tweight',
        'AP1\tCD69\t1\nAP1\tFOS\t1\nAP1\tJUNB\t1\nAP1\tHSPA8\t1\nAP1\tPDCD4\t-1\nAP1\tCDKN1B\t-1',
        'BCELL\tCD22\t1\nBCELL\tCD79A\t1\nBCELL\tCR2\t1\nBCELL\tFCER2\t1\nBCELL\tFCRL1\t1\nBCELL\tFCRL3\t1\nBCELL\tIGHM\t1\nBCELL\tTNFRSF13C\t1',
        'IFN\tDDX60\t1\nIFN\tIFNGR2\t1\nIFN\tSP100\t1\nIFN\tSP140\t1\nIFN\tSTAT1\t1\nIFN\tZC3HAV1\t1',
        'MHC\tB2M\t1\nMHC\tCD74\t1\nMHC\tHLA-A\t1\nMHC\tHLA-B\t1\nMHC\tHLA-C\t1\nMHC\tHLA-DPA1\t1\nMHC\tHLA-DPB1\t1\nMHC\tHLA-DRA\t1\nMHC\tHLA-DRB1\t1\nMHC\tHLA-E\t1',
        'RIBO\tRPL11\t1\nRIBO\tRPL4\t1\nRIBO\tRPL8\t1\nRIBO\tRPS15\t1\nRIBO\tRPS23\t1\nRIBO\tRPS24\t1\nRIBO\tRPSA\t1',
        'SMALL\tCD44\t1\nSMALL\tVIM\t1\nSMALL\tNOTAGENE\t1',
    ].join('\n') + '\n'

    test("Should run without failures - stub") {

        options '-stub'

        setup {
            run("DECOUPLER_PSEUDOBULK") {
                script "modules/local/decoupler/pseudobulk/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id: 'test', integration: 'scvi' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)
                    ])
                    input[1] = 'X'
                    input[2] = 'donor'
                    input[3] = 'label'
                    input[4] = 'condition'
                    input[5] = 10
                    input[6] = 1000
                    """
                }
            }
            run("EDGEPYTHON_DIFFERENTIAL") {
                script "modules/local/edgepython/differential/main.nf"
                process {
                    """
                    input[0] = DECOUPLER_PSEUDOBULK.out.h5ad.map { meta, h5ad -> [meta + [de_method: 'edgepython'], h5ad] }
                    input[1] = 'Healthy'
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                def network = file('network.tsv')
                network.text = '''${networkTsv}'''
                input[0] = DECOUPLER_PSEUDOBULK.out.h5ad
                input[1] = EDGEPYTHON_DIFFERENTIAL.out.results
                input[2] = 'progeny,collectri'
                input[3] = network
                input[4] = 'human'
                input[5] = 'ulm'
                input[6] = 5
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.networks.collect { meta, _tsv -> meta.id }.sort() == ['collectri', 'network', 'progeny']
            assert snapshot(workflow.out).match()
        }

    }

    test("Should score pseudobulk profiles and DE results with a custom network") {

        setup {
            run("DECOUPLER_PSEUDOBULK") {
                script "modules/local/decoupler/pseudobulk/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id: 'test', integration: 'scvi' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)
                    ])
                    input[1] = 'X'
                    input[2] = 'donor'
                    input[3] = 'label'
                    input[4] = 'condition'
                    input[5] = 10
                    input[6] = 1000
                    """
                }
            }
            run("EDGEPYTHON_DIFFERENTIAL") {
                script "modules/local/edgepython/differential/main.nf"
                process {
                    """
                    input[0] = DECOUPLER_PSEUDOBULK.out.h5ad.map { meta, h5ad -> [meta + [de_method: 'edgepython'], h5ad] }
                    input[1] = 'Healthy'
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                def network = file('network.tsv')
                network.text = '''${networkTsv}'''
                input[0] = DECOUPLER_PSEUDOBULK.out.h5ad
                input[1] = EDGEPYTHON_DIFFERENTIAL.out.results
                input[2] = ''
                input[3] = network
                input[4] = 'human'
                input[5] = 'ulm'
                input[6] = 5
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.networks.size() == 1
            assert workflow.out.uns.collect { file(it).name }.sort() == [
                'test_decoupler_activity.pkl',
                'test_edgepython_decoupler_enrichment.pkl',
            ]
            assert workflow.out.multiqc_files.collect { file(it).name }.sort() == [
                'test_edgepython_network_enrichment_mqc.json',
                'test_network_activity_mqc.json',
            ]
            // Score and enrichment tables differ in the last float digits across CPUs, so only their names are snapshotted
            assert snapshot(
                workflow.out.networks,
                workflow.out.scores.collect { meta, parquet -> [meta, file(parquet).name] },
                workflow.out.enrichment.collect { meta, parquet -> [meta, file(parquet).name] },
            ).match()
        }

    }

}
