nextflow_workflow {

    name "Test Workflow EMPTY_DROPLET_REMOVAL"
    script "subworkflows/local/empty_droplet_removal/main.nf"
    workflow "EMPTY_DROPLET_REMOVAL"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should run with 'cellbender' - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'cellbender'
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

    test("Should run with 'emptydrops'") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'emptydrops'
                """
            }
        }

        then {
            def adata = anndata(workflow.out.h5ad[0][1])

            assert workflow.success
            assert workflow.out.h5ad.size() == 1
            assert adata.n_obs > 0
            assert snapshot(
                adata.n_obs,
                adata.n_vars,
                adata.yaml
            ).match()
        }

    }

    test("Should run with 'emptydrops' - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'emptydrops'
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

    test("Should fail with unknown empty droplet removal method") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'test'
                """
            }
        }

        then {
            assert !workflow.success
        }

    }

}
