nextflow_process {

    name "Test doublet annotation fragments through ADATA_EXTEND"
    script "modules/local/adata/extend/main.nf"
    process "ADATA_EXTEND"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should finalise numeric scores and classes for all four methods without removing cells") {

        setup {
            run("DOUBLET_DETECTION") {
                script "../main.nf"
                workflow {
                    """
                    input[0] = channel.of([
                        [id: 'test', batch_col: 'sample'],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ])
                    input[1] = ['solo', 'scrublet', 'doubletdetection', 'scdblfinder']
                    input[2] = 2
                    input[3] = false
                    input[4] = 1
                    """
                }
            }
        }

        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = DOUBLET_DETECTION.out.h5ad
                    .join(DOUBLET_DETECTION.out.obs, failOnDuplicate: true, failOnMismatch: true)
                    .flatMap { meta, h5ad, obs -> [
                        [meta + [id: 'finalised'], h5ad, [obs], [], [], [], [], []],
                        [meta + [id: 'original'], file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true), [], [], [], [], [], []]
                    ] }
                """
            }
        }

        then {
            assert process.success
            assert process.out.h5ad.size() == 2
            def outputs = process.out.h5ad.collectEntries { meta, h5ad -> [(meta.id): h5ad] }
            def result = anndata(outputs.finalised)
            def original = anndata(outputs.original)
            def raw = anndata(path(outputs.finalised).parent.resolve('test.h5ad'))
            assert result.n_obs == 384
            assert result.obs.index.values == original.obs.index.values
            assert raw.obs.index.values == original.obs.index.values
            assert raw.obs.colnames == original.obs.colnames
            assert result.var.index.values == original.var.index.values
            assert result.layers == original.layers
            assert !result.obs.colnames.any { it.startsWith('test_') || it.startsWith('scDblFinder.') }
            ['solo', 'scrublet', 'doubletdetection', 'scdblfinder'].each { method ->
                assert (method + '_predicted_doublet') in result.obs.colnames
                assert (method + '_class') in result.obs.colnames
                def calls = result.obs.get("${method}_predicted_doublet").data.toList()
                def classes = result.obs.get("${method}_class").data.toList()
                assert calls.size() == original.n_obs
                assert calls.every { it.toString().toLowerCase() in ['true', 'false'] }
                assert classes == calls.collect { it.toString().equalsIgnoreCase('true') ? 'doublet' : 'singlet' }
            }
            ['scrublet', 'doubletdetection', 'scdblfinder'].each { method ->
                assert (method + '_score') in result.obs.colnames
                def scores = result.obs.get("${method}_score").data.toList()
                assert scores.size() == original.n_obs
                assert scores.every { it instanceof Number }
            }
            assert !('solo_score' in result.obs.colnames)
            assert result.obs.colnames.toList().unique().size() == result.obs.colnames.size()
            assert snapshot(process.out.versions.collect { path(it).yaml }, result.yaml).match()
        }
    }

    test("Should retain the full-cell fragment and finalise only cells below the vote threshold") {

        setup {
            run("DOUBLET_DETECTION") {
                script "../main.nf"
                workflow {
                    """
                    input[0] = channel.of([
                        [id: 'test', batch_col: 'sample'],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ])
                    input[1] = ['solo', 'scrublet', 'doubletdetection', 'scdblfinder']
                    input[2] = 2
                    input[3] = true
                    input[4] = 1
                    """
                }
            }
        }

        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = DOUBLET_DETECTION.out.h5ad
                    .join(DOUBLET_DETECTION.out.obs, failOnDuplicate: true, failOnMismatch: true)
                    .flatMap { meta, h5ad, obs -> [
                        [meta + [id: 'retained'], h5ad, [obs], [], [], [], [], []],
                        [meta + [id: 'full'], file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true), [obs], [], [], [], [], []]
                    ] }
                """
            }
        }

        then {
            assert process.success
            def outputs = process.out.h5ad.collectEntries { meta, h5ad -> [(meta.id): h5ad] }
            def full = anndata(outputs.full)
            def retained = anndata(outputs.retained)
            def raw = anndata(path(outputs.retained).parent.resolve('test.h5ad'))
            assert full.n_obs == 384
            assert retained.n_obs > 0
            assert retained.n_obs < full.n_obs
            assert raw.obs.index.values == retained.obs.index.values
            assert !raw.obs.colnames.any { it.endsWith('_predicted_doublet') || it.endsWith('_class') || it.endsWith('_score') }
            def methods = ['solo', 'scrublet', 'doubletdetection', 'scdblfinder']
            def votes = methods.collect { full.obs.get("${it}_predicted_doublet").data.toList() }
            def keep = (0..<full.n_obs).findAll { row ->
                votes.count { it[row].toString().equalsIgnoreCase('true') } < 2
            }
            assert retained.obs.index.values == keep.collect { full.obs.index.values[it] }
            methods.each { method ->
                ['predicted_doublet', 'class'].each { field ->
                    def values = full.obs.get("${method}_${field}").data.toList()
                    assert retained.obs.get("${method}_${field}").data.toList() == keep.collect { values[it] }
                }
            }
            assert !('solo_score' in retained.obs.colnames)
            assert snapshot(process.out.versions.collect { path(it).yaml }, retained.yaml, full.yaml).match()
        }
    }
}
