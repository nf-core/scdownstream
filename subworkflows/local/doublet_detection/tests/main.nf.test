nextflow_workflow {

    name "Test Workflow DOUBLET_DETECTION"
    script "subworkflows/local/doublet_detection/main.nf"
    workflow "DOUBLET_DETECTION"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should run without methods") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test', batch_col: 'sample' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = []
                input[2] = 0
                input[3] = false
                input[4] = 1
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 0
            assert workflow.out.h5ad.size() == 1
            assert workflow.out.h5ad[0][0] == [id: 'test', batch_col: 'sample']
            assert path(workflow.out.h5ad[0][1]).fileName.toString() == 'SRR28679759_filtered_matrix.h5ad'
            assert workflow.out.obs.size() == 0
            assert workflow.out.multiqc_files.size() == 0
        }

    }

    test("Should run with all four methods and emit annotations separately") {

        when {
            params {
                outdir = "$outputDir"
                save_intermediates = true
                scvi_max_epochs = 2
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test', batch_col: 'sample' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = ['solo', 'scrublet', 'scdblfinder', 'doubletdetection']
                input[2] = 2
                input[3] = true
                input[4] = 1
                """
            }
        }

        then {
            assert workflow.success
            def adata = anndata(workflow.out.h5ad[0][1])
            assert adata.n_obs > 0
            assert adata.n_obs < 384
            assert workflow.out.obs.size() == 4
            assert workflow.out.obs.every { it[0] == workflow.out.h5ad[0][0] }
            assert workflow.out.obs.collect { path(it[1]).fileName.toString() }.sort() ==
                ['test.obs.parquet', 'test_doubletdetection.scores.parquet', 'test_scdblfinder.scores.parquet', 'test_scrublet.scores.parquet']
            ['scrublet', 'doubletdetection'].each { method ->
                def table = workflow.out.obs.find { path(it[1]).fileName.toString() == "test_${method}.scores.parquet" }[1]
                assert path(table).size() > 0
            }
            def annotations = parquet(workflow.out.obs.find { path(it[1]).fileName.toString() == 'test.obs.parquet' }[1])
            def inputCells = anndata("$outputDir/02_quality_control/doublet_detection/scdblfinder/test_scdblfinder.h5ad").obs.index.values
            ['solo', 'scrublet', 'scdblfinder', 'doubletdetection'].each { detector ->
                def column = "test_${detector}".toString()
                def suffix = detector == 'scdblfinder' ? '.predictions.parquet' : '.parquet'
                def table = parquet("$outputDir/02_quality_control/doublet_detection/${detector}/${column}${suffix}")
                assert table.columnNames == ['__index__', column]
                assert table.schema.fields.find { it.name == column }.physicalType == 'BOOLEAN'
                assert table.schema.fields.find { it.name == '__index__' }.logicalType.type == 'STRING'
                assert table.compressionCodecs == ['SNAPPY']
                def rows = table.rows
                assert rows.size() == 384
                assert rows.every { it.__index__ instanceof String && it[column] instanceof Boolean }
                assert rows.collect { it.__index__ } == inputCells
                assert rows.collect { it[column] } == annotations.rows.collect { it["${detector}_predicted_doublet".toString()] }
            }
            assert annotations.rows.findAll { row -> ['solo', 'scrublet', 'scdblfinder', 'doubletdetection'].count { row["${it}_predicted_doublet".toString()] } < 2 }.collect { it.__index__ } == adata.obs.index.values
            assert !adata.obs.colnames.any { it.startsWith('test_') || it.endsWith('_predicted_doublet') }
            assert !adata.obs.colnames.any { it in ['solo_class', 'scrublet_score', 'scdblfinder_score', 'doubletdetection_score'] }
            assert workflow.out.multiqc_files.size() == 1
            assert snapshot(adata.yaml).match()
        }

    }

    test("Should annotate doublets without removing cells when doublet_removal is false") {

        when {
            params {
                outdir = "$outputDir"
                save_intermediates = true
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test', batch_col: 'sample' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = ['scdblfinder']
                input[2] = 1
                input[3] = false
                input[4] = 1
                """
            }
        }

        then {
            assert workflow.success
            def adata = anndata(workflow.out.h5ad[0][1])
            assert adata.n_obs == 384
            assert workflow.out.obs.size() == 2
            assert !adata.obs.colnames.any { it.startsWith('scdblfinder_') || it.startsWith('scDblFinder.') || it == 'test_scdblfinder' }
            def table = parquet("$outputDir/02_quality_control/doublet_detection/scdblfinder/test_scdblfinder.predictions.parquet")
            def annotations = parquet(workflow.out.obs.find { path(it[1]).fileName.toString() == 'test.obs.parquet' }[1])
            assert table.columnNames == ['__index__', 'test_scdblfinder']
            assert table.rows.collect { it.__index__ } == adata.obs.index.values
            assert table.rows.every { it.test_scdblfinder instanceof Boolean }
            assert table.rows.collect { it.test_scdblfinder } == annotations.rows.collect { it.scdblfinder_predicted_doublet }
            assert snapshot(adata.yaml).match()
        }

    }

    test("Should accept global scdblfinder_dbr_sd without removing cells") {

        tag "scdblfinder_dbr_sd"

        when {
            params {
                outdir = "$outputDir"
                scdblfinder_dbr_sd = 1
            }
            workflow {
                """
                input[0] = channel.of([
                    [ id: 'test', batch_col: 'sample', doublet_rate: 0.08 ],
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                ])
                input[1] = ['scdblfinder']
                input[2] = 1
                input[3] = false
                input[4] = 1
                """
            }
        }

        then {
            assert workflow.success
            def adata = anndata(workflow.out.h5ad[0][1])
            assert adata.n_obs == 384
            assert workflow.out.obs.size() == 2
            assert !adata.obs.colnames.any { it.startsWith('scdblfinder_') || it.startsWith('scDblFinder.') }
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test', batch_col: 'sample' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = ['solo', 'scrublet', 'doubletdetection', 'scdblfinder']
                input[2] = 2
                input[3] = true
                input[4] = 1
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
