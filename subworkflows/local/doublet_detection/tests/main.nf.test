nextflow_workflow {

    name "Test Workflow DOUBLET_DETECTION"
    script "subworkflows/local/doublet_detection/main.nf"
    workflow "DOUBLET_DETECTION"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should run without methods") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test', batch_col: 'sample' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = []
                input[2] = 0
                input[3] = false
                input[4] = 1
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 0
            assert workflow.out.h5ad.size() == 1
            assert workflow.out.h5ad[0][0] == [id: 'test', batch_col: 'sample']
            assert path(workflow.out.h5ad[0][1]).fileName.toString() == 'SRR28679759_filtered_matrix.h5ad'
            assert workflow.out.obs.size() == 0
            assert workflow.out.multiqc_files.size() == 0
        }

    }

    test("Should run with all four methods and emit annotations separately") {

        when {
            params {
                outdir = "$outputDir"
                scvi_max_epochs = 2
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test', batch_col: 'sample' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = ['solo', 'scrublet', 'scdblfinder', 'doubletdetection']
                input[2] = 2
                input[3] = true
                input[4] = 1
                """
            }
        }

        then {
            assert workflow.success
            def adata = anndata(workflow.out.h5ad[0][1])
            assert adata.n_obs > 0
            assert adata.n_obs < 384
            assert workflow.out.obs.size() == 4
            assert workflow.out.obs.every { it[0] == workflow.out.h5ad[0][0] }
            assert workflow.out.obs.collect { path(it[1]).fileName.toString() }.sort() ==
                ['test.obs.pkl', 'test_doubletdetection.scores.parquet', 'test_scdblfinder.scores.csv', 'test_scrublet.scores.parquet']
            ['scrublet', 'doubletdetection'].each { method ->
                def table = workflow.out.obs.find { path(it[1]).fileName.toString() == "test_${method}.scores.parquet" }[1]
                def rows = parquet(table).rows
                assert rows.size() == 384
                assert rows.every { it[method + '_score'] instanceof Number }
            }
            assert !adata.obs.colnames.any { it.startsWith('test_') || it.endsWith('_predicted_doublet') }
            assert !adata.obs.colnames.any { it in ['solo_class', 'scrublet_score', 'scdblfinder_score', 'doubletdetection_score'] }
            assert workflow.out.multiqc_files.size() == 1
            assert snapshot(adata.yaml).match()
        }

    }

    test("Should annotate doublets without removing cells when doublet_removal is false") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test', batch_col: 'sample' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = ['scdblfinder']
                input[2] = 1
                input[3] = false
                input[4] = 1
                """
            }
        }

        then {
            assert workflow.success
            def adata = anndata(workflow.out.h5ad[0][1])
            assert adata.n_obs == 384
            assert workflow.out.obs.size() == 2
            assert !adata.obs.colnames.any { it.startsWith('scdblfinder_') || it.startsWith('scDblFinder.') || it == 'test_scdblfinder' }
            assert snapshot(adata.yaml).match()
        }

    }

    test("Should accept global scdblfinder_dbr_sd without removing cells") {

        tag "scdblfinder_dbr_sd"

        when {
            params {
                outdir = "$outputDir"
                scdblfinder_dbr_sd = 1
            }
            workflow {
                """
                input[0] = channel.of([
                    [ id: 'test', batch_col: 'sample', doublet_rate: 0.08 ],
                    file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                ])
                input[1] = ['scdblfinder']
                input[2] = 1
                input[3] = false
                input[4] = 1
                """
            }
        }

        then {
            assert workflow.success
            def adata = anndata(workflow.out.h5ad[0][1])
            assert adata.n_obs == 384
            assert workflow.out.obs.size() == 2
            assert !adata.obs.colnames.any { it.startsWith('scdblfinder_') || it.startsWith('scDblFinder.') }
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                        [ id: 'test', batch_col: 'sample' ],
                        file(params.pipelines_testdata_base_path + '/pbmc/SRR28679759_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = ['solo', 'scrublet', 'doubletdetection', 'scdblfinder']
                input[2] = 2
                input[3] = true
                input[4] = 1
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
