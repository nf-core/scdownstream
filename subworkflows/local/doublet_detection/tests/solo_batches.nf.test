nextflow_process {

    name "Test doublet fragments across SOLO batches"
    script "modules/local/adata/extend/main.nf"
    process "ADATA_EXTEND"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should retain full-cell Boolean SOLO predictions across actual batches") {
        setup {
            run("DOUBLET_DETECTION") {
                script "../main.nf"
                workflow {
                    """
                    input[0] = channel.of([
                        [id: 'multibatch', batch_col: 'sample'],
                        file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ])
                    input[1] = ['solo']
                    input[2] = 1
                    input[3] = false
                    input[4] = 1
                    """
                }
            }
        }
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = DOUBLET_DETECTION.out.h5ad
                    .join(DOUBLET_DETECTION.out.obs, failOnDuplicate: true, failOnMismatch: true)
                    .flatMap { meta, h5ad, obs -> [
                        [meta + [id: 'finalised'], h5ad, [obs], [], [], [], [], []],
                        [meta + [id: 'original'], file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_matrix.h5ad', checkIfExists: true), [], [], [], [], [], []]
                    ] }
                """
            }
        }

        then {
            assert process.success
            def outputs = process.out.h5ad.collectEntries { meta, h5ad -> [(meta.id): h5ad] }
            def original = anndata(outputs.original)
            def result = anndata(outputs.finalised)
            def raw = anndata(path(outputs.finalised).parent.resolve('multibatch.h5ad'))
            def batches = original.obs.get('sample').data.toList()
            assert batches.toSet().size() >= 2
            assert result.n_obs == original.n_obs
            assert result.obs.index.values == original.obs.index.values
            assert raw.obs.index.values == original.obs.index.values
            assert raw.obs.colnames == original.obs.colnames
            assert result.obs.get('sample').data.toList() == batches
            def predictions = result.obs.get('solo_predicted_doublet').data.toList()
            def classes = result.obs.get('solo_class').data.toList()
            assert predictions.size() == original.n_obs
            assert predictions.every { it.toString().toLowerCase() in ['true', 'false'] }
            assert classes == predictions.collect { it.toString().equalsIgnoreCase('true') ? 'doublet' : 'singlet' }
            assert batches.toSet().every { batch ->
                (0..<original.n_obs).findAll { batches[it] == batch }.every {
                    predictions[it].toString().toLowerCase() in ['true', 'false']
                }
            }
            assert !('solo_score' in result.obs.colnames)
            assert !('multibatch_solo' in result.obs.colnames)
            assert snapshot(process.out.versions.collect { path(it).yaml }, result.yaml).match()
        }
    }
}
