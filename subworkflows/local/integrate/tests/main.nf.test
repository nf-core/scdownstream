nextflow_workflow {

    name "Test Workflow INTEGRATE"
    script "subworkflows/local/integrate/main.nf"
    workflow "INTEGRATE"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should run without failures - symphony - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/anndata-variations/batch_correct_name.h5ad', checkIfExists: true)
                ])
                input[1] = false
                input[2] = 'hvgs'
                input[3] = 2000
                input[4] = []
                input[5] = 'log1p'
                input[6] = ['symphony']
                input[7] = null
                input[8] = null
                input[9] = []
                input[10] = []
                input[11] = null
                input[12] = null
                input[13] = null
                input[14] = 'condition'
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

    test("Should run without failures - symphony") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/anndata-variations/batch_correct_name.h5ad', checkIfExists: true)
                ])
                input[1] = false
                input[2] = 'hvgs'
                input[3] = 2000
                input[4] = []
                input[5] = 'log1p'
                input[6] = ['symphony']
                input[7] = null
                input[8] = null
                input[9] = []
                input[10] = []
                input[11] = null
                input[12] = null
                input[13] = null
                input[14] = 'condition'
                """
            }
        }

        then {
            def adata = anndata(workflow.out.integrations[0][1])
            assert workflow.success
            assert "X_emb" in adata.obsm
            assert "X_symphony" in adata.obsm
            assert snapshot(
                adata.yaml
            ).match()
        }

    }

