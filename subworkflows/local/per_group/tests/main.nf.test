nextflow_workflow {

    name "Test Workflow PER_GROUP"
    script "subworkflows/local/per_group/main.nf"
    workflow "PER_GROUP"

    tag "subworkflows"
    tag "subworkflows_local"

    def networkTsv = [
        'source\ttarget\tweight',
        'AP1\tCD69\t1\nAP1\tFOS\t1\nAP1\tJUNB\t1\nAP1\tHSPA8\t1\nAP1\tPDCD4\t-1\nAP1\tCDKN1B\t-1',
        'BCELL\tCD22\t1\nBCELL\tCD79A\t1\nBCELL\tCR2\t1\nBCELL\tFCER2\t1\nBCELL\tFCRL1\t1\nBCELL\tFCRL3\t1\nBCELL\tIGHM\t1\nBCELL\tTNFRSF13C\t1',
        'IFN\tDDX60\t1\nIFN\tIFNGR2\t1\nIFN\tSP100\t1\nIFN\tSP140\t1\nIFN\tSTAT1\t1\nIFN\tZC3HAV1\t1',
        'MHC\tB2M\t1\nMHC\tCD74\t1\nMHC\tHLA-A\t1\nMHC\tHLA-B\t1\nMHC\tHLA-C\t1\nMHC\tHLA-DPA1\t1\nMHC\tHLA-DPB1\t1\nMHC\tHLA-DRA\t1\nMHC\tHLA-DRB1\t1\nMHC\tHLA-E\t1',
        'RIBO\tRPL11\t1\nRIBO\tRPL4\t1\nRIBO\tRPL8\t1\nRIBO\tRPS15\t1\nRIBO\tRPS23\t1\nRIBO\tRPS24\t1\nRIBO\tRPSA\t1',
        'SMALL\tCD44\t1\nSMALL\tVIM\t1\nSMALL\tNOTAGENE\t1',
    ].join('\n') + '\n'

    test("Should infer one GRNBoost2 network per group") {

        tag "grn"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.empty()
                input[1] = channel.of([
                    [id: 'test', obs_key: 'leiden', condition_col: 'condition', integration: 'scvi', resolution: '0.5', analyses: ['grn'] as Set],
                    file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)
                ])
                input[2] = true
                input[3] = 1000
                input[4] = 0
                input[5] = 'stratified_obs'
                input[6] = 42
                input[7] = false
                input[8] = ''
                input[9] = 42
                input[10] = ''
                input[11] = 'wilcoxon'
                input[12] = false
                input[13] = 10
                input[14] = 1000
                input[15] = channel.empty()
                input[16] = ''
                input[17] = []
                input[18] = 'human'
                input[19] = false
                input[20] = ''
                input[21] = []
                input[22] = 'ulm'
                input[23] = 5
                input[24] = true
                input[25] = []
                input[26] = 100
                input[27] = 50
                input[28] = 200
                input[29] = 0
                """
            }
        }

        then {
            assert workflow.success
            def grnFragments = workflow.out.uns.findAll { entry -> file(entry).name == 'test_grn.parquet' }
            assert grnFragments.size() == 1
            def fragment = path(grnFragments[0]).parquet
            assert fragment.columnNames == ['__index__', 'group', 'TF', 'target', 'importance']
            assert fragment.schemaDetails.fields.find { it.name == 'importance' }.physicalType == 'DOUBLE'
            def rows = fragment.rowMaps
            // Cluster 5 has 3 cells and falls below grn_min_cells
            assert rows.collect { it.group }.toSet() == ['0', '1', '2', '3', '4'].toSet()
            rows.groupBy { it.group }.each { _group, links -> assert links.size() <= 200 }
            assert rows.every { it.TF != it.target && it.importance > 0 }
            assert rows.collect { it.__index__ }.toSet().size() == rows.size()
            assert snapshot(workflow.out.uns.collect { file(it).name }.sort()).match()
        }

    }

    test("Should run without failures - PAGA only - stub") {

        tag "stub"

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
                skip_liana = true
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'test', obs_key: 'leiden', condition_col: 'condition', integration: 'scvi', resolution: '0.5', analyses: ['paga'] as Set],
                    file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)
                ])
                input[1] = channel.empty()
                input[2] = true
                input[3] = 1000
                input[4] = 0
                input[5] = 'stratified_obs'
                input[6] = 42
                input[7] = false
                input[8] = ''
                input[9] = 42
                input[10] = ''
                input[11] = 'wilcoxon'
                input[12] = false
                input[13] = 10
                input[14] = 1000
                input[15] = channel.empty()
                input[16] = ''
                input[17] = []
                input[18] = 'human'
                input[19] = false
                input[20] = ''
                input[21] = []
                input[22] = 'ulm'
                input[23] = 5
                input[24] = false
                input[25] = []
                input[26] = 2000
                input[27] = 50
                input[28] = 10000
                input[29] = 0
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.h5ad.size() == 0
            assert workflow.out.obs.size() == 0
            assert snapshot(workflow.out).match()
        }

    }

