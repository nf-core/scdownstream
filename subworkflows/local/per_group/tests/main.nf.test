                        rank_key: 'rank_genes_groups',
                        analyses: ['cytetype'] as Set,
                    ],
                    file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)
                ])
                input[0] = h5ad
                input[1] = h5ad
                input[2] = true
                input[3] = 1000
                input[4] = 0
                input[5] = 'stratified_obs'
                input[6] = 42
                input[7] = false
                input[8] = ''
                input[9] = 42
                input[10] = "Human PBMC from healthy donor, 10X Genomics 3' scRNA-seq (nf-test)"
                input[11] = ''
                input[12] = false
                input[13] = 10
                input[14] = 1000
                input[15] = channel.empty()
                input[16] = ''
                input[17] = []
                input[18] = 'human'
                input[19] = false
                input[20] = ''
                input[21] = []
                input[22] = 'ulm'
                input[23] = 5
                input[24] = false
                input[25] = []
                input[26] = 2000
                input[27] = 50
                input[28] = 10000
                input[29] = 0
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.uns.any { file(it).name.endsWith('_characteristic_genes.pkl') }
            assert workflow.out.obs.any { fragment -> file(fragment).name.endsWith('_cytetype.parquet') }
        }

    }

