    test("Should run decoupler on pseudobulk profiles and DE results - stub") {

        tag "stub"
        tag "decoupler"

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
                skip_liana = true
            }
            workflow {
                """
                input[0] = channel.empty()
                input[1] = channel.of([
                    [
                        id: 'test',
                        obs_key: 'leiden',
                        condition_col: 'condition',
                        donor_col: 'sample',
                        integration: 'scvi',
                        resolution: '0.5',
                        analyses: ['de', 'decoupler'] as Set,
                    ],
                    file(params.pipelines_testdata_base_path + '/pbmc/combined_filtered_pca.h5ad', checkIfExists: true)
                ])
                input[2] = true
                input[3] = 1000
                input[4] = 0
                input[5] = 'stratified_obs'
                input[6] = 42
                input[7] = false
                input[8] = ''
                input[9] = 42
                input[10] = ''
                input[11] = 'edgepython'
                input[12] = false
                input[13] = 10
                input[14] = 1000
                input[15] = channel.empty()
                input[16] = 'Healthy'
                input[17] = []
                input[18] = 'human'
                input[19] = true
                input[20] = ''
                input[21] = file('network.tsv')
                input[21].text = '''${networkTsv}'''
                input[22] = 'ulm'
                input[23] = 5
                input[24] = false
                input[25] = []
                input[26] = 2000
                input[27] = 50
                input[28] = 10000
                input[29] = 0
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.uns.collect { file(it).name }.sort() == [
                'test_decoupler_activity.pkl',
                'test_edgepython_decoupler_enrichment.pkl',
            ]
            assert workflow.out.multiqc_files.any { file(it).name == 'test_network_activity_mqc.json' }
            assert workflow.out.multiqc_files.any { file(it).name == 'test_edgepython_network_enrichment_mqc.json' }
        }

    }

